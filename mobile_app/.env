# Cấu hình đường dẫn API Backend (.NET Core Identity Web API)
# Tách biệt hoàn toàn khỏi mã nguồn bằng flutter_dotenv
# =====================================================================

# 1. Nếu chạy trên Android Emulator:
API_BASE_URL=http://10.0.2.2:5231/api

# 2. Nếu chạy trên Windows App hoặc iOS Simulator:
# API_BASE_URL=http://localhost:5231/api

# 3. Nếu chạy trên máy thật (Physical Device) kết nối chung Wi-Fi:
# API_BASE_URL=http://192.168.0.107:5231/api

# 4. Nếu chạy qua Docker Container:
# API_BASE_URL=http://10.0.2.2:8888/api
