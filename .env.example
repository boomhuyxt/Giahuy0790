# =============================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG - GIA HUY POS (.NET WEB API)
# Sao chép tệp này thành .env và điền thông tin thật của bạn:
#   cp .env.example .env
# =============================================================================

# 1. KẾT NỐI DATABASE SUPABASE POSTGRESQL
ConnectionStrings__DefaultConnection="Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<your-project-ref>;Password=<your-db-password>;SSL Mode=Require;Trust Server Certificate=true;Timeout=60;Command Timeout=60"
DB_CONNECTION_STRING="Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<your-project-ref>;Password=<your-db-password>;SSL Mode=Require;Trust Server Certificate=true;Timeout=60;Command Timeout=60"

# 2. KHÓA BẢO MẬT JWT TOKEN
Jwt__Key="Your_Super_Secret_Key_For_Jwt_Authentication_At_Least_32_Characters"
Jwt__Issuer="Giahuy0790"
Jwt__Audience="Giahuy0790_Client"
Jwt__DurationInMinutes="1440"
JWT_SECRET_KEY="Your_Super_Secret_Key_For_Jwt_Authentication_At_Least_32_Characters"

# 3. CẤU HÌNH GỬI EMAIL XÁC THỰC OTP QUA SMTP (GMAIL)
SmtpSettings__Server="smtp.gmail.com"
SmtpSettings__Port="587"
SmtpSettings__SenderName="Gia Huy POS"
SmtpSettings__SenderEmail="your-email@gmail.com"
SmtpSettings__Username="your-email@gmail.com"
SmtpSettings__Password="xxxx xxxx xxxx xxxx"
SmtpSettings__EnableSsl="true"

SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SENDER_NAME="Gia Huy POS"
SMTP_SENDER_EMAIL="your-email@gmail.com"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_ENABLE_SSL="true"
