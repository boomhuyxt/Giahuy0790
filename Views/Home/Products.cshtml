@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="row g-4">
    <!-- Header Page -->
    <div class="col-12">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-4 rounded-4 bg-body-tertiary border shadow-sm">
            <div>
                <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                    <span>🛍️</span>
                    <span>Quản lý Sản phẩm</span>
                </h2>
                <p class="text-body-secondary mb-0">
                    Gọi các API: Thêm, Xóa, Sửa, Tìm theo ID & Tìm kiếm theo tên sản phẩm. Hỗ trợ tải ảnh trực tiếp lên máy chủ (<code>wwwroot/uploads/products</code>).
                </p>
            </div>
            <div>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateProduct">
                    ➕ Thêm sản phẩm mới
                </button>
            </div>
        </div>
    </div>

    <!-- Thanh Tìm Kiếm & Lọc -->
    <div class="col-12">
        <div class="card border shadow-sm">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <!-- Tìm theo tên -->
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-body">🔍</span>
                            <input type="text" id="inputSearchName" class="form-control" placeholder="Nhập tên sản phẩm để tìm kiếm..." />
                            <button class="btn btn-primary" id="btnSearchName" type="button">Tìm kiếm</button>
                        </div>
                    </div>

                    <!-- Tìm theo ID -->
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-body">#</span>
                            <input type="number" id="inputSearchId" class="form-control" placeholder="Tìm theo ID..." min="1" />
                            <button class="btn btn-outline-secondary" id="btnSearchId" type="button">Tìm ID</button>
                        </div>
                    </div>

                    <!-- Nút reset danh sách -->
                    <div class="col-md-3 text-md-end">
                        <button class="btn btn-outline-secondary w-100 w-md-auto rounded-pill" id="btnReloadProducts" type="button">
                            🔄 Tải lại tất cả
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khu vực hiển thị thông báo trạng thái -->
    <div class="col-12">
        <div id="alertContainer"></div>
    </div>

    <!-- Danh sách sản phẩm (Grid Card) -->
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0">Danh sách sản phẩm (<span id="productCount">0</span>)</h5>
            <small class="text-body-secondary">Dữ liệu lấy trực tiếp từ API <code>/api/products</code></small>
        </div>

        <div id="loadingSpinner" class="text-center py-5 d-none">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="text-body-secondary mt-2">Đang tải dữ liệu sản phẩm từ Supabase...</p>
        </div>

        <div class="row g-4" id="productListContainer">
            <!-- Sản phẩm sẽ được render vào đây bằng JS -->
        </div>

        <div id="emptyState" class="text-center py-5 d-none">
            <div class="display-1 text-body-secondary mb-3">📦</div>
            <h5 class="text-body-secondary">Chưa có sản phẩm nào</h5>
            <p class="text-body-secondary">Bấm "Thêm sản phẩm mới" để bắt đầu lưu vào database.</p>
        </div>
    </div>
</div>

<!-- ================= MODAL THÊM SẢN PHẨM ================= -->
<div class="modal fade" id="modalCreateProduct" tabindex="-1" aria-labelledby="modalCreateProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalCreateProductLabel">➕ Thêm sản phẩm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCreateProduct">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" id="createName" class="form-control" placeholder="Ví dụ: iPhone 15 Pro Max" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" id="createPrice" class="form-control" placeholder="Ví dụ: 29990000" min="0" step="1000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hình ảnh sản phẩm</label>
                        <!-- Tùy chọn 1: Chọn file từ máy để upload vào wwwroot/uploads/products -->
                        <div class="mb-2">
                            <input type="file" id="createFileInput" class="form-control form-control-sm" accept="image/*" />
                            <small class="text-body-secondary d-block mt-1">📁 Chọn file từ máy để tự động tải lên thư mục <code>wwwroot/uploads/products/</code></small>
                        </div>
                        <!-- Tùy chọn 2: Hoặc dán URL -->
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-body">🔗 URL</span>
                            <input type="text" id="createImage" class="form-control" placeholder="/uploads/products/... hoặc link web" />
                        </div>
                        <!-- Preview ảnh -->
                        <div id="createPreviewContainer" class="d-none mt-2 text-center p-2 rounded-3 bg-body-secondary border">
                            <img id="createPreviewImg" src="" style="max-height: 140px; max-width: 100%; object-fit: contain;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea id="createDescription" class="form-control" rows="3" placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="btnSaveProduct">Lưu sản phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL SỬA SẢN PHẨM ================= -->
<div class="modal fade" id="modalEditProduct" tabindex="-1" aria-labelledby="modalEditProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalEditProductLabel">✏️ Chỉnh sửa sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditProduct">
                <input type="hidden" id="editId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" id="editPrice" class="form-control" min="0" step="1000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hình ảnh sản phẩm</label>
                        <div class="mb-2">
                            <input type="file" id="editFileInput" class="form-control form-control-sm" accept="image/*" />
                            <small class="text-body-secondary d-block mt-1">📁 Chọn ảnh mới từ máy nếu muốn thay đổi</small>
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-body">🔗 URL</span>
                            <input type="text" id="editImage" class="form-control" />
                        </div>
                        <div id="editPreviewContainer" class="d-none mt-2 text-center p-2 rounded-3 bg-body-secondary border">
                            <img id="editPreviewImg" src="" style="max-height: 140px; max-width: 100%; object-fit: contain;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4" id="btnUpdateProduct">Cập nhật thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL CHI TIẾT SẢN PHẨM ================= -->
<div class="modal fade" id="modalDetailProduct" tabindex="-1" aria-labelledby="modalDetailProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalDetailProductLabel">🔍 Chi tiết sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center" id="detailContent">
                <!-- Nội dung chi tiết nạp qua JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const API_URL = '/api/products';
    const API_UPLOAD_URL = '/api/uploads/product';
    let currentProducts = [];

    // Helper: Định dạng tiền VNĐ
    const formatVND = (price) => {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
    };

    // Helper: Hiển thị thông báo
    const showAlert = (message, type = 'success') => {
        const container = document.getElementById('alertContainer');
        container.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show shadow-sm" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        setTimeout(() => {
            const alert = container.querySelector('.alert');
            if (alert) {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bsAlert.close();
            }
        }, 4000);
    };

    // Helper: Tải file ảnh lên wwwroot/uploads/products
    const uploadProductFile = async (fileInput, urlTargetInput, previewContainer, previewImg) => {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];

        const formData = new FormData();
        formData.append('file', file);

        showAlert('Đang tải ảnh lên thư mục wwwroot/uploads/products...', 'info');

        try {
            const res = await fetch(API_UPLOAD_URL, {
                method: 'POST',
                body: formData
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.message || 'Lỗi khi tải ảnh');
            }

            const data = await res.json();
            urlTargetInput.value = data.url;
            previewImg.src = data.url;
            previewContainer.classList.remove('d-none');
            showAlert(`✅ Đã lưu ảnh vào: ${data.url}`, 'success');
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    };

    document.getElementById('createFileInput').addEventListener('change', function() {
        uploadProductFile(
            this,
            document.getElementById('createImage'),
            document.getElementById('createPreviewContainer'),
            document.getElementById('createPreviewImg')
        );
    });

    document.getElementById('editFileInput').addEventListener('change', function() {
        uploadProductFile(
            this,
            document.getElementById('editImage'),
            document.getElementById('editPreviewContainer'),
            document.getElementById('editPreviewImg')
        );
    });

    // Cập nhật preview khi người dùng gõ URL trực tiếp
    document.getElementById('createImage').addEventListener('input', function() {
        const val = this.value.trim();
        const box = document.getElementById('createPreviewContainer');
        const img = document.getElementById('createPreviewImg');
        if (val) {
            img.src = val;
            box.classList.remove('d-none');
        } else {
            box.classList.add('d-none');
        }
    });

    document.getElementById('editImage').addEventListener('input', function() {
        const val = this.value.trim();
        const box = document.getElementById('editPreviewContainer');
        const img = document.getElementById('editPreviewImg');
        if (val) {
            img.src = val;
            box.classList.remove('d-none');
        } else {
            box.classList.add('d-none');
        }
    });

    // Render danh sách sản phẩm ra giao diện
    const renderProducts = (products) => {
        const container = document.getElementById('productListContainer');
        const emptyState = document.getElementById('emptyState');
        const countSpan = document.getElementById('productCount');
        
        countSpan.textContent = products.length;

        if (!products || products.length === 0) {
            container.innerHTML = '';
            emptyState.classList.remove('d-none');
            return;
        }

        emptyState.classList.add('d-none');
        container.innerHTML = products.map(p => `
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 border stat-card shadow-sm">
                    <div style="height: 180px; overflow: hidden; background: var(--bs-tertiary-bg);" class="d-flex align-items-center justify-content-center">
                        ${p.image ? `
                            <img src="${p.image}" class="w-100 h-100" style="object-fit: cover;" onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\\'fs-1 text-secondary\\'>🖼️</span>';" alt="${p.name || ''}" />
                        ` : `
                            <span class="fs-1 text-secondary">📦</span>
                        `}
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-secondary-subtle text-secondary border">ID: #${p.id}</span>
                            <span class="fw-bold text-primary fs-5">${formatVND(p.price)}</span>
                        </div>
                        <h6 class="card-title fw-bold text-truncate mb-1" title="${p.name || ''}">${p.name || 'Không có tên'}</h6>
                        <p class="card-text text-body-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            ${p.description || 'Chưa có mô tả cho sản phẩm này.'}
                        </p>
                        
                        <div class="d-flex gap-1 mt-3 pt-2 border-top">
                            <button class="btn btn-outline-info btn-sm flex-fill" onclick="viewDetailProduct(${p.id})">
                                👁️ Xem
                            </button>
                            <button class="btn btn-outline-warning btn-sm flex-fill" onclick="openEditModal(${p.id})">
                                ✏️ Sửa
                            </button>
                            <button class="btn btn-outline-danger btn-sm flex-fill" onclick="deleteProduct(${p.id})">
                                🗑️ Xóa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    };

    // 1. API: Lấy tất cả sản phẩm
    const loadProducts = async () => {
        const spinner = document.getElementById('loadingSpinner');
        spinner.classList.remove('d-none');
        try {
            const res = await fetch(API_URL);
            if (!res.ok) throw new Error('Không thể tải danh sách sản phẩm');
            const data = await res.json();
            currentProducts = data;
            renderProducts(data);
        } catch (err) {
            showAlert(err.message, 'danger');
        } finally {
            spinner.classList.add('d-none');
        }
    };

    // 2. API: Tìm kiếm theo tên sản phẩm
    const searchByName = async () => {
        const keyword = document.getElementById('inputSearchName').value.trim();
        const spinner = document.getElementById('loadingSpinner');
        spinner.classList.remove('d-none');
        try {
            const url = keyword ? `${API_URL}/search?name=${encodeURIComponent(keyword)}` : API_URL;
            const res = await fetch(url);
            if (!res.ok) throw new Error('Tìm kiếm thất bại');
            const data = await res.json();
            renderProducts(data);
            showAlert(`Tìm thấy ${data.length} sản phẩm phù hợp`, 'info');
        } catch (err) {
            showAlert(err.message, 'danger');
        } finally {
            spinner.classList.add('d-none');
        }
    };

    // 3. API: Tìm kiếm theo ID
    const searchById = async () => {
        const id = document.getElementById('inputSearchId').value.trim();
        if (!id) {
            showAlert('Vui lòng nhập ID sản phẩm cần tìm', 'warning');
            return;
        }

        try {
            const res = await fetch(`${API_URL}/${id}`);
            if (res.status === 404) {
                showAlert(`Không tìm thấy sản phẩm nào có ID = ${id}`, 'warning');
                return;
            }
            if (!res.ok) throw new Error('Lỗi khi tìm kiếm ID');
            const product = await res.json();
            renderProducts([product]);
            showAlert(`Đã tìm thấy sản phẩm #${id}`, 'success');
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    };

    // 4. API: Xem chi tiết theo ID (đổ vào Modal)
    window.viewDetailProduct = async (id) => {
        try {
            const res = await fetch(`${API_URL}/${id}`);
            if (!res.ok) throw new Error('Không thể lấy chi tiết sản phẩm');
            const p = await res.json();

            const detailContent = document.getElementById('detailContent');
            detailContent.innerHTML = `
                <div class="mb-3" style="max-height: 250px; overflow: hidden; border-radius: 12px; background: var(--bs-tertiary-bg);">
                    ${p.image ? `<img src="${p.image}" class="w-100" style="max-height: 250px; object-fit: contain;" alt="${p.name}" />` : '<div class="p-4 fs-1">📦</div>'}
                </div>
                <h4 class="fw-bold mb-1">${p.name || ''}</h4>
                <div class="badge bg-primary fs-6 mb-3 px-3 py-2 rounded-pill">${formatVND(p.price)}</div>
                <div class="text-start bg-body-tertiary p-3 rounded-3 border mb-3">
                    <p class="mb-2"><strong>Mã sản phẩm:</strong> #${p.id}</p>
                    <p class="mb-2"><strong>Mô tả:</strong> ${p.description || 'Không có mô tả'}</p>
                    <p class="mb-0 text-body-secondary small"><strong>Ngày tạo:</strong> ${new Date(p.createdAt).toLocaleString('vi-VN')}</p>
                </div>
            `;

            const modal = new bootstrap.Modal(document.getElementById('modalDetailProduct'));
            modal.show();
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    };

    // 5. Mở Modal Chỉnh Sửa
    window.openEditModal = async (id) => {
        try {
            const res = await fetch(`${API_URL}/${id}`);
            if (!res.ok) throw new Error('Không thể lấy thông tin sản phẩm để sửa');
            const p = await res.json();

            document.getElementById('editId').value = p.id;
            document.getElementById('editName').value = p.name || '';
            document.getElementById('editPrice').value = p.price;
            document.getElementById('editImage').value = p.image || '';
            document.getElementById('editDescription').value = p.description || '';
            document.getElementById('editFileInput').value = '';

            const previewBox = document.getElementById('editPreviewContainer');
            const previewImg = document.getElementById('editPreviewImg');
            if (p.image) {
                previewImg.src = p.image;
                previewBox.classList.remove('d-none');
            } else {
                previewBox.classList.add('d-none');
            }

            const modal = new bootstrap.Modal(document.getElementById('modalEditProduct'));
            modal.show();
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    };

    // 6. API: Thêm sản phẩm (POST)
    document.getElementById('formCreateProduct').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            name: document.getElementById('createName').value.trim(),
            price: parseFloat(document.getElementById('createPrice').value),
            image: document.getElementById('createImage').value.trim() || null,
            description: document.getElementById('createDescription').value.trim() || null
        };

        try {
            const res = await fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errData = await res.json();
                throw new Error(errData.message || 'Lỗi khi thêm sản phẩm');
            }

            const newProduct = await res.json();
            bootstrap.Modal.getInstance(document.getElementById('modalCreateProduct')).hide();
            document.getElementById('formCreateProduct').reset();
            document.getElementById('createPreviewContainer').classList.add('d-none');
            showAlert(`✅ Đã thêm sản phẩm "${newProduct.name}" thành công!`);
            loadProducts();
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    });

    // 7. API: Sửa sản phẩm (PUT)
    document.getElementById('formEditProduct').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editId').value;
        const payload = {
            name: document.getElementById('editName').value.trim(),
            price: parseFloat(document.getElementById('editPrice').value),
            image: document.getElementById('editImage').value.trim() || null,
            description: document.getElementById('editDescription').value.trim() || null
        };

        try {
            const res = await fetch(`${API_URL}/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errData = await res.json();
                throw new Error(errData.message || 'Lỗi khi cập nhật sản phẩm');
            }

            bootstrap.Modal.getInstance(document.getElementById('modalEditProduct')).hide();
            showAlert(`✅ Đã cập nhật sản phẩm #${id} thành công!`);
            loadProducts();
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    });

    // 8. API: Xóa sản phẩm (DELETE)
    window.deleteProduct = async (id) => {
        if (!confirm(`Bạn có chắc chắn muốn xóa sản phẩm #${id} này không?`)) {
            return;
        }

        try {
            const res = await fetch(`${API_URL}/${id}`, {
                method: 'DELETE'
            });

            if (!res.ok) throw new Error('Lỗi khi xóa sản phẩm');

            showAlert(`✅ Đã xóa sản phẩm #${id} thành công!`);
            loadProducts();
        } catch (err) {
            showAlert(err.message, 'danger');
        }
    };

    // Sự kiện
    document.getElementById('btnSearchName').addEventListener('click', searchByName);
    document.getElementById('inputSearchName').addEventListener('keyup', (e) => {
        if (e.key === 'Enter') searchByName();
    });

    document.getElementById('btnSearchId').addEventListener('click', searchById);
    document.getElementById('inputSearchId').addEventListener('keyup', (e) => {
        if (e.key === 'Enter') searchById();
    });

    document.getElementById('btnReloadProducts').addEventListener('click', () => {
        document.getElementById('inputSearchName').value = '';
        document.getElementById('inputSearchId').value = '';
        loadProducts();
    });

    // Khởi chạy khi tải trang
    document.addEventListener('DOMContentLoaded', loadProducts);
</script>
}
