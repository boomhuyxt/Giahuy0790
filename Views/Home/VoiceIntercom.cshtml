    // 6. Phát file âm thanh
    window.playVoiceAudio = function(msgId, audioUrl, btn) {
        if (currentlyPlayingAudio) {
            currentlyPlayingAudio.pause();
            currentlyPlayingAudio = null;
            document.querySelectorAll('#voiceMessagesList .bi-pause-fill').forEach(icon => {
                icon.className = 'bi bi-play-fill fs-5';
            });
        }

        const icon = btn.querySelector('i');
        const audio = new Audio(audioUrl);
        currentlyPlayingAudio = audio;
        icon.className = 'bi bi-pause-fill fs-5';

        // Đánh dấu đã nghe
        fetch(`/api/voicemessages/${msgId}/mark-heard`, {
            method: 'PUT',
            headers: getAuthHeaders()
        }).catch(() => {});

        audio.play().catch(e => {
            console.error('Audio play error:', e);
            icon.className = 'bi bi-play-fill fs-5';
            currentlyPlayingAudio = null;
            alert('Không thể phát file âm thanh này.');
        });

        audio.onended = () => {
            icon.className = 'bi bi-play-fill fs-5';
            currentlyPlayingAudio = null;
        };

        audio.onerror = () => {
            icon.className = 'bi bi-play-fill fs-5';
            currentlyPlayingAudio = null;
            alert('Lỗi định dạng file âm thanh.');
        };
    };

    // 7. Xóa tin nhắn giọng nói
    window.deleteVoiceMessage = async function(id) {
        if (!confirm('Bạn có chắc chắn muốn xóa tin nhắn thoại này?')) return;
        try {
            const res = await fetch(`/api/voicemessages/${id}`, {
                method: 'DELETE',
                headers: getAuthHeaders()
            });
            if (res.ok) {
                await loadVoiceMessages(false);
            }
        } catch (_) {}
    };

    // 8. Điều khiển bộ đàm Push-To-Talk và Tap-to-Talk
    function setupPttControls() {
        const btnPtt = document.getElementById('btnPtt');
        const btnCancel = document.getElementById('btnCancelRecord');
        const btnSend = document.getElementById('btnSendRecord');

        // Bấm để bắt đầu hoặc bấm để gửi
        btnPtt.addEventListener('click', async (e) => {
            e.preventDefault();
            if (isStarting || isUploading) return;

            if (!isRecording) {
                await startMp3Recording();
            } else {
                await stopAndSendMp3Recording();
            }
        });

        // Hỗ trợ giữ để nói (Push-To-Talk)
        btnPtt.addEventListener('pointerdown', (e) => {
            pointerPressStartTime = Date.now();
        });

        btnPtt.addEventListener('pointerup', async (e) => {
            const pressDuration = Date.now() - pointerPressStartTime;
            if (isRecording && pressDuration >= 700) {
                await stopAndSendMp3Recording();
            }
        });

        btnCancel.addEventListener('click', cancelMp3Recording);
        btnSend.addEventListener('click', async () => {
            await stopAndSendMp3Recording();
        });
    }

    // =========================================================================
    // THU ÂM VÀ MÃ HÓA TRỰC TIẾP SANG ĐỊNH DẠNG MP3 BẰNG LAME.JS & WEB AUDIO API
    // =========================================================================
    async function startMp3Recording() {
        if (isRecording || isStarting || isUploading) return;
        isStarting = true;

        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang khởi động bộ mã hóa MP3...';

        try {
            // 1. Mở micro thiết bị
            micStream = await navigator.mediaDevices.getUserMedia({
                audio: {
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true
                }
            });

            // 2. Khởi tạo AudioContext
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            micSource = audioCtx.createMediaStreamSource(micStream);

            // 3. Khởi tạo LAME MP3 Encoder (Mono, SampleRate của thiết bị, Bitrate 128kbps chuẩn nét)
            const sampleRate = audioCtx.sampleRate || 44100;
            if (typeof lamejs === 'undefined' || !lamejs.Mp3Encoder) {
                throw new Error('Thư viện lamejs chưa sẵn sàng.');
            }
            mp3Encoder = new lamejs.Mp3Encoder(1, sampleRate, 128);
            mp3DataChunks = [];

            // 4. ScriptProcessorNode lấy mẫu PCM và mã hóa liên tục
            // bufferSize: 4096 (chuẩn tối ưu cho xử lý âm thanh không giật)
            scriptProcessor = audioCtx.createScriptProcessor(4096, 1, 1);
            scriptProcessor.onaudioprocess = (e) => {
                if (!isRecording) return;
                const inputFloat = e.inputBuffer.getChannelData(0);
                const sampleLength = inputFloat.length;
                const pcm16 = new Int16Array(sampleLength);

                for (let i = 0; i < sampleLength; i++) {
                    const s = Math.max(-1, Math.min(1, inputFloat[i]));
                    pcm16[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
                }

                const mp3buf = mp3Encoder.encodeBuffer(pcm16);
                if (mp3buf.length > 0) {
                    mp3DataChunks.push(mp3buf);
                }
            };

            // Gain node chống vang (mute feedback vào loa)
            muteGain = audioCtx.createGain();
            muteGain.gain.value = 0;

            micSource.connect(scriptProcessor);
            scriptProcessor.connect(muteGain);
            muteGain.connect(audioCtx.destination);

            // Analyser cho visualizer sóng âm
            startVisualizer(micStream);

            isRecording = true;
            recordStartTime = Date.now();
            playAppleBeep('start');

            updatePttUi(true);
            startRecordTimer();

            if (lcdStatus) lcdStatus.textContent = 'Đang ghi âm MP3... Bấm lại hoặc bấm "Gửi ngay" khi nói xong!';

        } catch (err) {
            console.error('Lỗi mở microphone / MP3 encoder:', err);
            isRecording = false;
            updatePttUi(false);

            if (lcdStatus) lcdStatus.textContent = '❌ Không thể truy cập microphone.';

            if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
                alert('Trình duyệt chưa được cấp quyền Microphone. Vui lòng bấm vào biểu tượng cài đặt cạnh thanh địa chỉ web, chọn "Cho phép Microphone" và thử lại!');
            } else if (err.name === 'NotFoundError') {
                alert('Không tìm thấy microphone trên máy. Bạn có thể sử dụng nút "Gửi file MP3 có sẵn" bên dưới để gửi!');
            } else {
                alert('Không thể mở micro: ' + err.message);
            }
        } finally {
            isStarting = false;
        }
    }

    // Dừng thu âm, đóng gói MP3 và gửi lên server
    async function stopAndSendMp3Recording() {
        if (!isRecording || isUploading) return;
        isRecording = false;
        isUploading = true;

        clearInterval(recordTimerInterval);
        stopVisualizer();
        playAppleBeep('end');

        const duration = Math.max(1, Math.round((Date.now() - recordStartTime) / 1000));
        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang đóng gói file MP3 và lưu vào thư mục...';

        try {
            // 1. Flush dữ liệu MP3 còn trong encoder
            if (mp3Encoder) {
                const mp3Flush = mp3Encoder.flush();
                if (mp3Flush.length > 0) {
                    mp3DataChunks.push(mp3Flush);
                }
            }

            // 2. Ngắt kết nối Web Audio
            if (scriptProcessor) {
                scriptProcessor.disconnect();
                scriptProcessor.onaudioprocess = null;
                scriptProcessor = null;
            }
            if (micSource) {
                micSource.disconnect();
                micSource = null;
            }
            if (muteGain) {
                muteGain.disconnect();
                muteGain = null;
            }
            if (audioCtx) {
                audioCtx.close().catch(() => {});
                audioCtx = null;
            }
            if (micStream) {
                micStream.getTracks().forEach(t => t.stop());
                micStream = null;
            }

            // 3. Tạo Blob chuẩn MP3
            const mp3Blob = new Blob(mp3DataChunks, { type: 'audio/mp3' });

            if (mp3Blob.size === 0) {
                alert('Bản ghi âm quá ngắn hoặc không có âm thanh. Vui lòng nói to hơn và thử lại!');
                updatePttUi(false);
                return;
            }

            // 4. Upload file MP3 lên server
            await uploadVoiceMessage(mp3Blob, duration, 'audio/mp3');

        } catch (err) {
            console.error('Lỗi đóng gói MP3:', err);
            alert('Lỗi: ' + err.message);
        } finally {
            isUploading = false;
            updatePttUi(false);
        }
    }

    // Hủy thu âm
    function cancelMp3Recording() {
        isRecording = false;
        isStarting = false;
        isUploading = false;

        clearInterval(recordTimerInterval);
        stopVisualizer();

        if (scriptProcessor) {
            scriptProcessor.disconnect();
            scriptProcessor.onaudioprocess = null;
            scriptProcessor = null;
        }
        if (micSource) { micSource.disconnect(); micSource = null; }
        if (muteGain) { muteGain.disconnect(); muteGain = null; }
        if (audioCtx) { audioCtx.close().catch(() => {}); audioCtx = null; }
        if (micStream) {
            micStream.getTracks().forEach(t => t.stop());
            micStream = null;
        }
        mp3DataChunks = [];
        updatePttUi(false);

        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) {
            lcdStatus.textContent = 'Đã hủy bản ghi âm.';
            setTimeout(() => {
                lcdStatus.textContent = 'Sẵn sàng thu âm MP3. Bấm nút dưới để nói!';
            }, 1500);
        }
    }

    // Gửi file MP3 lên server lưu vào thư mục wwwroot/uploads/voice/
    async function uploadVoiceMessage(blob, duration, mimeType) {
        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang lưu file MP3 vào máy chủ...';

        // Luôn đặt phần mở rộng là .mp3
        const fileName = `voice_${Date.now()}.mp3`;
        const formData = new FormData();
        formData.append('audioFile', blob, fileName);
        formData.append('durationSeconds', duration);
        if (!isKidRole && currentKidId) {
            formData.append('kidId', currentKidId);
        }

        try {
            const token = localStorage.getItem('authToken');
            if (!token) {
                handleAuthExpired();
                return;
            }

            const res = await fetch('/api/voicemessages/send', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData
            });

            if (res.status === 401) {
                handleAuthExpired();
                return;
            }

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || 'Lỗi gửi tin nhắn thoại từ máy chủ');
            }

            const data = await res.json();
            if (lcdStatus) lcdStatus.textContent = `✅ Đã lưu file MP3 (${data.voiceMessage?.audioUrl}) và gửi thành công!`;
            await loadVoiceMessages(false);

            setTimeout(() => {
                if (lcdStatus) lcdStatus.textContent = 'Sẵn sàng thu âm MP3. Bấm nút dưới để nói!';
            }, 2500);

        } catch (err) {
            console.error('Lỗi upload:', err);
            if (lcdStatus) lcdStatus.textContent = '❌ ' + err.message;
            alert('Lỗi gửi tin nhắn giọng nói: ' + err.message);
        }
    }

    // Xử lý khi phiên đăng nhập hết hạn
    function handleAuthExpired() {
        localStorage.removeItem('authToken');
        localStorage.removeItem('authUser');
        alert('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để tiếp tục đàm thoại.');
        const modal = new bootstrap.Modal(document.getElementById('modalLogin'));
        modal.show();
    }

    // Tùy chọn 1: Người dùng chọn file MP3 từ máy để gửi
    window.handleAudioFileUpload = async function(input) {
        if (!input.files || input.files.length === 0) return;
        const file = input.files[0];

        if (file.size > 20 * 1024 * 1024) {
            alert('Dung lượng file âm thanh không được vượt quá 20MB.');
            input.value = '';
            return;
        }

        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = `Đang lưu file MP3 "${file.name}"...`;

        try {
            await uploadVoiceMessage(file, 5, 'audio/mp3');
        } finally {
            input.value = '';
        }
    };

    // Tùy chọn 2: Gửi tin nhắn thoại MP3 mẫu kiểm tra bộ đàm
    window.sendTestMp3VoiceMessage = async function() {
        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang tạo file MP3 mẫu (128kbps) và gửi kiểm tra...';

        try {
            if (typeof lamejs === 'undefined' || !lamejs.Mp3Encoder) {
                throw new Error('Thư viện mã hóa MP3 chưa được tải.');
            }

            const sampleRate = 44100;
            const durationSec = 1;
            const numSamples = sampleRate * durationSec;
            const enc = new lamejs.Mp3Encoder(1, sampleRate, 128);

            // Sinh sóng sine 587Hz (nốt Re D5)
            const pcm16 = new Int16Array(numSamples);
            for (let i = 0; i < numSamples; i++) {
                const t = i / sampleRate;
                pcm16[i] = Math.sin(2 * Math.PI * 587.33 * t) * 0.4 * 32767;
            }

            const chunks = [];
            const buf1 = enc.encodeBuffer(pcm16);
            if (buf1.length > 0) chunks.push(buf1);
            const buf2 = enc.flush();
            if (buf2.length > 0) chunks.push(buf2);

            const mp3Blob = new Blob(chunks, { type: 'audio/mp3' });
            await uploadVoiceMessage(mp3Blob, 1, 'audio/mp3');
        } catch (err) {
            alert('Lỗi tạo và gửi tin MP3 mẫu: ' + err.message);
        }
    };

    function updatePttUi(recording) {
        const btn = document.getElementById('btnPtt');
        const icon = document.getElementById('btnPttIcon');
        const text = document.getElementById('btnPttText');
        const led = document.getElementById('badgeLedStatus');
        const recBadge = document.getElementById('lcdRecIndicator');
        const actionBox = document.getElementById('boxRecordingActions');

        if (recording) {
            btn.classList.add('recording');
            icon.className = 'bi bi-stop-fill fs-1 mb-1';
            text.textContent = 'BẤM ĐỂ GỬI';

            led.style.background = '#fee2e2';
            led.style.color = '#dc2626';
            led.textContent = '● ĐANG GHI MP3';
            recBadge.style.display = 'inline';
            actionBox.style.setProperty('display', 'flex', 'important');
        } else {
            btn.classList.remove('recording');
            icon.className = 'bi bi-mic-fill fs-1 mb-1';
            text.textContent = 'BẤM ĐỂ NÓI';

            led.style.background = 'var(--apple-blue-soft)';
            led.style.color = 'var(--apple-blue)';
            led.textContent = '● SẴN SÀNG';
            recBadge.style.display = 'none';
            actionBox.style.setProperty('display', 'none', 'important');
            document.getElementById('lcdTimer').textContent = '00:00';
        }
    }

    function startRecordTimer() {
        const timerEl = document.getElementById('lcdTimer');
        recordTimerInterval = setInterval(() => {
            const elapsed = Math.round((Date.now() - recordStartTime) / 1000);
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            timerEl.textContent = `${mins}:${secs}`;

            // Tự động dừng sau 60s
            if (elapsed >= 60) {
                stopAndSendMp3Recording();
            }
        }, 250);
    }

    function startVisualizer(stream) {
        try {
            const vCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
            const source = vCtx.createMediaStreamSource(stream);
            analyserNode = vCtx.createAnalyser();
            analyserNode.fftSize = 32;
            source.connect(analyserNode);

            const bufferLength = analyserNode.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            const bars = document.querySelectorAll('#lcdWaveform div');

            function updateBars() {
                if (!isRecording) return;
                analyserNode.getByteFrequencyData(dataArray);

                bars.forEach((bar, idx) => {
                    const val = dataArray[idx % bufferLength] || 10;
                    const h = Math.max(4, Math.round((val / 255) * 24));
                    bar.style.height = `${h}px`;
                });

                visualizerAnimation = requestAnimationFrame(updateBars);
            }
            updateBars();
        } catch (_) {}
    }

    function stopVisualizer() {
        if (visualizerAnimation) cancelAnimationFrame(visualizerAnimation);
        document.querySelectorAll('#lcdWaveform div').forEach((bar, idx) => {
            bar.style.height = `${(idx % 4 + 1) * 5}px`;
        });
    }
</script>
}
