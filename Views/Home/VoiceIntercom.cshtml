@{
    ViewData["Title"] = "Bộ Đàm Gia Đình - Đàm Thoại Giọng Nói";
}

<style>
    /* Apple Minimalist 3-Color Design System (Black, White, Blue) */
    :root {
        --apple-blue: #0071e3;
        --apple-blue-hover: #0077ed;
        --apple-blue-soft: #eff6ff;
        --apple-blue-border: #bfdbfe;
        --apple-black: #000000;
        --apple-dark: #111827;
        --apple-gray: #6b7280;
        --apple-light-gray: #f4f4f5;
        --apple-card-bg: #ffffff;
        --apple-border: #e5e7eb;
    }

    .apple-voice-card {
        background-color: var(--apple-card-bg);
        border: 1px solid var(--apple-border);
        border-radius: 1.25rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        transition: all 0.2s ease;
    }

    .apple-btn-blue {
        background-color: var(--apple-blue);
        color: #ffffff;
        border: none;
        border-radius: 9999px;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .apple-btn-blue:hover {
        background-color: var(--apple-blue-hover);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 113, 227, 0.25);
    }

    .apple-btn-outline {
        background-color: #ffffff;
        color: var(--apple-dark);
        border: 1px solid var(--apple-border);
        border-radius: 9999px;
        font-weight: 500;
        transition: all 0.15s ease;
    }
    .apple-btn-outline:hover {
        background-color: var(--apple-light-gray);
        color: var(--apple-black);
    }

    .apple-channel-pill {
        border-radius: 9999px;
        padding: 0.4rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        border: 1px solid var(--apple-border);
        background: #ffffff;
        color: var(--apple-dark);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }
    .apple-channel-pill.active {
        background: var(--apple-blue);
        color: #ffffff;
        border-color: var(--apple-blue);
        box-shadow: 0 2px 8px rgba(0, 113, 227, 0.25);
    }

    /* PTT Big Button */
    .apple-ptt-button {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0071e3 0%, #0056b3 100%);
        border: 4px solid #ffffff;
        box-shadow: 0 8px 24px rgba(0, 113, 227, 0.35);
        color: #ffffff;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        user-select: none;
        touch-action: manipulation;
        transition: all 0.2s ease;
        outline: none;
    }
    .apple-ptt-button:hover {
        transform: scale(1.03);
        box-shadow: 0 10px 28px rgba(0, 113, 227, 0.45);
    }
    .apple-ptt-button.recording {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%) !important;
        transform: scale(0.96);
        box-shadow: 0 0 0 10px rgba(220, 38, 38, 0.2), 0 8px 24px rgba(220, 38, 38, 0.4);
        animation: applePulseRed 1.4s infinite;
    }

    @@keyframes applePulseRed {
        0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5); }
        70% { box-shadow: 0 0 0 16px rgba(220, 38, 38, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }

    /* Audio wave visualizer bar */
    .apple-sound-bar {
        width: 4px;
        background-color: var(--apple-blue);
        border-radius: 2px;
        transition: height 0.1s ease;
    }

    /* Message Bubbles */
    .apple-bubble-me {
        background-color: var(--apple-blue);
        color: #ffffff;
        border-radius: 1.25rem 1.25rem 0.25rem 1.25rem;
    }
    .apple-bubble-other {
        background-color: #ffffff;
        color: var(--apple-dark);
        border: 1px solid var(--apple-border);
        border-radius: 1.25rem 1.25rem 1.25rem 0.25rem;
    }

    .apple-audio-player-pill {
        background: rgba(255, 255, 255, 0.18);
        border-radius: 9999px;
        padding: 0.35rem 0.75rem;
    }
    .apple-bubble-other .apple-audio-player-pill {
        background: var(--apple-light-gray);
    }
</style>

<div class="container py-4" style="max-width: 1040px;">
    <!-- Apple Header -->
    <div class="apple-voice-card p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge" style="background-color: var(--apple-blue-soft); color: var(--apple-blue); font-size: 0.75rem; font-weight: 600;">
                        VOICE INTERCOM
                    </span>
                    <span class="text-muted small">● Kết nối trực tiếp</span>
                </div>
                <h3 class="fw-bold mb-1" style="color: var(--apple-black); letter-spacing: -0.02em;">
                    Bộ Đàm Gia Đình
                </h3>
                <p class="text-muted mb-0 small">
                    Đàm thoại giọng nói tức thì giữa Ba Mẹ và Bé. Nhấn nút để nói và gửi tin nhắn thoại.
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <a href="/kids" class="btn apple-btn-outline btn-sm px-3 py-2">
                    <i class="bi bi-people me-1"></i> Quản lý bé
                </a>
                <a href="/screentime" class="btn apple-btn-outline btn-sm px-3 py-2">
                    <i class="bi bi-clock me-1"></i> Giờ dùng máy
                </a>
            </div>
        </div>
    </div>

    <!-- Alert placeholder -->
    <div id="pageAlert"></div>

    <!-- Thông báo khi chưa đăng nhập -->
    <div id="authRequiredNotice" class="apple-voice-card p-4 mb-4 text-center" style="display: none;">
        <div class="mb-3">
            <div class="d-inline-flex p-3 rounded-circle" style="background: var(--apple-blue-soft); color: var(--apple-blue); font-size: 2rem;">
                <i class="bi bi-mic"></i>
            </div>
        </div>
        <h5 class="fw-bold mb-1" style="color: var(--apple-black);">Đăng nhập để sử dụng bộ đàm</h5>
        <p class="text-muted small mb-3">Vui lòng đăng nhập tài khoản Phụ huynh hoặc tài khoản Bé để gửi và nhận tin nhắn thoại.</p>
        <button class="btn apple-btn-blue px-4 py-2" data-bs-toggle="modal" data-bs-target="#modalLogin">
            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
        </button>
    </div>

    <!-- KÊNH ĐÀM THOẠI (DÀNH CHO PHỤ HUYNH) -->
    <div class="apple-voice-card p-3 mb-4" id="kidChannelSelector" style="display: none;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-semibold small text-muted">
                    <i class="bi bi-person-circle me-1" style="color: var(--apple-blue);"></i> Đang kết nối với:
                </span>
                <div id="kidSelectorPills" class="d-flex flex-wrap gap-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            </div>
            <div class="small text-muted" id="currentChannelLabel">
                Đang kết nối...
            </div>
        </div>
    </div>

    <!-- KÊNH BÉ (KHI TÀI KHOẢN CON ĐĂNG NHẬP) -->
    <div class="apple-voice-card p-3 mb-4" id="kidSelfChannelNotice" style="display: none; background: var(--apple-blue-soft); border-color: var(--apple-blue-border);">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-broadcast text-primary fs-5"></i>
                <span class="small" style="color: var(--apple-dark);">
                    Kênh bộ đàm của bé <strong id="kidSelfName">...</strong> kết nối trực tiếp với <strong>Ba Mẹ</strong>
                </span>
            </div>
            <span class="badge apple-btn-blue px-3 py-1 small">KÊNH CỦA BÉ</span>
        </div>
    </div>

    <!-- GIAO DIỆN CHÍNH: 2 CỘT -->
    <div class="row g-4" id="intercomMainContent" style="display: none;">
        
        <!-- CỘT TRÁI: DANH SÁCH TIN NHẮN THOẠI (FEED) -->
        <div class="col-lg-7">
            <div class="apple-voice-card p-4 h-100 d-flex flex-column" style="min-height: 540px;">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom" style="border-color: var(--apple-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-quote-fill" style="color: var(--apple-blue);"></i>
                        <h6 class="fw-bold mb-0" style="color: var(--apple-black);">Hộp thư thoại</h6>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill bg-light text-dark border small" id="lblMessageCount">0 tin nhắn</span>
                        <button type="button" class="btn btn-sm apple-btn-outline p-1 px-2" onclick="loadVoiceMessages(true)" title="Làm mới tin nhắn">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- Feed container -->
                <div id="voiceFeedContainer" class="flex-grow-1 overflow-auto pe-2 d-flex flex-column gap-3" style="max-height: 520px; min-height: 380px;">
                    <!-- Loading -->
                    <div id="feedLoadingBox" class="text-center py-5 my-auto">
                        <div class="spinner-border" style="color: var(--apple-blue); width: 1.75rem; height: 1.75rem;" role="status"></div>
                        <div class="small text-muted mt-2">Đang tải tin nhắn thoại...</div>
                    </div>
                    <!-- Empty -->
                    <div id="feedEmptyBox" class="text-center py-5 my-auto" style="display: none;">
                        <div class="mb-2" style="font-size: 2.5rem; color: var(--apple-gray);">🎙️</div>
                        <h6 class="fw-bold mb-1" style="color: var(--apple-black);">Chưa có tin nhắn thoại nào</h6>
                        <p class="text-muted small mb-0">Nhấn nút bên phải để ghi âm và gửi tin nhắn đầu tiên!</p>
                    </div>
                    <!-- Message bubbles injected here -->
                    <div id="voiceMessagesList" class="d-flex flex-column gap-3"></div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: MÁY BỘ ĐÀM (APPLE INTERCOM CONSOLE) -->
        <div class="col-lg-5">
            <div class="apple-voice-card p-4 h-100 d-flex flex-column justify-content-between">
                
                <div>
                    <!-- Header máy bộ đàm -->
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--apple-border) !important;">
                        <span class="small fw-semibold text-muted">BỘ ĐÀM TRỰC TUYẾN</span>
                        <span class="badge" id="badgeLedStatus" style="background: var(--apple-blue-soft); color: var(--apple-blue); font-weight: 600;">
                            ● SẴN SÀNG
                        </span>
                    </div>

                    <!-- Màn hình trạng thái bộ đàm (Apple Status Display) -->
                    <div class="p-3 rounded-4 mb-4 text-center border" id="intercomScreen" style="background: var(--apple-light-gray); border-color: var(--apple-border);">
                        <div class="d-flex justify-content-between align-items-center mb-1 small text-muted" style="font-size: 11px;">
                            <span id="lcdChannelName" class="fw-bold text-uppercase">CH: GIA ĐÌNH</span>
                            <span id="lcdRecIndicator" style="display: none; color: #dc2626; font-weight: 700;">● ĐANG GHI ÂM</span>
                        </div>

                        <!-- Đồng hồ đếm giây -->
                        <div class="display-5 fw-bold my-2" id="lcdTimer" style="color: var(--apple-black); font-variant-numeric: tabular-nums; letter-spacing: -0.03em;">
                            00:00
                        </div>

                        <!-- Waveform bars -->
                        <div class="d-flex justify-content-center align-items-end gap-1 mb-2" id="lcdWaveform" style="height: 24px;">
                            <div class="apple-sound-bar" style="height: 6px;"></div>
                            <div class="apple-sound-bar" style="height: 10px;"></div>
                            <div class="apple-sound-bar" style="height: 14px;"></div>
                            <div class="apple-sound-bar" style="height: 20px;"></div>
                            <div class="apple-sound-bar" style="height: 24px;"></div>
                            <div class="apple-sound-bar" style="height: 16px;"></div>
                            <div class="apple-sound-bar" style="height: 12px;"></div>
                            <div class="apple-sound-bar" style="height: 8px;"></div>
                            <div class="apple-sound-bar" style="height: 14px;"></div>
                            <div class="apple-sound-bar" style="height: 18px;"></div>
                        </div>

                        <div class="small text-muted" id="lcdStatusText" style="font-size: 12px;">
                            Sẵn sàng đàm thoại. Bấm nút dưới để nói!
                        </div>
                    </div>
                </div>

                <!-- Khu vực nút bấm bộ đàm -->
                <div class="text-center py-2">
                    <button type="button" class="apple-ptt-button" id="btnPtt" title="Bấm để nói, bấm lần nữa để gửi">
                        <i class="bi bi-mic-fill fs-1 mb-1" id="btnPttIcon"></i>
                        <span class="small fw-semibold" id="btnPttText" style="font-size: 13px;">BẤM ĐỂ NÓI</span>
                    </button>

                    <!-- Phím điều khiển nhanh khi đang ghi âm -->
                    <div class="d-flex justify-content-center gap-2 mt-3" id="boxRecordingActions" style="display: none !important;">
                        <button type="button" class="btn apple-btn-outline btn-sm px-3" id="btnCancelRecord">
                            <i class="bi bi-x-circle me-1"></i> Hủy
                        </button>
                        <button type="button" class="btn apple-btn-blue btn-sm px-4" id="btnSendRecord">
                            <i class="bi bi-send-fill me-1"></i> Gửi ngay
                        </button>
                    </div>

                    <div class="mt-3 text-muted small" style="font-size: 12px;">
                        💡 <em>Bấm 1 lần để nói, bấm lần nữa để gửi ngay. Hoặc giữ nút để nói và thả tay để gửi!</em>
                    </div>

                    <!-- Tùy chọn gửi file âm thanh hoặc gửi tin nhắn mẫu kiểm tra -->
                    <div class="mt-3 pt-3 border-top d-flex flex-column gap-2" style="border-color: var(--apple-border) !important;">
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <label class="btn btn-sm apple-btn-outline py-1 px-3 m-0" style="cursor: pointer;" title="Chọn file ghi âm từ máy tính hoặc điện thoại để gửi">
                                <i class="bi bi-paperclip me-1"></i> Gửi file âm thanh
                                <input type="file" id="fileAudioUpload" accept="audio/*,.webm,.ogg,.wav,.mp3,.m4a,.mp4" style="display: none;" onchange="handleAudioFileUpload(this)" />
                            </label>
                            <button type="button" class="btn btn-sm apple-btn-outline py-1 px-3" onclick="sendTestVoiceMessage()" title="Tự động tạo âm thanh mẫu và gửi để kiểm tra đường truyền">
                                <i class="bi bi-soundwave me-1"></i> Gửi tin mẫu kiểm tra
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    let currentKidId = null;
    let kidsList = [];
    let isKidRole = false;
    let mediaRecorder = null;
    let mediaStream = null;
    let audioChunks = [];
    let recordStartTime = null;
    let recordTimerInterval = null;
    let audioContext = null;
    let analyserNode = null;
    let visualizerAnimation = null;
    let pollInterval = null;
    let currentlyPlayingAudio = null;
    let isRecording = false;
    let isStarting = false;
    let isUploading = false;
    let pointerPressStartTime = 0;

    function getAuthHeaders() {
        const token = localStorage.getItem('authToken');
        return {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': `Bearer ${token}` } : {})
        };
    }

    // Âm thanh thông báo nhẹ nhàng chuẩn Apple
    function playAppleBeep(type = 'start') {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            if (type === 'start') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.12, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.16);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.16);
            } else if (type === 'end') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(659.25, ctx.currentTime);
                osc.frequency.setValueAtTime(523.25, ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.12, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.16);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.16);
            } else if (type === 'incoming') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                osc.frequency.setValueAtTime(880, ctx.currentTime + 0.08);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.22);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.22);
            }
        } catch (_) {}
    }

    document.addEventListener('DOMContentLoaded', async () => {
        await initIntercomPage();

        window.addEventListener('storage', async (e) => {
            if (e.key === 'authToken') await initIntercomPage();
        });
    });

    async function initIntercomPage() {
        const userStr = localStorage.getItem('authUser');
        const token = localStorage.getItem('authToken');
        const authNotice = document.getElementById('authRequiredNotice');
        const mainContent = document.getElementById('intercomMainContent');
        const channelSelector = document.getElementById('kidChannelSelector');
        const kidSelfNotice = document.getElementById('kidSelfChannelNotice');

        if (!token || !userStr) {
            authNotice.style.display = 'block';
            mainContent.style.display = 'none';
            channelSelector.style.display = 'none';
            kidSelfNotice.style.display = 'none';
            return;
        }

        try {
            const user = JSON.parse(userStr);
            const roles = user.roles || [];
            isKidRole = roles.includes('Kid') || roles.includes('kid');

            authNotice.style.display = 'none';
            mainContent.style.display = 'flex';

            if (isKidRole) {
                // Kênh của bé
                channelSelector.style.display = 'none';
                kidSelfNotice.style.display = 'block';
                document.getElementById('kidSelfName').textContent = user.fullName || user.username;
                document.getElementById('lcdChannelName').textContent = 'CH: BA MẸ';

                await loadVoiceMessages(true);
            } else {
                // Kênh của Phụ huynh / Admin
                channelSelector.style.display = 'block';
                kidSelfNotice.style.display = 'none';
                await loadKidsList();
            }

            setupPttControls();

            // Tự động kiểm tra tin nhắn mới mỗi 5 giây
            if (pollInterval) clearInterval(pollInterval);
            pollInterval = setInterval(async () => {
                if (document.visibilityState === 'visible' && !isRecording && !isUploading) {
                    await loadVoiceMessages(false);
                }
            }, 5000);

            setupSignalRListener();

        } catch (e) {
            console.error('Lỗi khởi tạo:', e);
            authNotice.style.display = 'block';
        }
    }

    function setupSignalRListener() {
        if (typeof signalR === 'undefined') return;
        try {
            const hubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/location')
                .withAutomaticReconnect()
                .build();

            hubConnection.on('ReceiveVoiceMessage', (msg) => {
                playAppleBeep('incoming');
                loadVoiceMessages(false);
            });

            hubConnection.on('NewVoiceNotification', () => {
                loadVoiceMessages(false);
            });

            hubConnection.start().catch(() => {});
        } catch (_) {}
    }

    // 1. Tải danh sách bé cho Phụ huynh
    async function loadKidsList() {
        const pillsContainer = document.getElementById('kidSelectorPills');
        try {
            const res = await fetch('/api/kids', { headers: getAuthHeaders() });
            if (res.status === 401) {
                handleAuthExpired();
                return;
            }
            if (!res.ok) throw new Error('Không thể tải danh sách bé');
            kidsList = await res.json();

            if (!kidsList || kidsList.length === 0) {
                pillsContainer.innerHTML = '<span class="text-muted small">Chưa có hồ sơ bé nào</span>';
                document.getElementById('currentChannelLabel').textContent = 'Chưa có bé';
                document.getElementById('lcdChannelName').textContent = 'CHƯA CÓ BÉ';
                return;
            }

            const urlParams = new URLSearchParams(window.location.search);
            const queryKidId = parseInt(urlParams.get('kidId'));

            if (queryKidId && kidsList.some(k => k.id === queryKidId)) {
                currentKidId = queryKidId;
            } else {
                currentKidId = kidsList[0].id;
            }

            renderKidPills();
            await loadVoiceMessages(true);

        } catch (err) {
            console.error(err);
            pillsContainer.innerHTML = '<span class="text-danger small">Lỗi tải danh sách bé</span>';
        }
    }

    // 2. Render nút chọn bé
    function renderKidPills() {
        const pillsContainer = document.getElementById('kidSelectorPills');
        pillsContainer.innerHTML = kidsList.map(k => {
            const isSelected = k.id === currentKidId;
            const activeClass = isSelected ? 'active' : '';
            const avatar = k.avatarUrl || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(k.fullName)}`;
            return `
                <div class="apple-channel-pill ${activeClass}" onclick="switchKidChannel(${k.id})">
                    <img src="${avatar}" class="rounded-circle" style="width: 20px; height: 20px; object-fit: cover;" alt="${k.fullName}" />
                    <span>${k.fullName}</span>
                </div>
            `;
        }).join('');

        const selectedKid = kidsList.find(k => k.id === currentKidId);
        if (selectedKid) {
            document.getElementById('currentChannelLabel').innerHTML = `Đang đàm thoại với: <strong style="color: var(--apple-blue);">${selectedKid.fullName}</strong>`;
            document.getElementById('lcdChannelName').textContent = `CH: ${selectedKid.fullName.toUpperCase().substring(0, 16)}`;
        }
    }

    // 3. Chuyển kênh bé khác
    window.switchKidChannel = async function(kidId) {
        if (currentKidId === kidId) return;
        currentKidId = kidId;
        renderKidPills();
        await loadVoiceMessages(true);
    };

    // 4. Tải tin nhắn giọng nói
    let lastMessageCount = 0;
    async function loadVoiceMessages(showLoading = false) {
        const loadingBox = document.getElementById('feedLoadingBox');
        const emptyBox = document.getElementById('feedEmptyBox');
        const listContainer = document.getElementById('voiceMessagesList');
        const lblCount = document.getElementById('lblMessageCount');

        if (showLoading) {
            loadingBox.style.display = 'block';
            emptyBox.style.display = 'none';
        }

        try {
            const url = (!isKidRole && currentKidId) ? `/api/voicemessages?kidId=${currentKidId}` : '/api/voicemessages';
            const res = await fetch(url, { headers: getAuthHeaders() });
            if (res.status === 401) {
                handleAuthExpired();
                return;
            }
            if (!res.ok) {
                loadingBox.style.display = 'none';
                return;
            }

            const messages = await res.json();
            loadingBox.style.display = 'none';

            if (!messages || messages.length === 0) {
                emptyBox.style.display = 'block';
                listContainer.innerHTML = '';
                lblCount.textContent = '0 tin nhắn';
                lastMessageCount = 0;
                return;
            }

            emptyBox.style.display = 'none';
            lblCount.textContent = `${messages.length} tin nhắn`;

            if (messages.length > lastMessageCount && lastMessageCount > 0) {
                playAppleBeep('incoming');
            }
            lastMessageCount = messages.length;

            renderMessagesFeed(messages);

        } catch (err) {
            console.error('Lỗi tải tin nhắn thoại:', err);
            loadingBox.style.display = 'none';
        }
    }

    // 5. Render danh sách bong bóng tin nhắn Apple
    function renderMessagesFeed(messages) {
        const listContainer = document.getElementById('voiceMessagesList');
        const feedScroll = document.getElementById('voiceFeedContainer');
        const shouldScrollBottom = feedScroll.scrollTop + feedScroll.clientHeight >= feedScroll.scrollHeight - 60;

        listContainer.innerHTML = messages.map(m => {
            const isMe = m.isMe;
            const bubbleAlign = isMe ? 'align-self-end' : 'align-self-start';
            const bubbleClass = isMe ? 'apple-bubble-me' : 'apple-bubble-other';
            const roleBadge = m.senderRole === 'Kid' ? '<span class="badge bg-light text-dark ms-1">Bé</span>' : '<span class="badge" style="background: rgba(0, 113, 227, 0.15); color: var(--apple-blue);">Ba Mẹ</span>';
            const unreadBadge = (!isMe && !m.isHeard) ? '<span class="badge bg-danger ms-1">MỚI</span>' : '';

            return `
            <div class="${bubbleAlign} d-flex gap-2" style="max-width: 82%;">
                ${!isMe ? `<img src="${m.senderAvatarUrl}" class="rounded-circle border" style="width: 34px; height: 34px; object-fit: cover;" alt="${m.senderName}" />` : ''}
                
                <div class="p-3 shadow-sm ${bubbleClass}" style="min-width: 220px;">
                    <div class="d-flex justify-content-between align-items-center mb-2 small" style="font-size: 11px;">
                        <span class="fw-semibold">${m.senderName} ${roleBadge} ${unreadBadge}</span>
                        <span class="opacity-75">${m.createdAtVn}</span>
                    </div>

                    <!-- Apple Audio Player Pill -->
                    <div class="d-flex align-items-center gap-2 apple-audio-player-pill">
                        <button type="button" class="btn btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center" 
                                style="width: 32px; height: 32px; background: ${isMe ? '#ffffff' : 'var(--apple-blue)'}; color: ${isMe ? 'var(--apple-blue)' : '#ffffff'}; border: none;"
                                onclick="playVoiceAudio(${m.id}, '${m.audioUrl}', this)">
                            <i class="bi bi-play-fill fs-5" style="margin-left: 2px;"></i>
                        </button>
                        
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-1 mb-1" style="height: 12px;">
                                <div style="width: 3px; height: 4px; background: currentColor; border-radius: 2px;"></div>
                                <div style="width: 3px; height: 8px; background: currentColor; border-radius: 2px;"></div>
                                <div style="width: 3px; height: 12px; background: currentColor; border-radius: 2px;"></div>
                                <div style="width: 3px; height: 10px; background: currentColor; border-radius: 2px;"></div>
                                <div style="width: 3px; height: 6px; background: currentColor; border-radius: 2px;"></div>
                                <div style="width: 3px; height: 11px; background: currentColor; border-radius: 2px;"></div>
                                <div style="width: 3px; height: 7px; background: currentColor; border-radius: 2px;"></div>
                            </div>
                            <div class="d-flex justify-content-between small opacity-75" style="font-size: 10px;">
                                <span>00:${String(m.durationSeconds).padStart(2, '0')}</span>
                                <span>Ghi âm</span>
                            </div>
                        </div>

                        ${isMe || !isKidRole ? `
                        <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1 opacity-75" onclick="deleteVoiceMessage(${m.id})" title="Xóa tin nhắn">
                            <i class="bi bi-trash3"></i>
                        </button>` : ''}
                    </div>
                </div>

                ${isMe ? `<img src="${m.senderAvatarUrl}" class="rounded-circle border" style="width: 34px; height: 34px; object-fit: cover;" alt="${m.senderName}" />` : ''}
            </div>
            `;
        }).join('');

        if (shouldScrollBottom) {
            feedScroll.scrollTop = feedScroll.scrollHeight;
        }
    }

    // 6. Phát file âm thanh
    window.playVoiceAudio = function(msgId, audioUrl, btn) {
        if (currentlyPlayingAudio) {
            currentlyPlayingAudio.pause();
            currentlyPlayingAudio = null;
            document.querySelectorAll('#voiceMessagesList .bi-pause-fill').forEach(icon => {
                icon.className = 'bi bi-play-fill fs-5';
            });
        }

        const icon = btn.querySelector('i');
        const audio = new Audio(audioUrl);
        currentlyPlayingAudio = audio;
        icon.className = 'bi bi-pause-fill fs-5';

        // Đánh dấu đã nghe
        fetch(`/api/voicemessages/${msgId}/mark-heard`, {
            method: 'PUT',
            headers: getAuthHeaders()
        }).catch(() => {});

        audio.play().catch(e => {
            console.error('Audio play error:', e);
            icon.className = 'bi bi-play-fill fs-5';
            currentlyPlayingAudio = null;
            alert('Không thể phát file âm thanh này.');
        });

        audio.onended = () => {
            icon.className = 'bi bi-play-fill fs-5';
            currentlyPlayingAudio = null;
        };

        audio.onerror = () => {
            icon.className = 'bi bi-play-fill fs-5';
            currentlyPlayingAudio = null;
            alert('Lỗi định dạng file âm thanh.');
        };
    };

    // 7. Xóa tin nhắn giọng nói
    window.deleteVoiceMessage = async function(id) {
        if (!confirm('Bạn có chắc chắn muốn xóa tin nhắn thoại này?')) return;
        try {
            const res = await fetch(`/api/voicemessages/${id}`, {
                method: 'DELETE',
                headers: getAuthHeaders()
            });
            if (res.ok) {
                await loadVoiceMessages(false);
            }
        } catch (_) {}
    };

    // 8. Điều khiển bộ đàm Push-To-Talk và Tap-to-Talk chuẩn Apple
    function setupPttControls() {
        const btnPtt = document.getElementById('btnPtt');
        const btnCancel = document.getElementById('btnCancelRecord');
        const btnSend = document.getElementById('btnSendRecord');

        // Bấm để bắt đầu hoặc bấm để gửi
        btnPtt.addEventListener('click', async (e) => {
            e.preventDefault();
            if (isStarting || isUploading) return;

            if (!isRecording) {
                await startRecording();
            } else {
                await stopAndSendRecording();
            }
        });

        // Giữ để nói (Push-To-Talk)
        btnPtt.addEventListener('pointerdown', (e) => {
            pointerPressStartTime = Date.now();
        });

        btnPtt.addEventListener('pointerup', async (e) => {
            const pressDuration = Date.now() - pointerPressStartTime;
            // Nếu người dùng đã nhấn giữ hơn 700ms thì thả tay ra sẽ tự động gửi ngay
            if (isRecording && pressDuration >= 700) {
                await stopAndSendRecording();
            }
        });

        btnCancel.addEventListener('click', cancelRecording);
        btnSend.addEventListener('click', async () => {
            await stopAndSendRecording();
        });
    }

    // Bắt đầu thu âm qua microphone
    async function startRecording() {
        if (isRecording || isStarting || isUploading) return;
        isStarting = true;

        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang mở microphone...';

        try {
            // Yêu cầu quyền truy cập micro
            mediaStream = await navigator.mediaDevices.getUserMedia({
                audio: {
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true
                }
            });

            audioChunks = [];

            // Chọn định dạng MIME tối ưu
            let chosenMime = '';
            if (typeof MediaRecorder !== 'undefined') {
                const mimeCandidates = [
                    'audio/webm;codecs=opus',
                    'audio/webm',
                    'audio/mp4',
                    'audio/aac',
                    'audio/ogg;codecs=opus',
                    'audio/ogg',
                    'audio/wav'
                ];
                for (const m of mimeCandidates) {
                    if (MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(m)) {
                        chosenMime = m;
                        break;
                    }
                }
            }

            const options = chosenMime ? { mimeType: chosenMime } : {};
            mediaRecorder = new MediaRecorder(mediaStream, options);

            mediaRecorder.ondataavailable = (e) => {
                if (e.data && e.data.size > 0) {
                    audioChunks.push(e.data);
                }
            };

            // timeslice 200ms gom chunk đều đặn
            mediaRecorder.start(200);
            isRecording = true;
            recordStartTime = Date.now();
            playAppleBeep('start');

            updatePttUi(true);
            startRecordTimer();
            startVisualizer(mediaStream);

            if (lcdStatus) lcdStatus.textContent = 'Đang ghi âm... Bấm lại hoặc bấm "Gửi ngay" khi nói xong!';

        } catch (err) {
            console.error('Lỗi mở microphone:', err);
            isRecording = false;
            updatePttUi(false);

            if (lcdStatus) lcdStatus.textContent = '❌ Không thể truy cập microphone.';

            if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
                alert('Trình duyệt chưa được cấp quyền Microphone. Vui lòng nhấn vào biểu tượng ổ khóa/cài đặt cạnh thanh địa chỉ web, chọn "Cho phép Microphone" và thử lại!');
            } else if (err.name === 'NotFoundError') {
                alert('Không tìm thấy microphone trên máy. Bạn có thể sử dụng nút "Gửi file âm thanh" bên dưới để gửi tin nhắn thoại!');
            } else {
                alert('Không thể mở microphone: ' + err.message);
            }
        } finally {
            isStarting = false;
        }
    }

    // Dừng và gửi bản ghi âm
    async function stopAndSendRecording() {
        if (!mediaRecorder || !isRecording || isUploading) return;
        isRecording = false;
        isUploading = true;

        clearInterval(recordTimerInterval);
        stopVisualizer();
        playAppleBeep('end');

        const duration = Math.max(1, Math.round((Date.now() - recordStartTime) / 1000));
        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang gửi tin nhắn thoại...';

        // Xả nốt dữ liệu còn trong đệm
        try {
            if (mediaRecorder.state === 'recording') {
                mediaRecorder.requestData();
            }
        } catch (_) {}

        mediaRecorder.onstop = async () => {
            try {
                // Tắt stream micro sau khi kết thúc
                if (mediaStream) {
                    mediaStream.getTracks().forEach(t => t.stop());
                    mediaStream = null;
                }

                const mime = mediaRecorder.mimeType || 'audio/webm';
                const blob = new Blob(audioChunks, { type: mime });

                if (blob.size === 0) {
                    alert('Bản ghi âm quá ngắn hoặc không có tiếng. Vui lòng nói to hơn và thử lại!');
                    updatePttUi(false);
                    return;
                }

                await uploadVoiceMessage(blob, duration, mime);
            } catch (err) {
                console.error('Lỗi xử lý file ghi âm:', err);
                alert('Lỗi: ' + err.message);
            } finally {
                isUploading = false;
                updatePttUi(false);
            }
        };

        try {
            mediaRecorder.stop();
        } catch (e) {
            isUploading = false;
            updatePttUi(false);
        }
    }

    // Hủy ghi âm
    function cancelRecording() {
        isRecording = false;
        isStarting = false;
        isUploading = false;

        clearInterval(recordTimerInterval);
        stopVisualizer();

        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            try { mediaRecorder.stop(); } catch (_) {}
        }
        if (mediaStream) {
            mediaStream.getTracks().forEach(t => t.stop());
            mediaStream = null;
        }
        audioChunks = [];
        updatePttUi(false);

        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) {
            lcdStatus.textContent = 'Đã hủy bản ghi âm.';
            setTimeout(() => {
                lcdStatus.textContent = 'Sẵn sàng đàm thoại. Bấm nút dưới để nói!';
            }, 1500);
        }
    }

    // Gửi file âm thanh lên server
    async function uploadVoiceMessage(blob, duration, mimeType) {
        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang truyền tín hiệu bộ đàm...';

        let ext = 'webm';
        if (mimeType.includes('mp4')) ext = 'mp4';
        else if (mimeType.includes('ogg')) ext = 'ogg';
        else if (mimeType.includes('wav')) ext = 'wav';
        else if (mimeType.includes('aac')) ext = 'aac';
        else if (mimeType.includes('mpeg') || mimeType.includes('mp3')) ext = 'mp3';

        const fileName = `voice_${Date.now()}.${ext}`;
        const formData = new FormData();
        formData.append('audioFile', blob, fileName);
        formData.append('durationSeconds', duration);
        if (!isKidRole && currentKidId) {
            formData.append('kidId', currentKidId);
        }

        try {
            const token = localStorage.getItem('authToken');
            if (!token) {
                handleAuthExpired();
                return;
            }

            const res = await fetch('/api/voicemessages/send', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData
            });

            if (res.status === 401) {
                handleAuthExpired();
                return;
            }

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || 'Lỗi gửi tin nhắn thoại từ máy chủ');
            }

            if (lcdStatus) lcdStatus.textContent = '✅ Đã gửi tin nhắn thoại thành công!';
            await loadVoiceMessages(false);

            setTimeout(() => {
                if (lcdStatus) lcdStatus.textContent = 'Sẵn sàng đàm thoại. Bấm nút dưới để nói!';
            }, 2500);

        } catch (err) {
            console.error('Lỗi upload:', err);
            if (lcdStatus) lcdStatus.textContent = '❌ ' + err.message;
            alert('Lỗi gửi tin nhắn giọng nói: ' + err.message);
        }
    }

    // Xử lý khi phiên đăng nhập hết hạn
    function handleAuthExpired() {
        localStorage.removeItem('authToken');
        localStorage.removeItem('authUser');
        alert('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để tiếp tục đàm thoại.');
        const modal = new bootstrap.Modal(document.getElementById('modalLogin'));
        modal.show();
    }

    // Tùy chọn 1: Người dùng chọn file âm thanh từ máy để gửi
    window.handleAudioFileUpload = async function(input) {
        if (!input.files || input.files.length === 0) return;
        const file = input.files[0];

        if (file.size > 20 * 1024 * 1024) {
            alert('Dung lượng file âm thanh không được vượt quá 20MB.');
            input.value = '';
            return;
        }

        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = `Đang gửi file âm thanh "${file.name}"...`;

        try {
            await uploadVoiceMessage(file, 5, file.type || 'audio/webm');
        } finally {
            input.value = '';
        }
    };

    // Tùy chọn 2: Gửi tin nhắn thoại mẫu kiểm tra bộ đàm
    window.sendTestVoiceMessage = async function() {
        const lcdStatus = document.getElementById('lcdStatusText');
        if (lcdStatus) lcdStatus.textContent = 'Đang tạo âm thanh mẫu và gửi kiểm tra...';

        try {
            // Tạo 1 file WAV mẫu (tiếng beep 440Hz 1 giây) bằng AudioContext Offline
            const sampleRate = 8000;
            const numFrames = sampleRate * 1; // 1s
            const wavBuffer = createSineWaveWav(440, sampleRate, 1);
            const blob = new Blob([wavBuffer], { type: 'audio/wav' });

            await uploadVoiceMessage(blob, 1, 'audio/wav');
        } catch (err) {
            alert('Lỗi gửi tin mẫu: ' + err.message);
        }
    };

    // Tạo WAV PCM 16-bit Mono đơn giản
    function createSineWaveWav(freq, sampleRate, durationSec) {
        const numSamples = sampleRate * durationSec;
        const buffer = new ArrayBuffer(44 + numSamples * 2);
        const view = new DataView(buffer);

        function writeString(offset, str) {
            for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
        }

        writeString(0, 'RIFF');
        view.setUint32(4, 36 + numSamples * 2, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true); // PCM
        view.setUint16(22, 1, true); // Mono
        view.setUint32(24, sampleRate, true);
        view.setUint32(28, sampleRate * 2, true);
        view.setUint16(32, 2, true);
        view.setUint16(34, 16, true);
        writeString(36, 'data');
        view.setUint32(40, numSamples * 2, true);

        for (let i = 0; i < numSamples; i++) {
            const t = i / sampleRate;
            const sample = Math.sin(2 * Math.PI * freq * t) * 0.4 * 32767;
            view.setInt16(44 + i * 2, sample, true);
        }
        return buffer;
    }

    function updatePttUi(recording) {
        const btn = document.getElementById('btnPtt');
        const icon = document.getElementById('btnPttIcon');
        const text = document.getElementById('btnPttText');
        const led = document.getElementById('badgeLedStatus');
        const recBadge = document.getElementById('lcdRecIndicator');
        const actionBox = document.getElementById('boxRecordingActions');

        if (recording) {
            btn.classList.add('recording');
            icon.className = 'bi bi-stop-fill fs-1 mb-1';
            text.textContent = 'BẤM ĐỂ GỬI';

            led.style.background = '#fee2e2';
            led.style.color = '#dc2626';
            led.textContent = '● ĐANG GHI ÂM';
            recBadge.style.display = 'inline';
            actionBox.style.setProperty('display', 'flex', 'important');
        } else {
            btn.classList.remove('recording');
            icon.className = 'bi bi-mic-fill fs-1 mb-1';
            text.textContent = 'BẤM ĐỂ NÓI';

            led.style.background = 'var(--apple-blue-soft)';
            led.style.color = 'var(--apple-blue)';
            led.textContent = '● SẴN SÀNG';
            recBadge.style.display = 'none';
            actionBox.style.setProperty('display', 'none', 'important');
            document.getElementById('lcdTimer').textContent = '00:00';
        }
    }

    function startRecordTimer() {
        const timerEl = document.getElementById('lcdTimer');
        recordTimerInterval = setInterval(() => {
            const elapsed = Math.round((Date.now() - recordStartTime) / 1000);
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            timerEl.textContent = `${mins}:${secs}`;

            // Tự động dừng sau 60s
            if (elapsed >= 60) {
                stopAndSendRecording();
            }
        }, 250);
    }

    function startVisualizer(stream) {
        try {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const source = audioContext.createMediaStreamSource(stream);
            analyserNode = audioContext.createAnalyser();
            analyserNode.fftSize = 32;
            source.connect(analyserNode);

            const bufferLength = analyserNode.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            const bars = document.querySelectorAll('#lcdWaveform div');

            function updateBars() {
                if (!isRecording) return;
                analyserNode.getByteFrequencyData(dataArray);

                bars.forEach((bar, idx) => {
                    const val = dataArray[idx % bufferLength] || 10;
                    const h = Math.max(4, Math.round((val / 255) * 24));
                    bar.style.height = `${h}px`;
                });

                visualizerAnimation = requestAnimationFrame(updateBars);
            }
            updateBars();
        } catch (_) {}
    }

    function stopVisualizer() {
        if (visualizerAnimation) cancelAnimationFrame(visualizerAnimation);
        if (audioContext) {
            audioContext.close().catch(() => {});
            audioContext = null;
        }
        document.querySelectorAll('#lcdWaveform div').forEach((bar, idx) => {
            bar.style.height = `${(idx % 4 + 1) * 5}px`;
        });
    }
</script>
}
