@{
    ViewData["Title"] = "Bộ Đàm Gia Đình 8-Bit - Đàm Thoại Giọng Nói";
}

<div class="container py-4">
    <!-- Header banner (8-Bit Walkie-Talkie Console) -->
    <div class="apple-card-static p-4 mb-4 border-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <i class="pixelart-icons-font-radio i8-xl text-primary i8-bounce"></i>
                    <h2 class="fw-bold mb-0 text-primary pixel-font" style="letter-spacing: 0.04em;">
                        BỘ ĐÀM GIA ĐÌNH 8-BIT
                    </h2>
                    <span class="badge bg-danger text-white pixel-font">LIVE VOICE INTERCOM</span>
                </div>
                <p class="text-muted mb-0 small">
                    Trò chuyện và gửi tin nhắn thoại tức thì giữa Phụ huynh và Bé. Giữ hoặc bấm để nói như một chiếc bộ đàm arcade thực thụ!
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <a href="/kids" class="btn btn-outline-secondary px-3 small">
                    <i class="pixelart-icons-font-users i8-xs me-1"></i> Quản Lý Bé
                </a>
                <a href="/screentime" class="btn btn-outline-primary px-3 small">
                    <i class="pixelart-icons-font-clock i8-xs me-1"></i> Giờ Dùng Máy
                </a>
            </div>
        </div>
    </div>

    <!-- Alert placeholder -->
    <div id="pageAlert"></div>

    <!-- Thông báo khi chưa đăng nhập -->
    <div id="authRequiredNotice" class="alert alert-warning py-3 px-4 rounded-3 d-flex flex-wrap align-items-center justify-content-between mb-4 shadow-sm" style="display: none;">
        <div class="d-flex align-items-center gap-2 mb-2 mb-sm-0">
            <i class="pixelart-icons-font-alert i8-sm text-warning"></i>
            <span>Bạn chưa đăng nhập. Vui lòng đăng nhập để đàm thoại giọng nói với gia đình.</span>
        </div>
        <button class="btn btn-warning btn-sm fw-bold pixel-font" data-bs-toggle="modal" data-bs-target="#modalLogin">
            <i class="pixelart-icons-font-user i8-xs me-1"></i> Đăng Nhập Ngay
        </button>
    </div>

    <!-- KHỐI CHỌN BÉ / KÊNH ĐÀM THOẠI (DÀNH CHO PHỤ HUYNH) -->
    <div class="apple-card-static p-3 mb-4" id="kidChannelSelector">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold text-secondary small d-flex align-items-center gap-1 pixel-font">
                    <i class="pixelart-icons-font-user i8-xs text-primary"></i> KÊNH ĐÀM THOẠI:
                </span>
                <div id="kidSelectorPills" class="d-flex flex-wrap gap-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            </div>
            <div class="text-muted small" id="currentChannelLabel" style="font-size: 12px;">
                Đang kết nối tần số...
            </div>
        </div>
    </div>

    <!-- KHỐI KÊNH BÉ (KHI TÀI KHOẢN CON ĐĂNG NHẬP) -->
    <div class="alert alert-info py-3 px-4 rounded-3 d-flex flex-wrap align-items-center justify-content-between mb-4 shadow-sm" id="kidSelfChannelNotice" style="display: none;">
        <div class="d-flex align-items-center gap-2">
            <i class="pixelart-icons-font-gamepad i8-sm text-primary"></i>
            <span>Kênh kết nối trực tiếp với <strong>Ba Mẹ</strong> của bé <strong id="kidSelfName">...</strong></span>
        </div>
        <span class="badge bg-primary text-white pixel-font">BỘ ĐÀM CỦA BÉ</span>
    </div>

    <!-- GIAO DIỆN CHÍNH: 2 CỘT -->
    <div class="row g-4" id="intercomMainContent" style="display: none;">
        
        <!-- CỘT TRÁI: DÒNG THỜI GIAN TIN NHẮN THOẠI (VOICE CONVERSATION FEED) -->
        <div class="col-lg-7">
            <div class="apple-card p-4 border-2 h-100 d-flex flex-column" style="min-height: 520px;">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="pixelart-icons-font-message i8-md text-primary"></i>
                        <h5 class="fw-bold mb-0 pixel-font">HỘP THƯ BỘ ĐÀM</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary-subtle text-secondary small" id="lblMessageCount">0 tin nhắn</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" onclick="loadVoiceMessages(true)" title="Làm mới tin nhắn">
                            <i class="pixelart-icons-font-reload i8-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Danh sách tin nhắn giọng nói cuộn mượt -->
                <div id="voiceFeedContainer" class="flex-grow-1 overflow-auto pe-2 d-flex flex-column gap-3" style="max-height: 520px; min-height: 380px;">
                    <!-- Loading spinner -->
                    <div id="feedLoadingBox" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="small text-muted mt-2">Đang tải tin nhắn thoại...</div>
                    </div>
                    <!-- Empty state -->
                    <div id="feedEmptyBox" class="text-center py-5 my-auto" style="display: none;">
                        <div style="font-size: 48px;">📻</div>
                        <h6 class="fw-bold mt-2 pixel-font">Chưa có tin nhắn thoại nào</h6>
                        <p class="text-muted small mb-0">Hãy bấm nút bộ đàm bên phải để nói và gửi tin nhắn giọng nói đầu tiên nhé!</p>
                    </div>
                    <!-- Message bubbles injected here -->
                    <div id="voiceMessagesList" class="d-flex flex-column gap-3"></div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: MÁY BỘ ĐÀM PUSH-TO-TALK ARCADE CONSOLE -->
        <div class="col-lg-5">
            <div class="apple-card p-4 border-2 h-100 d-flex flex-column justify-content-between shadow-sm" style="background: radial-gradient(circle at center, #1e1b4b 0%, #09090b 100%); color: #fff; border-color: var(--pixel-gold);">
                
                <div>
                    <!-- Đầu máy bộ đàm: Ăng-ten & Đèn LED trạng thái -->
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-50">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-1 rounded-1 bg-dark border border-secondary" style="width: 14px; height: 26px;"></div>
                            <span class="pixel-font small fw-bold text-warning" style="font-size: 11px;">WALKIE-TALKIE MK-8</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small" style="font-size: 11px;">Tín hiệu:</span>
                            <span class="badge bg-success text-white pixel-font" id="badgeLedStatus">
                                ● SẴN SÀNG
                            </span>
                        </div>
                    </div>

                    <!-- Màn hình LCD Retro Pixel (Green/Amber CRT Screen) -->
                    <div class="p-3 rounded-3 mb-4 border border-2 text-center" id="lcdScreen" style="background-color: #022c22; border-color: #10b981; color: #34d399; font-family: monospace;">
                        <div class="d-flex justify-content-between align-items-center mb-1 small" style="font-size: 11px; opacity: 0.85;">
                            <span id="lcdChannelName">CH 01: GIA ĐÌNH</span>
                            <span id="lcdRecIndicator" style="display: none;" class="text-danger fw-bold i8-pulse">● REC</span>
                        </div>

                        <!-- Đồng hồ đếm thời gian ghi âm -->
                        <div class="display-4 fw-bold pixel-font my-2" id="lcdTimer" style="letter-spacing: 2px;">
                            00:00
                        </div>

                        <!-- Visualizer thanh sóng âm thanh pixel -->
                        <div class="d-flex justify-content-center align-items-end gap-1 mb-2" id="lcdWaveform" style="height: 28px;">
                            <div class="bg-success rounded-1" style="width: 5px; height: 6px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 10px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 16px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 22px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 28px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 18px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 12px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 8px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 14px; transition: height 0.1s;"></div>
                            <div class="bg-success rounded-1" style="width: 5px; height: 20px; transition: height 0.1s;"></div>
                        </div>

                        <div class="small fw-semibold" id="lcdStatusText" style="font-size: 11px; opacity: 0.9;">
                            Sẵn sàng đàm thoại. Bấm nút dưới để nói!
                        </div>
                    </div>
                </div>

                <!-- KHU VỰC ĐIỀU KHIỂN BỘ ĐÀM (ARCADE PUSH-TO-TALK BUTTONS) -->
                <div>
                    <!-- Nút Push-To-Talk to đùng -->
                    <div class="text-center mb-3">
                        <button type="button" class="btn btn-warning rounded-circle shadow-lg d-inline-flex flex-column align-items-center justify-content-center p-0 border border-4 border-light border-opacity-75" id="btnPtt" style="width: 140px; height: 140px; transition: all 0.2s ease;">
                            <i class="pixelart-icons-font-microphone i8-xl text-dark mb-1" id="btnPttIcon" style="font-size: 38px;"></i>
                            <span class="pixel-font fw-bold text-dark small" id="btnPttText" style="font-size: 12px;">BẤM ĐỂ NÓI</span>
                        </button>
                    </div>

                    <!-- Các nút phụ trợ: Hủy / Nghe lại -->
                    <div class="d-flex justify-content-center gap-2 mb-2" id="boxRecordingActions" style="display: none !important;">
                        <button type="button" class="btn btn-outline-danger btn-sm px-3 pixel-font" id="btnCancelRecord">
                            <i class="pixelart-icons-font-close i8-xs me-1"></i> Hủy
                        </button>
                        <button type="button" class="btn btn-success btn-sm px-3 pixel-font" id="btnSendRecord">
                            <i class="pixelart-icons-font-check i8-xs me-1"></i> Gửi Ngay
                        </button>
                    </div>

                    <div class="text-center small text-muted" style="font-size: 11px;">
                        💡 <em>Mẹo: Bấm 1 lần để bắt đầu nói, bấm lần nữa để gửi ngay. Hoặc giữ chuột/chạm để nói!</em>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    let currentKidId = null;
    let kidsList = [];
    let isKidRole = false;
    let mediaRecorder = null;
    let audioChunks = [];
    let recordStartTime = null;
    let recordTimerInterval = null;
    let audioContext = null;
    let analyserNode = null;
    let visualizerAnimation = null;
    let pollInterval = null;
    let currentlyPlayingAudio = null;

    function getAuthHeaders() {
        const token = localStorage.getItem('authToken');
        return {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': `Bearer ${token}` } : {})
        };
    }

    // Âm thanh 8-bit retro thuần bằng Web Audio API
    function playRetroBeep(type = 'start') {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            if (type === 'start') {
                // Tiếng chíp chíp bắt đầu bộ đàm
                osc.type = 'square';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                osc.frequency.setValueAtTime(880, ctx.currentTime + 0.08); // A5
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.16);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.16);
            } else if (type === 'end') {
                // Tiếng roẹt kết thúc
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(440, ctx.currentTime);
                osc.frequency.setValueAtTime(220, ctx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.18);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.18);
            } else if (type === 'incoming') {
                // Tiếng chuông nhận tin nhắn mới
                osc.type = 'sine';
                osc.frequency.setValueAtTime(659.25, ctx.currentTime); // E5
                osc.frequency.setValueAtTime(1046.5, ctx.currentTime + 0.1); // C6
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.25);
            }
        } catch (_) {}
    }

    document.addEventListener('DOMContentLoaded', async () => {
        await initIntercomPage();
    });

    async function initIntercomPage() {
        const userStr = localStorage.getItem('authUser');
        const token = localStorage.getItem('authToken');
        const authNotice = document.getElementById('authRequiredNotice');
        const mainContent = document.getElementById('intercomMainContent');
        const channelSelector = document.getElementById('kidChannelSelector');
        const kidSelfNotice = document.getElementById('kidSelfChannelNotice');

        if (!token || !userStr) {
            authNotice.style.display = 'flex';
            mainContent.style.display = 'none';
            channelSelector.style.display = 'none';
            return;
        }

        try {
            const user = JSON.parse(userStr);
            const roles = user.roles || [];
            isKidRole = roles.includes('Kid') || roles.includes('kid');

            authNotice.style.display = 'none';
            mainContent.style.display = 'flex';

            if (isKidRole) {
                // Tài khoản con
                channelSelector.style.display = 'none';
                kidSelfNotice.style.display = 'flex';
                document.getElementById('kidSelfName').textContent = user.fullName || user.username;
                document.getElementById('lcdChannelName').textContent = 'CH 01: BA MẸ';

                await loadVoiceMessages();
            } else {
                // Tài khoản Phụ huynh
                channelSelector.style.display = 'block';
                kidSelfNotice.style.display = 'none';
                await loadKidsList();
            }

            // Thiết lập sự kiện nút Push-To-Talk
            setupPttControls();

            // Tự động kiểm tra tin nhắn mới mỗi 5 giây
            if (pollInterval) clearInterval(pollInterval);
            pollInterval = setInterval(async () => {
                if (document.visibilityState === 'visible') {
                    await loadVoiceMessages(false);
                }
            }, 5000);

        } catch (e) {
            console.error('Lỗi khởi tạo:', e);
            authNotice.style.display = 'flex';
        }
    }

    // 1. Tải danh sách bé cho Phụ huynh
    async function loadKidsList() {
        const pillsContainer = document.getElementById('kidSelectorPills');
        try {
            const res = await fetch('/api/kids', { headers: getAuthHeaders() });
            if (!res.ok) throw new Error('Không thể tải danh sách bé');
            kidsList = await res.json();

            if (!kidsList || kidsList.length === 0) {
                pillsContainer.innerHTML = '<span class="text-muted small">Chưa có bé nào trong gia đình</span>';
                document.getElementById('currentChannelLabel').textContent = 'Chưa có bé';
                return;
            }

            const urlParams = new URLSearchParams(window.location.search);
            const queryKidId = parseInt(urlParams.get('kidId'));

            if (queryKidId && kidsList.some(k => k.id === queryKidId)) {
                currentKidId = queryKidId;
            } else {
                currentKidId = kidsList[0].id;
            }

            renderKidPills();
            await loadVoiceMessages();

        } catch (err) {
            console.error(err);
            pillsContainer.innerHTML = '<span class="text-danger small">Lỗi kết nối</span>';
        }
    }

    // 2. Render các nút chọn bé
    function renderKidPills() {
        const pillsContainer = document.getElementById('kidSelectorPills');
        pillsContainer.innerHTML = kidsList.map(k => {
            const isSelected = k.id === currentKidId;
            const btnClass = isSelected ? 'btn-primary' : 'btn-outline-secondary';
            const avatar = k.avatarUrl || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(k.fullName)}`;
            return `
                <button type="button" class="btn btn-sm ${btnClass} rounded-2 d-flex align-items-center gap-2 px-3 py-1" onclick="switchKidChannel(${k.id})">
                    <img src="${avatar}" class="rounded-1" style="width: 20px; height: 20px; object-fit: cover;" alt="${k.fullName}" />
                    <span class="fw-semibold">${k.fullName}</span>
                </button>
            `;
        }).join('');

        const selectedKid = kidsList.find(k => k.id === currentKidId);
        if (selectedKid) {
            document.getElementById('currentChannelLabel').innerHTML = `Đang đàm thoại với bé: <strong class="text-primary">${selectedKid.fullName}</strong>`;
            document.getElementById('lcdChannelName').textContent = `CH: ${selectedKid.fullName.toUpperCase().substring(0, 14)}`;
        }
    }

    // 3. Chuyển kênh bé khác
    async function switchKidChannel(kidId) {
        if (currentKidId === kidId) return;
        currentKidId = kidId;
        renderKidPills();
        await loadVoiceMessages(true);
    }

    // 4. Tải danh sách tin nhắn giọng nói
    let lastMessageCount = 0;
    async function loadVoiceMessages(showLoading = false) {
        const loadingBox = document.getElementById('feedLoadingBox');
        const emptyBox = document.getElementById('feedEmptyBox');
        const listContainer = document.getElementById('voiceMessagesList');
        const lblCount = document.getElementById('lblMessageCount');

        if (showLoading) {
            loadingBox.style.display = 'block';
            emptyBox.style.display = 'none';
        }

        try {
            const url = (!isKidRole && currentKidId) ? `/api/voicemessages?kidId=${currentKidId}` : '/api/voicemessages';
            const res = await fetch(url, { headers: getAuthHeaders() });
            if (!res.ok) return;

            const messages = await res.json();
            loadingBox.style.display = 'none';

            if (!messages || messages.length === 0) {
                emptyBox.style.display = 'block';
                listContainer.innerHTML = '';
                lblCount.textContent = '0 tin nhắn';
                lastMessageCount = 0;
                return;
            }

            emptyBox.style.display = 'none';
            lblCount.textContent = `${messages.length} tin nhắn`;

            // Nếu có tin nhắn mới so với lần trước -> phát tiếng chime
            if (messages.length > lastMessageCount && lastMessageCount > 0) {
                playRetroBeep('incoming');
            }
            lastMessageCount = messages.length;

            renderMessagesFeed(messages);

        } catch (err) {
            console.error('Lỗi tải tin nhắn thoại:', err);
            loadingBox.style.display = 'none';
        }
    }

    // 5. Render bong bóng tin nhắn thoại retro 8-bit
    function renderMessagesFeed(messages) {
        const listContainer = document.getElementById('voiceMessagesList');
        const feedScroll = document.getElementById('voiceFeedContainer');
        const shouldScrollBottom = feedScroll.scrollTop + feedScroll.clientHeight >= feedScroll.scrollHeight - 60;

        listContainer.innerHTML = messages.map(m => {
            const isMe = m.isMe;
            const bubbleAlign = isMe ? 'align-self-end' : 'align-self-start';
            const bubbleBg = isMe 
                ? 'background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%); color: #fff; border-color: var(--pixel-gold);'
                : 'background: linear-gradient(135deg, #1f2937 0%, #111827 100%); color: #fff; border-color: var(--pixel-cyan);';
            const roleBadge = m.senderRole === 'Kid' ? '<span class="badge bg-warning text-dark ms-1">Bé</span>' : '<span class="badge bg-primary text-white ms-1">Ba Mẹ</span>';
            const unreadBadge = (!isMe && !m.isHeard) ? '<span class="badge bg-danger ms-1 i8-pulse">MỚI</span>' : '';

            return `
            <div class="${bubbleAlign} d-flex gap-2 max-w-85" style="max-width: 85%;">
                ${!isMe ? `<img src="${m.senderAvatarUrl}" class="rounded-2 border border-2 border-primary" style="width: 36px; height: 36px; object-fit: cover;" alt="${m.senderName}" />` : ''}
                
                <div class="p-3 rounded-3 border-2 shadow-sm" style="${bubbleBg} min-width: 240px;">
                    <div class="d-flex justify-content-between align-items-center mb-2 small" style="font-size: 11px;">
                        <span class="fw-bold">${m.senderName} ${roleBadge} ${unreadBadge}</span>
                        <span class="opacity-75">${m.createdAtVn}</span>
                    </div>

                    <!-- Audio Player 8-Bit Retro -->
                    <div class="d-flex align-items-center gap-2 p-2 rounded-2 bg-black bg-opacity-40 border border-secondary border-opacity-50">
                        <button type="button" class="btn btn-sm btn-warning rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" onclick="playVoiceAudio(${m.id}, '${m.audioUrl}', this)">
                            <i class="pixelart-icons-font-play i8-xs text-dark" style="margin-left: 2px;"></i>
                        </button>
                        
                        <!-- Visualizer tĩnh & thời lượng -->
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-end gap-1 mb-1 visualizer-bars" style="height: 14px;">
                                <div class="bg-warning rounded-1" style="width: 3px; height: 4px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 8px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 12px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 14px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 10px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 6px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 12px;"></div>
                                <div class="bg-warning rounded-1" style="width: 3px; height: 8px;"></div>
                            </div>
                            <div class="d-flex justify-content-between small opacity-75" style="font-size: 10px;">
                                <span class="audio-time-label">00:${String(m.durationSeconds).padStart(2, '0')}</span>
                                <span>🎙️ Thoại</span>
                            </div>
                        </div>

                        ${isMe || !isKidRole ? `
                        <button type="button" class="btn btn-link btn-sm text-danger p-0 opacity-75" onclick="deleteVoiceMessage(${m.id})" title="Xóa tin nhắn thoại">
                            <i class="pixelart-icons-font-trash i8-xs"></i>
                        </button>` : ''}
                    </div>
                </div>

                ${isMe ? `<img src="${m.senderAvatarUrl}" class="rounded-2 border border-2 border-warning" style="width: 36px; height: 36px; object-fit: cover;" alt="${m.senderName}" />` : ''}
            </div>
            `;
        }).join('');

        if (shouldScrollBottom) {
            feedScroll.scrollTop = feedScroll.scrollHeight;
        }
    }

    // 6. Phát file âm thanh giọng nói
    window.playVoiceAudio = function(msgId, audioUrl, btn) {
        if (currentlyPlayingAudio) {
            currentlyPlayingAudio.pause();
            currentlyPlayingAudio = null;
            document.querySelectorAll('#voiceMessagesList .btn-warning i').forEach(i => i.className = 'pixelart-icons-font-play i8-xs text-dark');
        }

        const audio = new Audio(audioUrl);
        currentlyPlayingAudio = audio;
        const icon = btn.querySelector('i');
        icon.className = 'pixelart-icons-font-pause i8-xs text-dark';

        // Đánh dấu đã nghe
        fetch(`/api/voicemessages/${msgId}/mark-heard`, {
            method: 'PUT',
            headers: getAuthHeaders()
        });

        audio.play();
        audio.onended = () => {
            icon.className = 'pixelart-icons-font-play i8-xs text-dark';
            currentlyPlayingAudio = null;
        };
        audio.onerror = () => {
            icon.className = 'pixelart-icons-font-play i8-xs text-dark';
            currentlyPlayingAudio = null;
            alert('Không thể phát file âm thanh này.');
        };
    };

    // 7. Xóa tin nhắn giọng nói
    window.deleteVoiceMessage = async function(id) {
        if (!confirm('Bạn có chắc chắn muốn xóa tin nhắn thoại này?')) return;
        try {
            const res = await fetch(`/api/voicemessages/${id}`, {
                method: 'DELETE',
                headers: getAuthHeaders()
            });
            if (res.ok) {
                await loadVoiceMessages(false);
            }
        } catch (_) {}
    };

    // 8. Thiết lập điều khiển bộ đàm Push-To-Talk
    let isRecording = false;

    function setupPttControls() {
        const btnPtt = document.getElementById('btnPtt');
        const btnCancel = document.getElementById('btnCancelRecord');
        const btnSend = document.getElementById('btnSendRecord');

        // Bấm 1 lần để thu / Bấm lần 2 để gửi
        btnPtt.addEventListener('click', async () => {
            if (!isRecording) {
                await startRecording();
            } else {
                await stopAndSendRecording();
            }
        });

        btnCancel.addEventListener('click', () => {
            cancelRecording();
        });

        btnSend.addEventListener('click', async () => {
            await stopAndSendRecording();
        });
    }

    // Bắt đầu ghi âm qua microphone
    async function startRecording() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            alert('Trình duyệt của bạn không hỗ trợ thu âm microphone.');
            return;
        }

        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            audioChunks = [];
            
            // Chọn mimeType phù hợp
            let mimeType = 'audio/webm';
            if (MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) {
                mimeType = 'audio/webm;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/ogg;codecs=opus')) {
                mimeType = 'audio/ogg;codecs=opus';
            } else if (MediaRecorder.isTypeSupported('audio/mp4')) {
                mimeType = 'audio/mp4';
            }

            mediaRecorder = new MediaRecorder(stream, { mimeType });
            mediaRecorder.ondataavailable = (e) => {
                if (e.data && e.data.size > 0) audioChunks.push(e.data);
            };

            mediaRecorder.start(250);
            isRecording = true;
            recordStartTime = Date.now();
            playRetroBeep('start');

            // Cập nhật giao diện đang ghi âm
            updatePttUi(true);

            // Bắt đầu đếm giây và visualizer
            startRecordTimer();
            startVisualizer(stream);

        } catch (err) {
            console.error('Lỗi microphone:', err);
            alert('Vui lòng cấp quyền truy cập Microphone cho trình duyệt để sử dụng bộ đàm!');
        }
    }

    // Dừng và gửi tin nhắn ghi âm
    async function stopAndSendRecording() {
        if (!mediaRecorder || !isRecording) return;

        playRetroBeep('end');
        isRecording = false;
        clearInterval(recordTimerInterval);
        stopVisualizer();

        const duration = Math.max(1, Math.round((Date.now() - recordStartTime) / 1000));

        mediaRecorder.onstop = async () => {
            const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
            await uploadVoiceMessage(blob, duration);
            updatePttUi(false);
        };

        mediaRecorder.stop();
        mediaRecorder.stream.getTracks().forEach(track => track.stop());
    }

    // Hủy bản ghi âm
    function cancelRecording() {
        if (mediaRecorder && isRecording) {
            isRecording = false;
            clearInterval(recordTimerInterval);
            stopVisualizer();
            mediaRecorder.stop();
            mediaRecorder.stream.getTracks().forEach(track => track.stop());
        }
        audioChunks = [];
        updatePttUi(false);
    }

    // Gửi file âm thanh lên server
    async function uploadVoiceMessage(blob, duration) {
        const lcdStatus = document.getElementById('lcdStatusText');
        lcdStatus.textContent = 'Đang truyền tín hiệu bộ đàm...';

        const formData = new FormData();
        formData.append('audioFile', blob, 'voice_message.webm');
        formData.append('durationSeconds', duration);
        if (!isKidRole && currentKidId) {
            formData.append('kidId', currentKidId);
        }

        try {
            const token = localStorage.getItem('authToken');
            const res = await fetch('/api/voicemessages/send', {
                method: 'POST',
                headers: token ? { 'Authorization': `Bearer ${token}` } : {},
                body: formData
            });

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || 'Lỗi gửi tin nhắn thoại');
            }

            lcdStatus.textContent = '✅ Đã gửi tín hiệu thành công!';
            await loadVoiceMessages(false);

            setTimeout(() => {
                lcdStatus.textContent = 'Sẵn sàng đàm thoại. Bấm nút dưới để nói!';
            }, 2500);

        } catch (err) {
            console.error(err);
            lcdStatus.textContent = '❌ Lỗi gửi tin: ' + err.message;
            alert('Lỗi gửi tin nhắn giọng nói: ' + err.message);
        }
    }

    function updatePttUi(recording) {
        const btn = document.getElementById('btnPtt');
        const icon = document.getElementById('btnPttIcon');
        const text = document.getElementById('btnPttText');
        const led = document.getElementById('badgeLedStatus');
        const recBadge = document.getElementById('lcdRecIndicator');
        const actionBox = document.getElementById('boxRecordingActions');

        if (recording) {
            btn.className = 'btn btn-danger rounded-circle shadow-lg d-inline-flex flex-column align-items-center justify-content-center p-0 border border-4 border-warning i8-pulse';
            btn.style.backgroundColor = '#dc2626';
            icon.className = 'pixelart-icons-font-square i8-xl text-white mb-1';
            text.className = 'pixel-font fw-bold text-white small';
            text.textContent = 'BẤM ĐỂ GỬI';

            led.className = 'badge bg-danger text-white pixel-font i8-pulse';
            led.textContent = '● ĐANG THU ÂM';
            recBadge.style.display = 'inline';
            actionBox.style.setProperty('display', 'flex', 'important');
        } else {
            btn.className = 'btn btn-warning rounded-circle shadow-lg d-inline-flex flex-column align-items-center justify-content-center p-0 border border-4 border-light border-opacity-75';
            btn.style.backgroundColor = '';
            icon.className = 'pixelart-icons-font-microphone i8-xl text-dark mb-1';
            text.className = 'pixel-font fw-bold text-dark small';
            text.textContent = 'BẤM ĐỂ NÓI';

            led.className = 'badge bg-success text-white pixel-font';
            led.textContent = '● SẴN SÀNG';
            recBadge.style.display = 'none';
            actionBox.style.setProperty('display', 'none', 'important');
            document.getElementById('lcdTimer').textContent = '00:00';
        }
    }

    function startRecordTimer() {
        const timerEl = document.getElementById('lcdTimer');
        recordTimerInterval = setInterval(() => {
            const elapsed = Math.round((Date.now() - recordStartTime) / 1000);
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            timerEl.textContent = `${mins}:${secs}`;

            // Tối đa 60 giây tự gửi
            if (elapsed >= 60) {
                stopAndSendRecording();
            }
        }, 500);
    }

    function startVisualizer(stream) {
        try {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const source = audioContext.createMediaStreamSource(stream);
            analyserNode = audioContext.createAnalyser();
            analyserNode.fftSize = 32;
            source.connect(analyserNode);

            const bufferLength = analyserNode.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            const bars = document.querySelectorAll('#lcdWaveform div');

            function updateBars() {
                if (!isRecording) return;
                analyserNode.getByteFrequencyData(dataArray);

                bars.forEach((bar, idx) => {
                    const val = dataArray[idx % bufferLength] || 10;
                    const h = Math.max(4, Math.round((val / 255) * 28));
                    bar.style.height = `${h}px`;
                });

                visualizerAnimation = requestAnimationFrame(updateBars);
            }
            updateBars();
        } catch (_) {}
    }

    function stopVisualizer() {
        if (visualizerAnimation) cancelAnimationFrame(visualizerAnimation);
        if (audioContext) {
            audioContext.close().catch(() => {});
            audioContext = null;
        }
        document.querySelectorAll('#lcdWaveform div').forEach((bar, idx) => {
            bar.style.height = `${(idx % 4 + 1) * 6}px`;
        });
    }
</script>
}
