    function renderFamilyGroup(data) {
        if (!data || !data.group) {
            if (familyGroupSection) familyGroupSection.style.display = 'none';
            return;
        }
        if (familyGroupSection) familyGroupSection.style.display = 'block';

        const nameEl = document.getElementById('familyGroupName');
        if (nameEl) nameEl.textContent = data.group.name || 'Nhóm Gia Đình';

        const members = data.members || [];
        const countEl = document.getElementById('familyMemberCount');
        if (countEl) countEl.textContent = `${members.length} thành viên`;

        const pillsBox = document.getElementById('familyMembersPills');
        if (!pillsBox) return;

        const isCurrentOwner = currentUser && (currentUser.id === data.group.ownerId);

        pillsBox.innerHTML = members.map(m => {
            const isOwner = m.roleInFamily === 'Owner' || m.userId === data.group.ownerId;
            const isChild = m.roleInFamily === 'Child';
            const badgeClass = isOwner ? 'badge bg-warning text-dark' : (isChild ? 'badge bg-success-subtle text-success border border-success' : 'badge bg-primary-subtle text-primary border border-primary');
            const roleLabel = isOwner ? '👑 Chủ gia đình' : (isChild ? '👶 Bé (Con)' : '👥 Quản lý');
            const displayName = m.fullName || m.username || 'Thành viên';
            const avatar = m.avatarUrl || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(displayName)}`;

            const canDelete = isCurrentOwner && !isOwner;
            const safeName = displayName.replace(/'/g, "\\'");

            return `
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white border shadow-sm">
                <img src="${avatar}" class="rounded-circle" style="width: 24px; height: 24px; object-fit: cover;" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=User'" />
                <div class="d-flex align-items-center gap-1">
                    <span class="fw-semibold small">${displayName}</span>
                    <span class="${badgeClass}" style="font-size: 10px;">${roleLabel}</span>
                </div>
                ${canDelete ? `
                <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 text-decoration-none fw-bold" style="font-size: 14px; line-height: 1;" onclick="removeFamilyMember(${m.id}, '${safeName}')" title="Xóa khỏi gia đình">
                    &times;
                </button>` : ''}
            </div>`;
        }).join('');
    }

