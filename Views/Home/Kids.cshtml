@{
    ViewData["Title"] = "Quản lý Hồ sơ Trẻ em & Tài khoản con";
}

<div class="container py-4">
    <!-- Header banner (8-Bit Retro Header) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 apple-card-static p-4 border-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <i class="pixelart-icons-font-heart i8-xl text-primary i8-bounce"></i>
                <h2 class="fw-bold mb-0 text-primary pixel-font" style="letter-spacing: 0.04em;">
                    QUẢN LÝ HỒ SƠ TRẺ & TÀI KHOẢN CON
                </h2>
                <span class="badge bg-primary text-white">8-BIT KIDCARE</span>
            </div>
            <p class="text-muted mb-0 small">
                Theo dõi thông tin sức khỏe, liên kết hoặc cấp tài khoản con để bé tự đăng nhập xem nhiệm vụ & tích điểm sao.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-light text-muted">
                    <i class="pixelart-icons-font-search i8-xs"></i>
                </span>
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm tên bé hoặc username..." />
            </div>
            <button type="button" class="btn btn-warning fw-bold text-dark pixel-font px-3 shadow-sm" onclick="openFamilyQrModal()">
                <i class="pixelart-icons-font-zap i8-xs me-1"></i> Xin Mã QR (1 Phút)
            </button>
        </div>
    </div>

    <!-- Thông báo khi chưa đăng nhập tài khoản Phụ huynh -->
    <div id="authRequiredNotice" class="alert alert-warning py-3 px-4 rounded-3 d-flex flex-wrap align-items-center justify-content-between mb-4 shadow-sm" style="display: none;">
        <div class="d-flex align-items-center gap-2 mb-2 mb-sm-0">
            <i class="pixelart-icons-font-alert i8-sm text-warning"></i>
            <span>Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản <strong>Phụ huynh</strong> để xem và quản lý danh sách con của bạn.</span>
        </div>
        <button class="btn btn-warning btn-sm fw-bold pixel-font" data-bs-toggle="modal" data-bs-target="#modalLogin">
            <i class="pixelart-icons-font-user i8-xs me-1"></i> Đăng Nhập Ngay
        </button>
    </div>

    <!-- Banner chào mừng riêng khi tài khoản con (Kid) đăng nhập (8-Bit Player Banner) -->
    <div id="kidGreetingBanner" class="p-4 rounded-3 text-white mb-4 d-none apple-card-static border-2" style="background: linear-gradient(135deg, #1e3a8a 0%, #06b6d4 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-white bg-opacity-25 rounded-2">
                    <i class="pixelart-icons-font-gamepad i8-xl text-warning i8-pulse"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1 pixel-font">Xin chào bé <span id="kidGreetingName"></span>!</h3>
                    <p class="mb-0 text-white-50 small">Đây là hồ sơ cá nhân và bảng thành tích của bé. Hãy chăm chỉ rèn luyện và tích thật nhiều sao nhé!</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end bg-dark bg-opacity-25 p-2 px-3 rounded-2 border border-white border-opacity-25">
                    <div class="d-flex align-items-center gap-1 justify-content-end">
                        <i class="pixelart-icons-font-star i8-md text-warning"></i>
                        <span class="fs-4 fw-bold text-warning pixel-font" id="kidGreetingPoints">0 sao</span>
                    </div>
                    <div class="small text-white-50">Thành tích tích lũy</div>
                </div>
                <a href="/activities" class="btn btn-warning px-4 fw-bold text-dark">
                    <i class="pixelart-icons-font-calendar i8-xs me-1"></i> Xem Nhiệm Vụ Hôm Nay
                </a>
            </div>
        </div>
    </div>

    <!-- ================= KHỐI NHÓM GIA ĐÌNH & THÊM THÀNH VIÊN BẰNG EMAIL ================= -->
    <div id="familyGroupSection" class="apple-card-static p-4 mb-4 border-2" style="display: none;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 border-bottom mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <i class="pixelart-icons-font-users i8-md text-primary"></i>
                    <h4 class="fw-bold mb-0 text-primary pixel-font" id="familyGroupName">Nhóm Gia Đình</h4>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-0 ms-1" id="btnOpenRenameFamily" title="Đổi tên nhóm gia đình" style="font-size: 11px;">
                        <i class="pixelart-icons-font-magic-edit i8-xs me-1"></i> Đổi tên
                    </button>
                </div>
                <p class="text-muted small mb-0 mt-1">
                    Chỉ cần nhập email của tài khoản đã đăng ký để thêm vào nhóm gia đình. Cùng nhau theo dõi và quản lý hồ sơ các bé.
                </p>
            </div>
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2" id="familyMemberCount">1 thành viên</span>
            </div>
        </div>

        <!-- Ô nhập Email nhanh & Nút Xin Mã QR 1 phút -->
        <div class="row g-2 align-items-center mb-3">
            <div class="col-lg-6">
                <form id="formQuickAddFamily" class="row g-2 align-items-center m-0 p-0">
                    <div class="col-sm-8">
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">
                                <i class="pixelart-icons-font-mail i8-sm"></i>
                            </span>
                            <input type="email" id="quickFamilyEmail" class="form-control" placeholder="Nhập email tài khoản con/thành viên..." required />
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-primary w-100 fw-semibold px-2" id="btnSubmitQuickAdd">
                            <i class="pixelart-icons-font-plus i8-xs me-1"></i> Thêm Email
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-lg-6 d-flex gap-2 justify-content-lg-end flex-wrap">
                <button type="button" class="btn btn-warning fw-bold text-dark pixel-font px-3 shadow-sm" id="btnOpenQrModal" onclick="openFamilyQrModal()">
                    <i class="pixelart-icons-font-zap i8-xs me-1"></i> Xin Mã QR (1 Phút)
                </button>
                <button type="button" class="btn btn-outline-primary fw-semibold px-3" id="btnOpenScanQrModal" onclick="openScanModal()">
                    <i class="pixelart-icons-font-camera i8-xs me-1"></i> Quét / Nhập QR
                </button>
            </div>
        </div>
        <div id="quickAddAlert"></div>

        <!-- Danh sách thành viên gia đình (Member pills) -->
        <div class="mt-2">
            <div class="small fw-semibold text-muted mb-2 d-flex align-items-center gap-1">
                <i class="pixelart-icons-font-users i8-xs text-primary"></i>
                <span>Thành viên trong nhóm gia đình:</span>
            </div>
            <div id="familyMembersPills" class="d-flex flex-wrap gap-2 align-items-center">
                <!-- Render bằng JS -->
            </div>
        </div>
    </div>

    <!-- Quick Stats Bar (Dành cho Phụ huynh / Admin) -->
    <div id="parentStatsBar" class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="apple-card-static p-3 d-flex align-items-center gap-3">
                <div class="p-3 rounded-2 bg-primary-subtle text-primary border border-primary">
                    <i class="pixelart-icons-font-users i8-lg"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-dark pixel-font" id="statTotalKids">0</div>
                    <div class="small text-muted">Tổng số bé quản lý</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="apple-card-static p-3 d-flex align-items-center gap-3">
                <div class="p-3 rounded-2 bg-success-subtle text-success border border-success">
                    <i class="pixelart-icons-font-lock i8-lg"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-success pixel-font" id="statLinkedKids">0</div>
                    <div class="small text-muted">Đã có tài khoản con riêng</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="apple-card-static p-3 d-flex align-items-center gap-3">
                <div class="p-3 rounded-2 bg-warning-subtle text-warning border border-warning">
                    <i class="pixelart-icons-font-circle-info i8-lg text-dark"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-warning-emphasis pixel-font" id="statUnlinkedKids">0</div>
                    <div class="small text-muted">Chưa liên kết tài khoản con</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert placeholder -->
    <div id="pageAlert"></div>

    <!-- Loading spinner -->
    <div id="loadingBox" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="text-muted mt-2 small">Đang tải danh sách các bé và tài khoản con...</p>
    </div>

    <!-- Kids Grid -->
    <div class="row g-4" id="kidsContainer" style="display: none;"></div>

    <!-- Empty state -->
    <div id="emptyBox" class="text-center py-5 bg-white rounded-4 shadow-sm border border-light my-3" style="display: none;">
        <div style="font-size: 55px;">🎈</div>
        <h5 class="fw-bold mt-2 pixel-font">Chưa có bé nào trong gia đình</h5>
        <p class="text-muted small mb-3">Bé tham gia bằng cách quét mã QR gia đình. Hãy nhấn nút bên dưới để tạo mã QR có hiệu lực 1 phút cho bé quét.</p>
        <button type="button" class="btn btn-warning fw-bold text-dark pixel-font px-4 shadow-sm" onclick="openFamilyQrModal()">
            <i class="pixelart-icons-font-zap i8-xs me-1"></i> Xin Mã QR (1 Phút)
        </button>
    </div>
</div>

<!-- ================= MODAL CHỈNH SỬA BÉ (8-BIT RETRO) ================= -->
<div class="modal fade" id="modalKid" tabindex="-1" aria-labelledby="modalKidLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 550px;">
        <div class="modal-content shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalKidLabel">
                    <i class="pixelart-icons-font-heart i8-md text-primary"></i>
                    <span>Chỉnh Sửa Hồ Sơ Bé</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formKid">
                <input type="hidden" id="kidId" value="" />
                <div class="modal-body">
                    <div id="modalKidAlert"></div>
                    
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small">Họ và tên của bé <span class="text-danger">*</span></label>
                            <input type="text" id="kidFullName" class="form-control" placeholder="Ví dụ: Nguyễn Gia Huy" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Tên ở nhà (Nickname)</label>
                            <input type="text" id="kidNickname" class="form-control" placeholder="Ví dụ: Bé Bơ, Tin Tin" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Ngày sinh</label>
                            <input type="date" id="kidDob" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Giới tính</label>
                            <select id="kidGender" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Trường học / Lớp học</label>
                            <input type="text" id="kidSchool" class="form-control" placeholder="Ví dụ: Mầm non Hoa Mai, Lớp 1A..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Ghi chú sức khỏe & Dị ứng</label>
                            <textarea id="kidHealth" class="form-control" rows="2" placeholder="Dị ứng đậu phộng, hải sản, cần uống thuốc lúc 8h..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Sở thích & Năng khiếu</label>
                            <input type="text" id="kidInterests" class="form-control" placeholder="Vẽ tranh, piano, xếp lego, bơi lội..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Ảnh đại diện</label>
                            <input type="file" id="kidAvatarFile" class="form-control" accept="image/*" />
                            <input type="hidden" id="kidAvatarUrl" value="" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSaveKid">Cập Nhật Hồ Sơ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL QUẢN LÝ / LIÊN KẾT TÀI KHOẢN CON (8-BIT RETRO) ================= -->
<div class="modal fade" id="modalSubAccount" tabindex="-1" aria-labelledby="modalSubAccountLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content shadow-lg overflow-hidden">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="modalSubAccountLabel">
                    <i class="pixelart-icons-font-lock i8-md text-primary"></i>
                    <span>Quản Lý Tài Khoản Con</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="px-3 pt-3">
                <!-- Nav tabs -->
                <ul class="nav nav-pills nav-fill bg-light p-1 rounded-2" id="subAccountTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold small py-2 d-inline-flex align-items-center justify-content-center gap-1" id="tab-link-existing" data-bs-toggle="pill" data-bs-target="#panel-link-existing" type="button" role="tab">
                            <i class="pixelart-icons-font-user i8-xs"></i>
                            <span>Liên kết tài khoản có sẵn</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold small py-2 d-inline-flex align-items-center justify-content-center gap-1" id="tab-create-new" data-bs-toggle="pill" data-bs-target="#panel-create-new" type="button" role="tab">
                            <i class="pixelart-icons-font-plus i8-xs"></i>
                            <span>Tạo tài khoản con mới</span>
                        </button>
                    </li>
                </ul>
            </div>

            <div class="modal-body pt-3">
                <div id="subAccountAlert"></div>
                <input type="hidden" id="subAccountKidId" value="" />

                <div class="tab-content">
                    <!-- TAB 1: LIÊN KẾT TÀI KHOẢN CÓ SẴN -->
                    <div class="tab-pane fade show active" id="panel-link-existing" role="tabpanel">
                        <div class="alert alert-info py-2 small mb-3">
                            📌 Nhập <strong>Tên đăng nhập (Username)</strong> hoặc <strong>Email</strong> của một tài khoản khác trong hệ thống để đưa vào làm tài khoản con của bạn.
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Tìm tài khoản hoặc nhập Username / Email <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" id="linkUserIdentifier" class="form-control" placeholder="Ví dụ: bebo2026 hoặc bebo@gmail.com" />
                                <button class="btn btn-outline-secondary" type="button" id="btnSearchUser">🔍 Tìm</button>
                            </div>
                        </div>

                        <!-- Gợi ý kết quả tìm kiếm tức thì -->
                        <div id="searchUserResults" class="list-group mb-3" style="max-height: 180px; overflow-y: auto; display: none;"></div>

                        <div class="d-grid mt-3">
                            <button type="button" class="btn btn-primary rounded-pill py-2 fw-semibold shadow-sm" id="btnSubmitLinkExisting">
                                Xác Nhận Liên Kết Làm Tài Khoản Con
                            </button>
                        </div>
                    </div>

                    <!-- TAB 2: TẠO TÀI KHOẢN CON MỚI -->
                    <div class="tab-pane fade" id="panel-create-new" role="tabpanel">
                        <div class="alert alert-success py-2 small mb-3">
                            🎉 Cấp ngay một tài khoản mới tinh với Tên đăng nhập và Mật khẩu cho bé yêu. Bé có thể tự đăng nhập để theo dõi bảng sao thưởng và lịch sinh hoạt!
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Tên đăng nhập của bé (Username) <span class="text-danger">*</span></label>
                                <input type="text" id="createSubUsername" class="form-control" placeholder="Ví dụ: be_na_2026" required />
                                <small class="text-muted" style="font-size: 11px;">Viết liền không dấu, dùng để đăng nhập</small>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Mật khẩu đăng nhập cho bé <span class="text-danger">*</span></label>
                                <input type="password" id="createSubPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" minlength="6" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Email (Tùy chọn)</label>
                                <input type="email" id="createSubEmail" class="form-control" placeholder="Để trống nếu bé chưa có email riêng" />
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="button" class="btn btn-success rounded-pill py-2 fw-semibold shadow-sm" id="btnSubmitCreateNewSub">
                                Tạo Tài Khoản & Liên Kết Ngay
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL ĐỔI MẬT KHẨU TÀI KHOẢN CON (8-BIT RETRO) ================= -->
<div class="modal fade" id="modalResetPassword" tabindex="-1" aria-labelledby="modalResetPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalResetPasswordLabel">
                    <i class="pixelart-icons-font-lock i8-md text-warning"></i>
                    <span>Đổi Mật Khẩu Cho Bé</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formResetChildPassword">
                <input type="hidden" id="resetPasswordKidId" value="" />
                <div class="modal-body">
                    <div id="resetPasswordAlert"></div>
                    <p class="text-muted small mb-3">
                        Bạn đang đặt lại mật khẩu cho tài khoản con: <strong class="text-primary" id="resetPasswordUsername"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                            <i class="pixelart-icons-font-lock i8-xs text-primary"></i> Mật khẩu mới (Tối thiểu 6 ký tự) <span class="text-danger">*</span>
                        </label>
                        <input type="password" id="resetNewPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="btnSaveNewPassword">
                        <i class="pixelart-icons-font-check i8-xs me-1"></i> Cập Nhật Mật Khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL XÁC NHẬN THÊM VÀO NHÓM GIA ĐÌNH ================= -->
<div class="modal fade" id="modalConfirmAddFamily" tabindex="-1" aria-labelledby="modalConfirmAddFamilyLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalConfirmAddFamilyLabel">
                    <i class="pixelart-icons-font-users i8-md text-primary"></i>
                    <span>Thêm Vào Nhóm Gia Đình</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="confirmAddAlert"></div>

                <!-- Thông tin user tìm thấy -->
                <div class="p-3 rounded-2 border bg-light mb-3 text-center">
                    <img id="foundUserAvatar" src="" class="rounded-2 border mb-2" style="width: 64px; height: 64px; object-fit: cover;" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=User'" />
