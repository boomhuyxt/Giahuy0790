    window.generateNewQrCode = async function() {
        if (qrTimerInterval) clearInterval(qrTimerInterval);
        if (qrPollingInterval) clearInterval(qrPollingInterval);

        const qrLoadingBox = document.getElementById('qrLoadingBox');
        const qrDisplayBox = document.getElementById('qrDisplayBox');
        const qrExpiredOverlay = document.getElementById('qrExpiredOverlay');
        const qrSuccessBox = document.getElementById('qrSuccessBox');
        const imgEl = document.getElementById('qrImageElement');
        const svgContainer = document.getElementById('qrSvgContainer');

        // Phục hồi HTML khung loading sạch
        qrLoadingBox.innerHTML = `
            <div class="spinner-border text-primary" role="status"></div>
            <div class="small text-muted mt-2 fw-semibold">Đang tạo mã QR bảo mật 60s...</div>
        `;
        qrLoadingBox.style.display = 'block';
        qrDisplayBox.style.display = 'none';
        qrSuccessBox.style.display = 'none';

        // Ẩn triệt để overlay hết hạn (kết hợp class d-none và style)
        if (qrExpiredOverlay) {
            qrExpiredOverlay.classList.add('d-none');
            qrExpiredOverlay.classList.remove('d-flex');
            qrExpiredOverlay.style.display = 'none';
        }

        try {
            const authUser = localStorage.getItem('authUser');
            let uid = null;
            if (authUser) {
                try { uid = JSON.parse(authUser).id; } catch(_) {}
            }

            const res = await fetch('/api/family/generate-qr', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ userId: uid })
            });

            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || 'Không thể tạo mã QR gia đình');
            }
            const data = await res.json();

            currentQrToken = data.token;
            document.getElementById('qrShortCodeText').textContent = data.shortCode || '------';

            // Đảm bảo hiển thị QR Code đa tầng bảo mật (SVG -> Base64 PNG -> Online QR Server Fallback)
            if (data.qrCodeSvg && data.qrCodeSvg.trim() !== '') {
                svgContainer.innerHTML = data.qrCodeSvg;
                const svgTag = svgContainer.querySelector('svg');
                if (svgTag) {
                    svgTag.setAttribute('width', '220');
                    svgTag.setAttribute('height', '220');
                    svgTag.style.width = '220px';
                    svgTag.style.height = '220px';
                    svgTag.style.display = 'block';
                    svgTag.style.margin = '0 auto';
                }
                svgContainer.style.display = 'block';
                imgEl.style.display = 'none';
            } else if (data.qrCodeDataUrl && data.qrCodeDataUrl.trim() !== '') {
                imgEl.src = data.qrCodeDataUrl;
                imgEl.style.display = 'block';
                svgContainer.style.display = 'none';

                // Tự động kích hoạt Fallback nếu trình duyệt không hiển thị được Base64 PNG
                imgEl.onerror = () => {
                    const fallbackUrl = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(data.joinUrl)}`;
                    imgEl.src = fallbackUrl;
                };
            } else {
                // Fallback nếu server không sinh được ảnh
                const fallbackUrl = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(data.joinUrl)}`;
                imgEl.src = fallbackUrl;
                imgEl.style.display = 'block';
                svgContainer.style.display = 'none';
            }

            qrLoadingBox.style.display = 'none';
            qrDisplayBox.style.display = 'block';

            // Khởi động đếm ngược 60 giây (1 phút)
            startQrCountdown(60);

            // Bắt đầu polling lắng nghe khi bé quét thành công
            startQrPolling(data.token);

        } catch (err) {
            console.error('Lỗi khi tạo mã QR:', err);
            qrLoadingBox.innerHTML = `
                <div class="alert alert-danger py-2 small mb-3">
                    <i class="pixelart-icons-font-alert i8-xs me-1"></i> ${err.message || 'Lỗi khi tạo mã QR'}
                </div>
                <button type="button" class="btn btn-warning btn-sm pixel-font fw-bold" onclick="generateNewQrCode()">
                    <i class="pixelart-icons-font-reload i8-xs me-1"></i> Thử Tạo Lại
                </button>
            `;
        }
    };

    function startQrCountdown(seconds) {
        let remaining = seconds;
        const badge = document.getElementById('qrModalTimerBadge');
        const bar = document.getElementById('qrModalProgressBar');
        const overlay = document.getElementById('qrExpiredOverlay');

        // Đảm bảo overlay bị ẩn khi bắt đầu đếm
        if (overlay) {
            overlay.classList.add('d-none');
            overlay.classList.remove('d-flex');
            overlay.style.display = 'none';
        }

        badge.textContent = remaining + 's';
        bar.style.width = '100%';
        bar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-success';

        qrTimerInterval = setInterval(() => {
            remaining--;
            if (remaining <= 0) {
                clearInterval(qrTimerInterval);
                if (qrPollingInterval) clearInterval(qrPollingInterval);

                badge.textContent = '0s';
                bar.style.width = '0%';
                if (overlay) {
                    overlay.classList.remove('d-none');
                    overlay.classList.add('d-flex');
                    overlay.style.display = 'flex'; // Hiện overlay MÃ ĐÃ HẾT HẠN
                }
                return;
            }

            badge.textContent = remaining + 's';
            const pct = (remaining / 60) * 100;
            bar.style.width = pct + '%';

            if (remaining <= 15) {
                bar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-danger';
            } else if (remaining <= 30) {
                bar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-warning';
            } else {
                bar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-success';
            }
        }, 1000);
    }

    function startQrPolling(token) {
        qrPollingInterval = setInterval(async () => {
            try {
                const res = await fetch(`/api/family/qr-status/${encodeURIComponent(token)}`);
                if (!res.ok) return;
                const status = await res.json();

                if (status.isUsed) {
                    clearInterval(qrPollingInterval);
                    if (qrTimerInterval) clearInterval(qrTimerInterval);

                    document.getElementById('qrDisplayBox').style.display = 'none';
                    const successBox = document.getElementById('qrSuccessBox');
                    document.getElementById('qrSuccessMessage').innerHTML = `Bé <strong>${status.usedByUserName || 'Thành viên mới'}</strong> đã quét mã QR thành công và gia nhập nhóm gia đình!`;
                    successBox.style.display = 'block';

                    // Tải lại danh sách
                    await loadFamilyGroup();
                    await loadKids();
                }
            } catch (_) {}
        }, 2000);
    }

