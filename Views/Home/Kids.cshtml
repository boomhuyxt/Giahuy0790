    async function loadPresets() {
        if (cachedPresets.length > 0) {
            renderPresets();
            return;
        }

        try {
            const res = await fetch('/api/blockeditems/presets', { headers: getAuthHeaders() });
            if (res.ok) {
                cachedPresets = await res.json();
                renderPresets();
            }
        } catch (e) {
            console.warn('Lỗi tải presets:', e);
        }
    }

    function renderPresets() {
        const box = document.getElementById('boxPresetsPills');
        if (!box) return;

        const currentTargets = (currentBlockedItems || []).map(x => (x.target || '').toLowerCase());

        box.innerHTML = cachedPresets.map((p, idx) => {
            const isAlreadyBlocked = currentTargets.includes(p.target.toLowerCase());
            const badgeClass = isAlreadyBlocked ? 'btn-secondary text-white' : 'btn-outline-danger';
            const t = (p.title || '').toLowerCase();
            let iconHtml = p.itemType === 'App' ? '<i class="pixelart-icons-font-gamepad i8-xs text-warning me-1"></i>' : '<i class="pixelart-icons-font-globe i8-xs text-primary me-1"></i>';
            if (t.includes('tiktok')) iconHtml = '<i class="pixelart-icons-font-sunglasses i8-xs text-danger me-1"></i>';
            else if (t.includes('fire') || t.includes('liên quân')) iconHtml = '<i class="pixelart-icons-font-gamepad i8-xs text-warning me-1"></i>';
            else if (t.includes('roblox')) iconHtml = '<i class="pixelart-icons-font-blocks i8-xs text-danger me-1"></i>';
            else if (t.includes('b52') || t.includes('cờ bạc') || t.includes('go88')) iconHtml = '<i class="pixelart-icons-font-square-alert i8-xs text-danger me-1"></i>';
            else if (t.includes('18+') || t.includes('độc hại')) iconHtml = '<i class="pixelart-icons-font-eye-off i8-xs text-danger me-1"></i>';

            return `
            <button type="button" class="btn btn-sm ${badgeClass} py-1 px-3 d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 12px;" onclick="quickAddPreset(${idx})" ${isAlreadyBlocked || isKidRole ? 'disabled' : ''}>
                ${iconHtml}
                <span>${p.title}</span>
                ${isAlreadyBlocked ? '<span class="badge bg-dark ms-1" style="font-size: 9px;">Đã chặn</span>' : '<span class="text-danger fw-bold ms-1">+</span>'}
            </button>`;
        }).join('');
    }

    window.quickAddPreset = async function(index) {
        if (isKidRole) return;
        const p = cachedPresets[index];
        if (!p || !currentKidForBlocked) return;

        const alertBox = document.getElementById('blockedItemAlert');
        alertBox.innerHTML = '<div class="alert alert-info py-1 small">Đang thêm mục chặn...</div>';

        try {
            const res = await fetch(`/api/kids/${currentKidForBlocked}/blocked-items`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({
                    itemType: p.itemType,
                    target: p.target,
                    title: p.title,
                    category: p.category,
                    reason: p.defaultReason
                })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Lỗi khi thêm mục chặn');

            alertBox.innerHTML = `<div class="alert alert-success py-2 small alert-dismissible fade show">
                <strong>Thành công!</strong> ${data.message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;

            await loadBlockedItems(currentKidForBlocked);
            await loadKids();
        } catch (err) {
            alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        }
    };

    async function loadBlockedItems(kidId) {
        const containerEl = document.getElementById('blockedItemsContainer');
        const emptyEl = document.getElementById('emptyBlockedBox');

        try {
            const res = await fetch(`/api/kids/${kidId}/blocked-items`, { headers: getAuthHeaders() });
            if (!res.ok) throw new Error('Không thể tải danh sách chặn');
            const data = await res.json();
            currentBlockedItems = data.items || [];
            renderBlockedItems();
            renderPresets();
        } catch (err) {
            document.getElementById('blockedItemAlert').innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        }
    }

    function renderBlockedItems() {
        const containerEl = document.getElementById('blockedItemsContainer');
        const emptyEl = document.getElementById('emptyBlockedBox');

        const total = currentBlockedItems.length;
        const webCount = currentBlockedItems.filter(x => x.itemType === 'Website').length;
        const appCount = currentBlockedItems.filter(x => x.itemType === 'App').length;
        const activeBlocked = currentBlockedItems.filter(x => x.isBlocked).length;

        document.getElementById('countFilterAll').textContent = total;
        document.getElementById('countFilterWeb').textContent = webCount;
        document.getElementById('countFilterApp').textContent = appCount;
        document.getElementById('activeBlockedSummary').textContent = `${activeBlocked} mục đang chặn`;

        let filtered = currentBlockedItems;
        if (currentBlockedFilter !== 'all') {
            filtered = currentBlockedItems.filter(x => x.itemType === currentBlockedFilter);
        }

        if (filtered.length === 0) {
            containerEl.innerHTML = '';
            emptyEl.style.display = 'block';
            return;
        }

        emptyEl.style.display = 'none';
        containerEl.innerHTML = filtered.map(item => {
            const isWeb = item.itemType === 'Website';
            const iconHtml = isWeb 
                ? '<i class="pixelart-icons-font-globe i8-lg text-primary"></i>' 
                : '<i class="pixelart-icons-font-gamepad i8-lg text-warning"></i>';
            const badgeClass = isWeb ? 'badge bg-primary-subtle text-primary border border-primary' : 'badge bg-warning-subtle text-warning-emphasis border border-warning';
            const statusBadge = item.isBlocked 
                ? '<span class="badge bg-danger text-white"><i class="pixelart-icons-font-square-alert i8-xs me-1"></i> Đang chặn</span>'
                : '<span class="badge bg-success-subtle text-success border border-success"><i class="pixelart-icons-font-check i8-xs me-1"></i> Tạm mở</span>';

            const safeTitle = (item.title || '').replace(/'/g, "\\'");

            return `
            <div class="p-3 rounded-2 bg-white border shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-3">
                    ${iconHtml}
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="fw-bold text-dark">${item.title}</span>
                            <span class="${badgeClass}" style="font-size: 11px;">${item.category || item.itemType}</span>
                            ${statusBadge}
                        </div>
                        <div class="small font-monospace text-muted mt-1" style="font-size: 11px;">
                            ${item.target}
                        </div>
                        ${item.reason ? `<div class="text-secondary small mt-1" style="font-size: 11px;"><em>Ghi chú: ${item.reason}</em></div>` : ''}
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    ${!isKidRole ? `
                    <div class="form-check form-switch m-0" title="Bật/Tắt chặn">
                        <input class="form-check-input" type="checkbox" role="switch" ${item.isBlocked ? 'checked' : ''} onchange="toggleBlockedItem(${item.id})">
                    </div>
                    <button type="button" class="btn btn-sm btn-danger px-2 py-1" onclick="deleteBlockedItem(${item.id}, '${safeTitle}')" title="Xóa khỏi danh sách chặn">
                        <i class="pixelart-icons-font-trash i8-xs"></i>
                    </button>` : ''}
                </div>
            </div>`;
        }).join('');
    }

    // Đổi placeholder khi đổi loại chặn (Website / App)
    document.getElementById('inputItemType')?.addEventListener('change', (e) => {
        const isApp = e.target.value === 'App';
        const labelEl = document.getElementById('labelTargetInput');
        const inputEl = document.getElementById('inputTarget');
        const categoryEl = document.getElementById('inputCategory');

        if (isApp) {
            labelEl.innerHTML = 'Tên Ứng dụng / Mã gói <span class="text-danger">*</span>';
            inputEl.placeholder = 'vd: Roblox, Free Fire, com.zhiliaoapp.musically';
            categoryEl.value = 'Trò chơi / Game';
        } else {
            labelEl.innerHTML = 'Tên miền web / URL <span class="text-danger">*</span>';
            inputEl.placeholder = 'vd: tiktok.com, b52.club';
            categoryEl.value = 'Khác';
        }
    });

    // Lọc danh sách chặn
    document.getElementById('filterBlockedTabs')?.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-filter]');
        if (!btn) return;

        document.querySelectorAll('#filterBlockedTabs button').forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-light');
        });
        btn.classList.remove('btn-light');
        btn.classList.add('btn-primary');

        currentBlockedFilter = btn.getAttribute('data-filter');
        renderBlockedItems();
    });

    // Xử lý gửi Form tự nhập link chặn nhanh (Website / App)
    document.getElementById('formQuickLinkBlock')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentKidForBlocked) return;

        const inputEl = document.getElementById('quickLinkInput');
        const rawLink = inputEl.value.trim();
        const btn = document.getElementById('btnSubmitQuickLink');
        const alertBox = document.getElementById('blockedItemAlert');

        if (!rawLink) return;

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang chặn...';
        alertBox.innerHTML = '';

        try {
            const res = await fetch(`/api/kids/${currentKidForBlocked}/blocked-items`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ target: rawLink })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Lỗi khi thêm link chặn');

            inputEl.value = '';
            alertBox.innerHTML = `<div class="alert alert-success py-2 small alert-dismissible fade show">
                <strong>Thành công!</strong> ${data.message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;

            await loadBlockedItems(currentKidForBlocked);
            await loadKids();
        } catch (err) {
            alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '+ Chặn Link Này';
        }
    });

    // Form thêm mục chặn chi tiết
    document.getElementById('formAddBlockedItem')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentKidForBlocked) return;

        const btn = document.getElementById('btnAddBlockedItem');
        const alertBox = document.getElementById('blockedItemAlert');

        const itemType = document.getElementById('inputItemType').value;
        const target = document.getElementById('inputTarget').value.trim();
        const title = document.getElementById('inputTitle').value.trim();
        const category = document.getElementById('inputCategory').value;
        const reason = document.getElementById('inputReason').value.trim();

        if (!target) return;

        btn.disabled = true;
        btn.innerHTML = 'Đang thêm...';
        alertBox.innerHTML = '';

        try {
            const res = await fetch(`/api/kids/${currentKidForBlocked}/blocked-items`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({ itemType, target, title: title || null, category, reason: reason || null })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Lỗi khi thêm mục chặn');

            document.getElementById('formAddBlockedItem').reset();
            alertBox.innerHTML = `<div class="alert alert-success py-2 small alert-dismissible fade show">
                <strong>Thành công!</strong> ${data.message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;

            await loadBlockedItems(currentKidForBlocked);
            await loadKids();
        } catch (err) {
            alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '+ Lưu Chặn';
        }
    });

    // Toggle Bật/Tắt chặn
    window.toggleBlockedItem = async function(id) {
        try {
            const res = await fetch(`/api/blockeditems/${id}/toggle`, {
                method: 'PUT',
                headers: getAuthHeaders()
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Không thể đổi trạng thái');

            await loadBlockedItems(currentKidForBlocked);
            await loadKids();
        } catch (err) {
            alert(err.message);
        }
    };

    // Xóa mục chặn
    window.deleteBlockedItem = async function(id, title) {
        if (!confirm(`Bạn có chắc muốn xóa "${title}" khỏi danh sách chặn của bé?`)) return;

        try {
            const res = await fetch(`/api/blockeditems/${id}`, {
                method: 'DELETE',
                headers: getAuthHeaders()
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Không thể xóa');

            await loadBlockedItems(currentKidForBlocked);
            await loadKids();
        } catch (err) {
            alert(err.message);
        }
    };

    document.addEventListener('DOMContentLoaded', loadKids);
</script>
}
