@{
    ViewData["Title"] = "Lịch Trình & Nhiệm Vụ Của Bé";
}

<div class="container py-4">
    <!-- Header banner (8-Bit Retro Header) -->
    <div class="apple-card-static p-4 mb-4 border-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <i class="pixelart-icons-font-calendar i8-xl text-warning i8-bounce"></i>
                    <h2 class="fw-bold mb-0 pixel-font" style="letter-spacing: 0.04em;">
                        LỊCH TRÌNH & NHIỆM VỤ CỦA BÉ
                    </h2>
                    <span class="badge bg-warning text-dark">8-BIT QUEST</span>
                </div>
                <p class="text-muted mb-0 small">
                    Thiết lập thời gian biểu, theo dõi sinh hoạt và ghi nhận điểm sao thưởng khi bé hoàn thành xuất sắc nhiệm vụ.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <select id="selectKid" class="form-select" style="min-width: 200px;">
                    <option value="">-- Chọn Bé Yêu --</option>
                </select>
                <button class="btn btn-primary px-4" id="btnOpenAddActivity">
                    <i class="pixelart-icons-font-plus i8-xs me-1"></i> Thêm Nhiệm Vụ
                </button>
            </div>
        </div>
    </div>

    <!-- Alert placeholder -->
    <div id="pageAlert"></div>

    <!-- Kid Summary Info Banner (8-Bit Player Info) -->
    <div id="kidBanner" class="apple-card p-3 mb-4 d-none align-items-center justify-content-between border-2">
        <div class="d-flex align-items-center gap-3">
            <img id="bannerAvatar" src="" class="rounded-2 border" style="width: 48px; height: 48px; object-fit: cover;" alt="Avatar" />
            <div>
                <h5 class="fw-bold mb-0 d-flex align-items-center gap-2" id="bannerName"></h5>
                <small class="text-muted d-flex align-items-center gap-1">
                    <i class="pixelart-icons-font-heart i8-xs text-danger"></i>
                    <span id="bannerSchool"></span>
                </small>
            </div>
        </div>
        <div class="text-end px-3 py-2 apple-card-static">
            <div class="d-flex align-items-center gap-2 justify-content-end">
                <i class="pixelart-icons-font-star i8-md text-warning i8-pulse"></i>
                <span class="fs-4 fw-bold text-warning-emphasis pixel-font" id="bannerPoints">0</span>
            </div>
            <div class="small text-muted" style="font-size: 11px;">Sao thưởng tích lũy</div>
        </div>
    </div>

    <!-- Loading spinner -->
    <div id="loadingBox" class="text-center py-5">
        <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="text-muted mt-2 small">Đang tải lịch sinh hoạt...</p>
    </div>

    <!-- Activities Table / List -->
    <div class="apple-card overflow-hidden" id="activitiesCard" style="display: none;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3">Hoạt Động / Nhiệm Vụ</th>
                        <th class="py-3">Phân Loại</th>
                        <th class="py-3">Thời Gian</th>
                        <th class="py-3">Điểm Thưởng</th>
                        <th class="py-3">Trạng Thái</th>
                        <th class="text-end pe-4 py-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="activitiesTableBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Empty state -->
    <div id="emptyBox" class="text-center py-5 apple-card-static my-3" style="display: none;">
        <i class="pixelart-icons-font-calendar i8-xl text-muted mb-2"></i>
        <h5 class="fw-bold mt-2 pixel-font">Bé chưa có lịch trình hoặc nhiệm vụ nào</h5>
        <p class="text-muted small mb-4">Hãy nhấn nút bên dưới để tạo thời khóa biểu và giao nhiệm vụ cho bé rèn luyện mỗi ngày.</p>
        <button class="btn btn-primary px-4" onclick="document.getElementById('btnOpenAddActivity').click()">
            <i class="pixelart-icons-font-plus i8-xs me-1"></i> Thêm Nhiệm Vụ Mới
        </button>
    </div>
</div>

<!-- ================= MODAL THÊM HOẠT ĐỘNG (8-BIT RETRO) ================= -->
<div class="modal fade" id="modalActivity" tabindex="-1" aria-labelledby="modalActivityLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalActivityLabel">
                    <i class="pixelart-icons-font-calendar i8-md text-primary"></i>
                    <span>Giao Nhiệm Vụ / Lịch Sinh Hoạt</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formActivity">
                <div class="modal-body">
                    <div id="modalActAlert"></div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                            <i class="pixelart-icons-font-heart i8-xs text-danger"></i> Bé thực hiện <span class="text-danger">*</span>
                        </label>
                        <select id="actKidId" class="form-select" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                            <i class="pixelart-icons-font-magic-edit i8-xs text-primary"></i> Tiêu đề nhiệm vụ <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="actTitle" class="form-control" placeholder="Ví dụ: Đọc sách 20 phút, Tự giác đánh răng, Dọn bàn học..." required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-sliders i8-xs text-primary"></i> Phân loại
                            </label>
                            <select id="actCategory" class="form-select">
                                <option value="Học tập">Học tập</option>
                                <option value="Sinh hoạt">Sinh hoạt</option>
                                <option value="Dinh dưỡng">Dinh dưỡng</option>
                                <option value="Thể thao">Thể thao</option>
                                <option value="Sức khỏe">Sức khỏe</option>
                                <option value="Nhiệm vụ">Nhiệm vụ gia đình</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-star i8-xs text-warning"></i> Sao thưởng
                            </label>
                            <input type="number" id="actPoints" class="form-control" value="5" min="1" max="100" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                            <i class="pixelart-icons-font-clock i8-xs text-primary"></i> Thời gian dự kiến
                        </label>
                        <input type="datetime-local" id="actTime" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mô tả chi tiết hoặc dặn dò</label>
                        <textarea id="actDesc" class="form-control" rows="2" placeholder="Ghi chú thêm về cách làm hoặc lời dặn của cha mẹ..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4" id="btnSaveAct">
                        <i class="pixelart-icons-font-plus i8-xs me-1"></i> Tạo Nhiệm Vụ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allKids = [];
    let currentKidId = null;
    const selectKid = document.getElementById('selectKid');
    const actKidSelect = document.getElementById('actKidId');
    const tableBody = document.getElementById('activitiesTableBody');
    const loadingBox = document.getElementById('loadingBox');
    const emptyBox = document.getElementById('emptyBox');
    const activitiesCard = document.getElementById('activitiesCard');
    const kidBanner = document.getElementById('kidBanner');
    const modal = new bootstrap.Modal(document.getElementById('modalActivity'));

    function getAuthHeaders() {
        const token = localStorage.getItem('authToken');
        const headers = { 'Content-Type': 'application/json' };
        if (token) headers['Authorization'] = `Bearer ${token}`;
        return headers;
    }

    async function initPage() {
        const params = new URLSearchParams(window.location.search);
        const urlKidId = params.get('kidId');

        try {
            const userStr = localStorage.getItem('authUser');
            let isKidUser = false;
            if (userStr) {
                try {
                    const u = JSON.parse(userStr);
                    isKidUser = (u.roles || []).includes('Kid') || (u.roles || []).includes('kid');
                } catch (_) {}
            }
            if (isKidUser) {
                const addBtn = document.getElementById('btnOpenAddActivity');
                if (addBtn) addBtn.style.display = 'none';
            }

            const res = await fetch('/api/kids', { headers: getAuthHeaders() });
            allKids = await res.json();

            if (isKidUser && allKids.length === 1) {
                selectKid.style.display = 'none';
            } else {
                selectKid.style.display = 'inline-block';
            }

            selectKid.innerHTML = '<option value="">-- Chọn Bé Yêu --</option>' +
                allKids.map(k => `<option value="${k.id}">${k.fullName} ${k.nickname ? `(${k.nickname})` : ''}</option>`).join('');

            actKidSelect.innerHTML = allKids.map(k => `<option value="${k.id}">${k.fullName}</option>`).join('');

            if (urlKidId && allKids.some(k => k.id == urlKidId)) {
                selectKid.value = urlKidId;
                currentKidId = parseInt(urlKidId);
            } else if (allKids.length > 0) {
                selectKid.value = allKids[0].id;
                currentKidId = allKids[0].id;
            }

            if (currentKidId) {
                await loadActivitiesForKid(currentKidId);
            } else {
                loadingBox.style.display = 'none';
                emptyBox.style.display = 'block';
            }
        } catch (err) {
            loadingBox.style.display = 'none';
            document.getElementById('pageAlert').innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        }
    }

    async function loadActivitiesForKid(kidId) {
        loadingBox.style.display = 'block';
        activitiesCard.style.display = 'none';
        emptyBox.style.display = 'none';

        const kid = allKids.find(k => k.id === kidId);
        if (kid) {
            kidBanner.classList.remove('d-none');
            kidBanner.classList.add('d-flex');
            document.getElementById('bannerAvatar').src = kid.avatarUrl || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(kid.fullName)}`;
            document.getElementById('bannerName').textContent = `${kid.fullName} ${kid.nickname ? `(Bé ${kid.nickname})` : ''}`;
            document.getElementById('bannerSchool').textContent = kid.schoolName || 'Chưa cập nhật trường học';
            document.getElementById('bannerPoints').textContent = `${kid.totalPoints || 0}`;
        }

        try {
            const res = await fetch(`/api/kidactivities/kid/${kidId}`, { headers: getAuthHeaders() });
            const list = await res.json();
            renderActivities(list);
        } catch (err) {
            document.getElementById('pageAlert').innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        } finally {
            loadingBox.style.display = 'none';
        }
    }

    function renderActivities(list) {
        if (!list || list.length === 0) {
            emptyBox.style.display = 'block';
            activitiesCard.style.display = 'none';
            return;
        }

        emptyBox.style.display = 'none';
        activitiesCard.style.display = 'block';

        const userStr = localStorage.getItem('authUser');
        let isKidUser = false;
        if (userStr) {
            try {
                const u = JSON.parse(userStr);
                isKidUser = (u.roles || []).includes('Kid') || (u.roles || []).includes('kid');
            } catch (_) {}
        }

        tableBody.innerHTML = list.map(a => {
            const isCompleted = a.status === 'Completed';
            const statusBadge = isCompleted 
                ? '<span class="badge bg-success-subtle text-success border border-success"><i class="pixelart-icons-font-check i8-xs me-1"></i> Hoàn thành</span>'
                : '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning"><i class="pixelart-icons-font-clock i8-xs me-1"></i> Chờ thực hiện</span>';
            
            const timeStr = a.activityTime ? new Date(a.activityTime).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' }) : 'Hàng ngày';

            return `
            <tr class="${isCompleted ? 'opacity-75' : ''}">
                <td class="ps-4 py-3">
                    <div class="fw-semibold ${isCompleted ? 'text-decoration-line-through text-muted' : ''}">${a.title}</div>
                    ${a.description ? `<small class="text-muted">${a.description}</small>` : ''}
                </td>
                <td class="py-3"><span class="badge apple-badge-neutral">${a.category}</span></td>
                <td class="py-3"><small class="text-muted">${timeStr}</small></td>
                <td class="py-3"><span class="fw-bold text-warning-emphasis d-inline-flex align-items-center gap-1 pixel-font" style="font-size: 11px;"><i class="pixelart-icons-font-star i8-xs text-warning"></i> +${a.rewardPoints || 5}</span></td>
                <td class="py-3">${statusBadge}</td>
                <td class="text-end pe-4 py-3">
                    ${!isCompleted ? `
                    <button class="btn btn-sm btn-primary px-3 py-1 me-1" onclick="markComplete(${a.id})">
                        <i class="pixelart-icons-font-check i8-xs me-1"></i> Hoàn thành
                    </button>` : ''}
                    ${!isKidUser ? `
                    <button class="btn btn-sm btn-danger px-2 py-1" onclick="deleteActivity(${a.id})" title="Xóa nhiệm vụ">
                        <i class="pixelart-icons-font-trash i8-xs"></i>
                    </button>` : ''}
                </td>
            </tr>`;
        }).join('');
    }

    selectKid.addEventListener('change', async (e) => {
        const id = parseInt(e.target.value);
        if (id) {
            currentKidId = id;
            await loadActivitiesForKid(id);
        }
    });

    document.getElementById('btnOpenAddActivity')?.addEventListener('click', () => {
        document.getElementById('formActivity').reset();
        if (currentKidId) actKidSelect.value = currentKidId;
        document.getElementById('actTime').value = new Date(Date.now() + 3600000).toISOString().slice(0, 16);
        document.getElementById('modalActAlert').innerHTML = '';
        modal.show();
    });

    document.getElementById('formActivity')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const alertBox = document.getElementById('modalActAlert');
        const btn = document.getElementById('btnSaveAct');

        btn.disabled = true;
        btn.innerHTML = 'Đang tạo...';
        alertBox.innerHTML = '';

        try {
            const payload = {
                kidId: parseInt(actKidSelect.value),
                title: document.getElementById('actTitle').value.trim(),
                category: document.getElementById('actCategory').value,
                rewardPoints: parseInt(document.getElementById('actPoints').value) || 5,
                activityTime: document.getElementById('actTime').value ? new Date(document.getElementById('actTime').value).toISOString() : new Date().toISOString(),
                description: document.getElementById('actDesc').value.trim() || null
            };

            const res = await fetch('/api/kidactivities', {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify(payload)
            });

            if (!res.ok) throw new Error('Không thể tạo hoạt động');
            modal.hide();

            const refreshRes = await fetch('/api/kids', { headers: getAuthHeaders() });
            allKids = await refreshRes.json();
            await loadActivitiesForKid(payload.kidId);
        } catch (err) {
            alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${err.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Tạo Nhiệm Vụ';
        }
    });

    window.markComplete = async function(id) {
        try {
            const res = await fetch(`/api/kidactivities/${id}/status`, {
                method: 'PUT',
                headers: getAuthHeaders(),
                body: JSON.stringify({ status: 'Completed' })
            });

            if (res.ok) {
                const refreshRes = await fetch('/api/kids', { headers: getAuthHeaders() });
                allKids = await refreshRes.json();
                if (currentKidId) await loadActivitiesForKid(currentKidId);
            }
        } catch (_) {}
    };

    window.deleteActivity = async function(id) {
        if (!confirm('Bạn có chắc muốn xóa nhiệm vụ này?')) return;
        try {
            const res = await fetch(`/api/kidactivities/${id}`, {
                method: 'DELETE',
                headers: getAuthHeaders()
            });
            if (res.ok && currentKidId) await loadActivitiesForKid(currentKidId);
        } catch (_) {}
    };

    document.addEventListener('DOMContentLoaded', initPage);
</script>
}
