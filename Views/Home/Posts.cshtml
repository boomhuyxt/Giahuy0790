@{
    ViewData["Title"] = "Bảng tin Bài đăng (Facebook Feed)";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7">

        <!-- Header Bảng tin -->
        <div class="text-center mb-4">
            <h3 class="fw-bold d-flex align-items-center justify-content-center gap-2 mb-1">
                <span class="badge bg-primary rounded-circle p-2 fs-6">f</span>
                <span>Bảng Tin Bài Đăng</span>
            </h3>
            <p class="text-body-secondary small mb-0">
                Giao diện Facebook • Hỗ trợ tải ảnh trực tiếp từ máy vào <code>wwwroot/uploads/posts/</code>
            </p>
        </div>

        <!-- Khung thông báo Alert -->
        <div id="postAlertContainer"></div>

        <!-- ================= KHUNG TẠO BÀI ĐĂNG (CREATE POST BOX) ================= -->
        <div class="card border shadow-sm rounded-4 mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img id="myAvatarPreview" src="https://api.dicebear.com/7.x/bottts/svg?seed=GiaHuy" 
                         alt="Avatar" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" />
                    <div class="flex-grow-1">
                        <input type="text" id="postAuthorInput" class="form-control form-control-sm fw-semibold border-0 bg-body-tertiary rounded-pill px-3" 
                               value="Gia Huy" placeholder="Tên tác giả..." title="Bạn có thể đổi tên tác giả tại đây" />
                    </div>
                </div>

                <!-- Textarea nhập nội dung -->
                <div class="mb-3">
                    <textarea id="postContentInput" class="form-control border-0 bg-transparent fs-5 px-1" rows="3" 
                              placeholder="Bạn đang nghĩ gì thế, Gia Huy?" style="resize: none;"></textarea>
                </div>

                <!-- Ô nhập link hoặc chọn ảnh từ máy -->
                <div id="imageInputBox" class="mb-3 d-none">
                    <div class="card bg-body-tertiary border p-3 rounded-3 mb-2">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-semibold small">Thêm ảnh vào bài viết</span>
                            <button type="button" class="btn-close btn-sm" id="btnCloseImageInput" aria-label="Close"></button>
                        </div>
                        
                        <!-- Chọn file từ máy -->
                        <div class="mb-2">
                            <input type="file" id="postFileInput" class="form-control form-control-sm" accept="image/*" />
                            <small class="text-body-secondary d-block mt-1">📁 Chọn file ảnh từ máy để tự động tải lên <code>wwwroot/uploads/posts/</code></small>
                        </div>

                        <!-- Hoặc nhập link ảnh -->
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-body">🔗 URL</span>
                            <input type="url" id="postImageUrlInput" class="form-control" placeholder="Hoặc dán liên kết ảnh trực tuyến..." />
                        </div>
                    </div>

                    <!-- Khung Preview ảnh bài viết -->
                    <div id="createImagePreviewContainer" class="d-none text-center rounded-3 p-2 bg-body-secondary border position-relative">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2 bg-white" id="btnClearImageInput" aria-label="Remove image"></button>
                        <img id="createImagePreview" src="" class="rounded-3" style="max-height: 280px; max-width: 100%; object-fit: contain;" />
                    </div>
                </div>

                <hr class="my-2 border-subtle" />

                <!-- Hàng nút tiện ích & Nút Đăng bài -->
                <div class="d-flex align-items-center justify-content-between pt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill d-flex align-items-center gap-2" id="btnToggleImageInput">
                        <span>🖼️</span>
                        <span>Thêm Ảnh / Video</span>
                    </button>

                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" id="btnSubmitPost">
                        Đăng bài (1đ)
                    </button>
                </div>
            </div>
        </div>

        <!-- ================= FEED DANH SÁCH BÀI ĐĂNG (POSTS FEED) ================= -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-bold text-body-secondary text-uppercase small mb-0">Bài viết gần đây (<span id="postCount">0</span>)</h6>
            <button class="btn btn-link btn-sm text-decoration-none text-body-secondary p-0" id="btnRefreshPosts">
                🔄 Làm mới bảng tin
            </button>
        </div>

        <!-- Loading spinner -->
        <div id="postsLoading" class="text-center py-5 d-none">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-body-secondary mt-2 small">Đang nạp các bài viết từ Supabase...</p>
        </div>

        <!-- Danh sách bài đăng đổ vào đây -->
        <div id="postsFeedContainer" class="d-flex flex-column gap-3 mb-5">
            <!-- Render bài đăng bằng JS -->
        </div>

        <!-- Empty state -->
        <div id="postsEmptyState" class="card border rounded-4 text-center p-5 shadow-sm d-none">
            <div class="display-3 text-body-secondary mb-2">📰</div>
            <h5 class="fw-bold text-body-secondary">Chưa có bài viết nào trên bảng tin</h5>
            <p class="text-body-secondary small mb-3">Hãy là người đầu tiên đăng bài viết của bạn!</p>
            <div>
                <button class="btn btn-primary btn-sm rounded-pill px-3" onclick="document.getElementById('postContentInput').focus()">
                    ✍️ Viết bài ngay
                </button>
            </div>
        </div>

    </div>
</div>

<!-- ================= MODAL CHỈNH SỬA BÀI VIẾT (EDIT POST MODAL) ================= -->
<div class="modal fade" id="modalEditPost" tabindex="-1" aria-labelledby="modalEditPostLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="modalEditPostLabel">✏️ Chỉnh sửa bài viết (1đ)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditPost">
                <input type="hidden" id="editPostId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tên người đăng</label>
                        <input type="text" id="editAuthorName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nội dung bài viết <span class="text-danger">*</span></label>
                        <textarea id="editContent" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Hình ảnh đính kèm</label>
                        <div class="mb-2">
                            <input type="file" id="editPostFileInput" class="form-control form-control-sm" accept="image/*" />
                            <small class="text-body-secondary d-block mt-1">📁 Chọn ảnh mới từ máy nếu muốn thay thế ảnh cũ</small>
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-body">🔗 URL</span>
                            <input type="url" id="editImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                        </div>
                        <div id="editPostPreviewContainer" class="d-none mt-2 text-center p-2 rounded-3 bg-body-secondary border">
                            <img id="editPostPreviewImg" src="" style="max-height: 180px; max-width: 100%; object-fit: contain;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const API_POSTS_URL = '/api/posts';
    const API_UPLOAD_POST_URL = '/api/uploads/post';

    // Helper: Thông báo nhanh
    const showPostAlert = (message, type = 'success') => {
        const container = document.getElementById('postAlertContainer');
        container.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show shadow-sm rounded-3" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        setTimeout(() => {
            const el = container.querySelector('.alert');
            if (el) bootstrap.Alert.getOrCreateInstance(el).close();
        }, 4000);
    };

    // Helper: Upload file ảnh bài đăng vào wwwroot/uploads/posts
    const uploadPostFile = async (fileInput, urlTargetInput, previewContainer, previewImg) => {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];

        const formData = new FormData();
        formData.append('file', file);

        showPostAlert('Đang tải ảnh bài đăng lên wwwroot/uploads/posts...', 'info');

        try {
            const res = await fetch(API_UPLOAD_POST_URL, {
                method: 'POST',
                body: formData
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.message || 'Lỗi khi tải ảnh');
            }

            const data = await res.json();
            urlTargetInput.value = data.url;
            previewImg.src = data.url;
            previewContainer.classList.remove('d-none');
            showPostAlert(`✅ Đã lưu ảnh vào: ${data.url}`, 'success');
        } catch (err) {
            showPostAlert(err.message, 'danger');
        }
    };

    document.getElementById('postFileInput').addEventListener('change', function() {
        uploadPostFile(
            this,
            document.getElementById('postImageUrlInput'),
            document.getElementById('createImagePreviewContainer'),
            document.getElementById('createImagePreview')
        );
    });

    document.getElementById('editPostFileInput').addEventListener('change', function() {
        uploadPostFile(
            this,
            document.getElementById('editImageUrl'),
            document.getElementById('editPostPreviewContainer'),
            document.getElementById('editPostPreviewImg')
        );
    });

    // Helper: Tính thời gian tương đối giống Facebook
    const formatTimeAgo = (dateStr) => {
        if (!dateStr) return 'Vừa xong';
        const date = new Date(dateStr);
        const now = new Date();
        const seconds = Math.floor((now - date) / 1000);

        if (seconds < 60) return 'Vừa xong';
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes} phút trước`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} giờ trước`;
        const days = Math.floor(hours / 24);
        if (days < 7) return `${days} ngày trước`;
        return date.toLocaleDateString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
    };

    // Render toàn bộ danh sách bài đăng ra giao diện
    const renderPostsFeed = (posts) => {
        const container = document.getElementById('postsFeedContainer');
        const emptyState = document.getElementById('postsEmptyState');
        const countSpan = document.getElementById('postCount');

        countSpan.textContent = posts.length;

        if (!posts || posts.length === 0) {
            container.innerHTML = '';
            emptyState.classList.remove('d-none');
            return;
        }

        emptyState.classList.add('d-none');
        container.innerHTML = posts.map(p => {
            const avatar = p.authorAvatar || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(p.authorName || 'User')}`;
            const author = p.authorName || 'Người dùng ẩn danh';
            const timeAgo = formatTimeAgo(p.createdAt);

            return `
                <div class="card border rounded-4 shadow-sm" id="post-card-${p.id}">
                    <!-- Post Header: Avatar, Name, Time, Menu 3 chấm -->
                    <div class="card-body pb-2 pt-3 px-3 px-md-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <img src="${avatar}" alt="${author}" class="rounded-circle border" 
                                     style="width: 44px; height: 44px; object-fit: cover;" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=User';" />
                                <div>
                                    <div class="fw-bold d-flex align-items-center gap-1">
                                        <span>${author}</span>
                                        <span class="text-primary small" title="Đã xác minh">✓</span>
                                    </div>
                                    <small class="text-body-secondary d-flex align-items-center gap-1">
                                        <span>${timeAgo}</span>
                                        <span>•</span>
                                        <span title="Công khai">🌐</span>
                                    </small>
                                </div>
                            </div>

                            <!-- Menu hành động (Sửa: 1đ / Xóa: 1đ) -->
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn bài viết">
                                    <span class="fs-6">⋮</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border">
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2" onclick="openEditPostModal(${p.id})">
                                            <span>✏️</span>
                                            <span>Chỉnh sửa bài viết</span>
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 text-danger" onclick="deletePost(${p.id})">
                                            <span>🗑️</span>
                                            <span>Xóa bài viết</span>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Post Content Text -->
                        <div class="mt-3 mb-2 fs-6" style="white-space: pre-wrap; word-break: break-word;">${p.content || ''}</div>
                    </div>

                    <!-- Post Image (nếu có) -->
                    ${p.imageUrl ? `
                        <div class="border-top border-bottom" style="background: var(--bs-tertiary-bg); max-height: 520px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                            <img src="${p.imageUrl}" class="w-100" style="max-height: 520px; object-fit: cover;" 
                                 onerror="this.parentElement.style.display='none';" alt="Hình ảnh bài đăng" />
                        </div>
                    ` : ''}

                    <!-- Post Footer: Số lượt Like & Nút tương tác (Like, Comment, Share) -->
                    <div class="card-body pt-2 pb-2 px-3 px-md-4">
                        <div class="d-flex align-items-center justify-content-between text-body-secondary small py-1 border-bottom">
                            <div class="d-flex align-items-center gap-1">
                                <span class="badge bg-primary rounded-circle p-1">👍</span>
                                <span class="badge bg-danger rounded-circle p-1">❤️</span>
                                <span id="likes-count-${p.id}" class="ms-1 fw-semibold">${p.likesCount || 0} lượt thích</span>
                            </div>
                            <div>
                                <span>0 bình luận</span> • <span>0 lượt chia sẻ</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <button class="btn btn-light btn-sm flex-fill d-flex align-items-center justify-content-center gap-2 rounded-3 text-body-secondary fw-semibold py-2" 
                                    onclick="likePost(${p.id})">
                                <span>👍</span>
                                <span>Thích</span>
                            </button>
                            <button class="btn btn-light btn-sm flex-fill d-flex align-items-center justify-content-center gap-2 rounded-3 text-body-secondary fw-semibold py-2" 
                                    onclick="showPostAlert('Tính năng bình luận đang được phát triển!', 'info')">
                                <span>💬</span>
                                <span>Bình luận</span>
                            </button>
                            <button class="btn btn-light btn-sm flex-fill d-flex align-items-center justify-content-center gap-2 rounded-3 text-body-secondary fw-semibold py-2" 
                                    onclick="navigator.clipboard?.writeText(window.location.href); showPostAlert('Đã sao chép liên kết bài viết!', 'success');">
                                <span>↗️</span>
                                <span>Chia sẻ</span>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    };

    // 1. API: Lấy tất cả bài đăng (Đổ dữ liệu lên giao diện)
    const loadPosts = async () => {
        const loading = document.getElementById('postsLoading');
        loading.classList.remove('d-none');
        try {
            const res = await fetch(API_POSTS_URL);
            if (!res.ok) throw new Error('Không thể tải danh sách bài đăng');
            const posts = await res.json();
            renderPostsFeed(posts);
        } catch (err) {
            showPostAlert(err.message, 'danger');
        } finally {
            loading.classList.add('d-none');
        }
    };

    // 2. API: Thêm bài đăng mới (Chức năng Thêm: 1đ)
    document.getElementById('btnSubmitPost').addEventListener('click', async () => {
        const contentInput = document.getElementById('postContentInput');
        const authorInput = document.getElementById('postAuthorInput');
        const imageUrlInput = document.getElementById('postImageUrlInput');

        const content = contentInput.value.trim();
        if (!content) {
            showPostAlert('Vui lòng nhập nội dung bài viết trước khi đăng!', 'warning');
            contentInput.focus();
            return;
        }

        const payload = {
            authorName: authorInput.value.trim() || 'Gia Huy',
            authorAvatar: `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(authorInput.value.trim() || 'GiaHuy')}`,
            content: content,
            imageUrl: imageUrlInput.value.trim() || null
        };

        const btn = document.getElementById('btnSubmitPost');
        btn.disabled = true;
        btn.innerHTML = 'Đang đăng...';

        try {
            const res = await fetch(API_POSTS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errData = await res.json();
                throw new Error(errData.message || 'Lỗi khi đăng bài');
            }

            contentInput.value = '';
            imageUrlInput.value = '';
            document.getElementById('postFileInput').value = '';
            document.getElementById('imageInputBox').classList.add('d-none');
            document.getElementById('createImagePreviewContainer').classList.add('d-none');

            showPostAlert('🎉 Đăng bài viết mới thành công!');
            loadPosts();
        } catch (err) {
            showPostAlert(err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Đăng bài (1đ)';
        }
    });

    // 3. API: Mở Modal và Sửa bài đăng (Chức năng Sửa: 1đ)
    window.openEditPostModal = async (id) => {
        try {
            const res = await fetch(`${API_POSTS_URL}/${id}`);
            if (!res.ok) throw new Error('Không thể tải thông tin bài viết');
            const post = await res.json();

            document.getElementById('editPostId').value = post.id;
            document.getElementById('editAuthorName').value = post.authorName || '';
            document.getElementById('editContent').value = post.content || '';
            document.getElementById('editImageUrl').value = post.imageUrl || '';
            document.getElementById('editPostFileInput').value = '';

            const previewBox = document.getElementById('editPostPreviewContainer');
            const previewImg = document.getElementById('editPostPreviewImg');
            if (post.imageUrl) {
                previewImg.src = post.imageUrl;
                previewBox.classList.remove('d-none');
            } else {
                previewBox.classList.add('d-none');
            }

            const modal = new bootstrap.Modal(document.getElementById('modalEditPost'));
            modal.show();
        } catch (err) {
            showPostAlert(err.message, 'danger');
        }
    };

    document.getElementById('formEditPost').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editPostId').value;
        const payload = {
            authorName: document.getElementById('editAuthorName').value.trim(),
            content: document.getElementById('editContent').value.trim(),
            imageUrl: document.getElementById('editImageUrl').value.trim() || null
        };

        try {
            const res = await fetch(`${API_POSTS_URL}/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.message || 'Lỗi khi cập nhật bài viết');
            }

            bootstrap.Modal.getInstance(document.getElementById('modalEditPost')).hide();
            showPostAlert('✅ Cập nhật bài viết thành công!');
            loadPosts();
        } catch (err) {
            showPostAlert(err.message, 'danger');
        }
    });

    // 4. API: Xóa bài đăng (Chức năng Xóa: 1đ)
    window.deletePost = async (id) => {
        if (!confirm('Bạn có chắc chắn muốn xóa bài viết này không? Hành động này không thể hoàn tác.')) {
            return;
        }

        try {
            const res = await fetch(`${API_POSTS_URL}/${id}`, {
                method: 'DELETE'
            });

            if (!res.ok) throw new Error('Không thể xóa bài viết');

            showPostAlert('🗑️ Đã xóa bài viết thành công!');
            loadPosts();
        } catch (err) {
            showPostAlert(err.message, 'danger');
        }
    };

    // 5. API: Thích (Like) bài viết
    window.likePost = async (id) => {
        try {
            const res = await fetch(`${API_POSTS_URL}/${id}/like`, {
                method: 'POST'
            });
            if (!res.ok) throw new Error('Không thể like bài viết');
            const data = await res.json();

            const countEl = document.getElementById(`likes-count-${id}`);
            if (countEl) {
                countEl.textContent = `${data.likesCount} lượt thích`;
            }
        } catch (err) {
            showPostAlert(err.message, 'danger');
        }
    };

    // Tiện ích UI: Bật/Tắt khung nhập link ảnh
    document.getElementById('btnToggleImageInput').addEventListener('click', () => {
        const box = document.getElementById('imageInputBox');
        box.classList.toggle('d-none');
        if (!box.classList.contains('d-none')) {
            document.getElementById('postFileInput').focus();
        }
    });

    document.getElementById('btnCloseImageInput').addEventListener('click', () => {
        document.getElementById('imageInputBox').classList.add('d-none');
    });

    document.getElementById('btnClearImageInput').addEventListener('click', () => {
        document.getElementById('postImageUrlInput').value = '';
        document.getElementById('postFileInput').value = '';
        document.getElementById('createImagePreviewContainer').classList.add('d-none');
    });

    document.getElementById('postImageUrlInput').addEventListener('input', (e) => {
        const val = e.target.value.trim();
        const previewBox = document.getElementById('createImagePreviewContainer');
        const previewImg = document.getElementById('createImagePreview');
        if (val) {
            previewImg.src = val;
            previewBox.classList.remove('d-none');
        } else {
            previewBox.classList.add('d-none');
        }
    });

    document.getElementById('editImageUrl').addEventListener('input', (e) => {
        const val = e.target.value.trim();
        const previewBox = document.getElementById('editPostPreviewContainer');
        const previewImg = document.getElementById('editPostPreviewImg');
        if (val) {
            previewImg.src = val;
            previewBox.classList.remove('d-none');
        } else {
            previewBox.classList.add('d-none');
        }
    });

    document.getElementById('btnRefreshPosts').addEventListener('click', loadPosts);

    // Tải dữ liệu bài đăng khi trang sẵn sàng
    document.addEventListener('DOMContentLoaded', loadPosts);
</script>
}
