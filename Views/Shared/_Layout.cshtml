<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KidCare</title>
    
    <!-- Script khởi động sớm Dark/Light Theme tránh nhấp nháy -->
    <script>
        (function() {
            const storedTheme = localStorage.getItem('theme');
            const preferredTheme = storedTheme ? storedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', preferredTheme);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Silkscreen:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/pixelarticons/pixelart-icons-font.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Giahuy0790.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg apple-nav mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary text-white p-2 rounded-3 d-inline-flex align-items-center gap-1 shadow-sm">
                        <i class="pixelart-icons-font-gamepad i8-sm"></i>
                        <span class="fw-bold">KC</span>
                    </span>
                    <span class="fw-bold fs-5 tracking-tight">KidCare</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0 ms-1 d-none d-sm-inline-block rounded-pill" style="font-size: 10px;">BOOTSTRAP 5</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="pixelart-icons-font-home i8-sm text-primary"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/kids">
                                <i class="pixelart-icons-font-users i8-sm text-info"></i> Quản lý Trẻ & Gia đình
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/tracking">
                                <i class="pixelart-icons-font-map-pin i8-sm text-primary"></i> Định Vị GPS
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/parental-control">
                                <i class="pixelart-icons-font-shield i8-sm text-danger"></i> Chặn Web & App
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/screentime">
                                <i class="pixelart-icons-font-clock i8-sm text-primary"></i> Đặt Giờ Máy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link position-relative" href="/intercom">
                                <i class="pixelart-icons-font-radio i8-sm text-danger"></i> Bộ Đàm
                                <span id="navVoiceBadge" class="badge rounded-pill bg-danger ms-1 d-none" style="font-size: 10px;">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/activities">
                                <i class="pixelart-icons-font-calendar i8-sm text-warning"></i> Lịch & Hoạt động
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger" target="_blank">
                                <i class="pixelart-icons-font-zap i8-sm text-warning"></i> API <span class="badge apple-badge-blue ms-1">v1</span>
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Khu vực Trạng thái Xác thực Người dùng -->
                        <div id="authNavGuest" class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-primary btn-sm rounded-2 px-3" data-bs-toggle="modal" data-bs-target="#modalLogin">
                                <i class="pixelart-icons-font-lock i8-xs me-1"></i> Đăng nhập
                            </button>
                            <button class="btn btn-primary btn-sm rounded-2 px-3" data-bs-toggle="modal" data-bs-target="#modalRegister">
                                <i class="pixelart-icons-font-user-plus i8-xs me-1"></i> Đăng ký
                            </button>
                        </div>

                        <div id="authNavUser" class="d-none align-items-center gap-2">
                            <img id="navUserAvatar" src="" class="rounded-2 border" style="width: 34px; height: 34px; object-fit: cover;" alt="Avatar" />
                            <span id="navUserName" class="fw-semibold small"></span>
                            <button class="btn btn-secondary btn-sm rounded-2 px-2 py-1 ms-1" id="btnNavLogout" title="Đăng xuất">
                                <i class="pixelart-icons-font-door-closed i8-xs"></i>
                            </button>
                        </div>

                        <div class="vr mx-1" style="opacity: 0.25;"></div>

                        <!-- Nút chuyển đổi Dark / Light Mode Bootstrap 5 -->
                        <button class="theme-switch-btn" id="themeToggleBtn" type="button" aria-label="Chuyển chế độ Giao diện" title="Chuyển chế độ Sáng / Tối">
                            <span id="themeToggleIcon" class="theme-icon-active d-inline-flex align-items-center">
                                <i class="pixelart-icons-font-moon i8-sm text-info"></i>
                            </span>
                            <span id="themeToggleText" class="ms-1 d-none d-sm-inline small fw-semibold">Tối</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container page-container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- ================= MODAL ĐĂNG NHẬP (8-BIT RETRO) ================= -->
    <div class="modal fade" id="modalLogin" tabindex="-1" aria-labelledby="modalLoginLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalLoginLabel">
                        <i class="pixelart-icons-font-lock i8-md text-primary"></i>
                        <span>Đăng Nhập Tài Khoản</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formLogin">
                    <div class="modal-body">
                        <div id="loginAlertBox"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-user i8-xs text-primary"></i> Tài khoản hoặc Email
                            </label>
                            <input type="text" id="loginIdentifier" class="form-control" placeholder="Tên đăng nhập hoặc email" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-lock i8-xs text-primary"></i> Mật khẩu
                            </label>
                            <input type="password" id="loginPassword" class="form-control" placeholder="••••••••" required />
                        </div>
                        <div class="d-flex justify-content-end mb-3">
                            <a href="#" class="small text-decoration-none" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalForgotPassword">
                                <i class="pixelart-icons-font-circle-info i8-xs me-1"></i> Quên mật khẩu?
                            </a>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalRegister">
                            Chưa có tài khoản?
                        </button>
                        <button type="submit" class="btn btn-primary rounded-2 px-4" id="btnSubmitLogin">
                            <i class="pixelart-icons-font-lock i8-xs me-1"></i> Đăng nhập
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= MODAL ĐĂNG KÝ (8-BIT RETRO) ================= -->
    <div class="modal fade" id="modalRegister" tabindex="-1" aria-labelledby="modalRegisterLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalRegisterLabel">
                        <i class="pixelart-icons-font-user-plus i8-md text-primary"></i>
                        <span>Đăng Ký Tài Khoản</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formRegister">
                    <div class="modal-body">
                        <div id="registerAlertBox"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-user i8-xs text-primary"></i> Tên đăng nhập <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="regUsername" class="form-control" placeholder="Ví dụ: giahuy123" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-mail i8-xs text-primary"></i> Địa chỉ Email <span class="text-danger">*</span>
                            </label>
                            <input type="email" id="regEmail" class="form-control" placeholder="name@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-heart i8-xs text-primary"></i> Họ và tên
                            </label>
                            <input type="text" id="regFullName" class="form-control" placeholder="Ví dụ: Nguyễn Gia Huy" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-sliders i8-xs text-primary"></i> Vai trò <span class="text-danger">*</span>
                            </label>
                            <select id="regRole" class="form-select">
                                <option value="Parents" selected>Phụ huynh (Parents)</option>
                                <option value="Kid">Trẻ em (Kid)</option>
                                <option value="Admin">Quản trị viên (Admin)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-lock i8-xs text-primary"></i> Mật khẩu (Tối thiểu 6 ký tự) <span class="text-danger">*</span>
                            </label>
                            <input type="password" id="regPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalLogin">
                            Đã có tài khoản?
                        </button>
                        <button type="submit" class="btn btn-primary rounded-2 px-4" id="btnSubmitRegister">
                            <i class="pixelart-icons-font-check i8-xs me-1"></i> Tạo tài khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= MODAL QUÊN MẬT KHẨU (8-BIT RETRO) ================= -->
    <div class="modal fade" id="modalForgotPassword" tabindex="-1" aria-labelledby="modalForgotLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalForgotLabel">
                        <i class="pixelart-icons-font-shield i8-md text-primary"></i>
                        <span>Khôi Phục Mật Khẩu</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <!-- BƯỚC 1: GỬI MÃ OTP -->
                <form id="formForgotStep1">
                    <div class="modal-body">
                        <p class="text-muted small mb-3">Nhập địa chỉ Email hoặc Tên tài khoản đã đăng ký. Hệ thống sẽ gửi mã OTP gồm 6 chữ số để xác thực.</p>
                        <div id="forgotStep1Alert"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-mail i8-xs text-primary"></i> Email hoặc Username <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="forgotIdentifier" class="form-control" placeholder="name@example.com hoặc username" required />
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalLogin">
                            Quay lại
                        </button>
                        <button type="submit" class="btn btn-primary rounded-2 px-4" id="btnSubmitForgotStep1">
                            <i class="pixelart-icons-font-mail i8-xs me-1"></i> Gửi mã OTP
                        </button>
                    </div>
                </form>

                <!-- BƯỚC 2: NHẬP OTP & ĐỔI MẬT KHẨU -->
                <form id="formForgotStep2" style="display: none;">
                    <div class="modal-body">
                        <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
                            <i class="pixelart-icons-font-circle-info i8-sm"></i>
                            <span>Mã OTP 6 số đã được gửi qua email. Vui lòng kiểm tra hộp thư đến của bạn.</span>
                        </div>
                        <div id="forgotStep2Alert"></div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                                <i class="pixelart-icons-font-lock i8-xs text-primary"></i> Mã OTP (6 chữ số) <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="forgotOtp" class="form-control text-center fw-bold fs-4 pixel-font" maxlength="6" placeholder="123456" required style="letter-spacing: 0.25em;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Mật khẩu mới (Tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                            <input type="password" id="forgotNewPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" id="forgotConfirmPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-muted" id="btnBackToStep1">
                                ← Quay lại bước 1
                            </button>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-primary" id="btnResendOtp">
                                Gửi lại mã
                            </button>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalLogin">
                            Đăng nhập
                        </button>
                        <button type="submit" class="btn btn-primary rounded-2 px-4" id="btnSubmitForgotStep2">
                            <i class="pixelart-icons-font-check i8-xs me-1"></i> Đổi mật khẩu
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- ================= FULLSCREEN 8-BIT SCREEN TIME LOCK OVERLAY CHO MÁY BÉ ================= -->
    <div id="kidScreenTimeLockOverlay" style="display: none; position: fixed; inset: 0; z-index: 999999; background: radial-gradient(circle at center, #2e1065 0%, #09090b 100%); color: #fff; overflow-y: auto;">
        <div class="d-flex flex-column align-items-center justify-content-center min-vh-100 p-4 text-center">
            <div class="apple-card p-4 p-md-5 border-2 shadow-lg" style="max-width: 580px; width: 100%; border-color: var(--pixel-ruby); background: rgba(24, 24, 27, 0.95); backdrop-filter: blur(12px);">
                <!-- Icon khóa 8-bit đập nhịp -->
                <div class="mb-3">
                    <i class="pixelart-icons-font-lock i8-xl text-danger i8-bounce" style="font-size: 64px;"></i>
                </div>

                <!-- Tiêu đề lớn Pixel font -->
                <h2 class="pixel-font text-danger fw-bold mb-2" style="font-size: 26px; letter-spacing: 1px;">
                    MÁY BÉ ĐÃ BỊ KHÓA
                </h2>
                <div class="badge bg-danger-subtle text-danger px-3 py-1 mb-3 pixel-font" style="font-size: 11px;">
                    <i class="pixelart-icons-font-shield i8-xs me-1"></i> KIDCARE SCREEN LOCK ACTIVE
                </div>

                <!-- Lý do khóa máy -->
                <div class="p-3 rounded-3 border border-danger-subtle bg-danger bg-opacity-10 text-danger-emphasis mb-3">
                    <div class="fw-bold small mb-1" id="kidLockReasonTitle">LÝ DO KHÓA MÁY:</div>
                    <div class="fs-6" id="kidLockReasonText">Phụ huynh đã tạm khóa máy từ xa hoặc đã hết giờ sử dụng hôm nay.</div>
                </div>

                <!-- Lời nhắn từ phụ huynh -->
                <div class="p-3 rounded-3 border border-secondary-subtle bg-dark bg-opacity-50 text-light small mb-3 text-start" id="boxKidLockParentMsg" style="display: none;">
                    <div class="text-warning fw-bold mb-1 d-flex align-items-center gap-1">
                        <i class="pixelart-icons-font-mail i8-xs"></i> Lời nhắn từ Ba Mẹ:
                    </div>
                    <div class="fst-italic" id="kidLockParentMessage"></div>
                </div>

                <!-- Thống kê giờ dùng -->
                <div class="row g-2 mb-3 small">
                    <div class="col-6">
                        <div class="p-2 rounded-2 bg-body-tertiary border text-center">
                            <span class="text-muted d-block" style="font-size: 11px;">Đã dùng hôm nay</span>
                            <strong class="text-primary pixel-font" id="kidLockUsedTime">-- phút</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-2 bg-body-tertiary border text-center">
                            <span class="text-muted d-block" style="font-size: 11px;">Giờ hiện tại</span>
                            <strong class="text-warning pixel-font" id="kidLockCurrentTime">--:--</strong>
                        </div>
                    </div>
                </div>

                <!-- Lời khuyên 8-bit thân thiện -->
                <p class="text-muted small mb-4">
                    🌟 Bé hãy tạm rời xa màn hình, ra ngoài vận động hoặc đọc sách cùng gia đình nhé! Khi ba mẹ mở khóa, màn hình sẽ tự động mở lại cho bé.
                </p>

                <!-- Nút hành động -->
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-light btn-sm px-3 pixel-font" onclick="checkKidScreenTimeLock(true)">
                        <i class="pixelart-icons-font-reload i8-xs me-1"></i> Kiểm Tra Lại
                    </button>
                    <button type="button" class="btn btn-danger btn-sm px-3 pixel-font" onclick="logoutFromLockScreen()">
                        <i class="pixelart-icons-font-user i8-xs me-1"></i> Đăng Xuất
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Screen Time Pill cho bé khi đang duyệt web -->
    <div id="kidScreenTimeFloatingPill" class="shadow-lg pixel-font" style="display: none; position: fixed; bottom: 20px; right: 20px; z-index: 1040; background: rgba(15, 23, 42, 0.9); border: 2px solid var(--pixel-gold); border-radius: 8px; padding: 8px 14px; color: #fff; font-size: 12px; backdrop-filter: blur(8px);">
        <div class="d-flex align-items-center gap-2">
            <i class="pixelart-icons-font-clock i8-xs text-warning"></i>
            <span>Giờ máy còn:</span>
            <strong id="floatingRemainingMins" class="text-warning">-- phút</strong>
        </div>
    </div>

    <!-- Floating Walkie-Talkie Button cho cả Phụ huynh và Bé -->
    <a href="/intercom" id="floatingWalkieTalkieBtn" class="shadow-lg pixel-font text-decoration-none" style="display: none; position: fixed; bottom: 20px; left: 20px; z-index: 1040; background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); border: 2px solid var(--pixel-ruby); border-radius: 8px; padding: 8px 14px; color: #fff; font-size: 12px; backdrop-filter: blur(8px);">
        <div class="d-flex align-items-center gap-2">
            <i class="pixelart-icons-font-radio i8-xs text-danger i8-pulse"></i>
            <span>Bộ Đàm:</span>
            <span id="floatingWalkieBadge" class="badge bg-danger rounded-pill">0</span>
        </div>
    </a>

    <footer class="footer mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center py-2">
            <div class="d-flex align-items-center gap-2">
                <i class="pixelart-icons-font-gamepad i8-sm text-primary"></i>
                <span>&copy; @DateTime.UtcNow.Year <strong class="pixel-font">KidCare</strong> · Nền tảng Quản lý Trẻ & Gia đình 8-Bit.</span>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <a href="/kids" class="text-decoration-none text-muted">
                    <i class="pixelart-icons-font-users i8-xs me-1"></i> Quản lý Trẻ
                </a>
                <span class="text-muted">·</span>
                <a href="/parental-control" class="text-decoration-none text-muted">
                    <i class="pixelart-icons-font-shield i8-xs me-1 text-danger"></i> Chặn Web & App
                </a>
                <span class="text-muted">·</span>
                <a href="/screentime" class="text-decoration-none text-muted">
                    <i class="pixelart-icons-font-clock i8-xs me-1 text-primary"></i> Đặt Giờ Máy
                </a>
                <span class="text-muted">·</span>
                <a href="/intercom" class="text-decoration-none text-muted">
                    <i class="pixelart-icons-font-radio i8-xs me-1 text-danger"></i> Bộ Đàm Gia Đình
                </a>
                <span class="text-muted">·</span>
                <a href="/activities" class="text-decoration-none text-muted">
                    <i class="pixelart-icons-font-calendar i8-xs me-1 text-warning"></i> Lịch & Hoạt động
                </a>
                <span class="text-muted">·</span>
                <a href="/swagger" class="text-decoration-none text-muted" target="_blank">
                    <i class="pixelart-icons-font-zap i8-xs me-1 text-warning"></i> API
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Quản lý trạng thái Đăng nhập / Đăng ký người dùng
        window.fillLogin = function(username, password) {
            document.getElementById('loginIdentifier').value = username;
            document.getElementById('loginPassword').value = password;
        };

        // ===== BẢO VỆ & KHÓA MÀN HÌNH MÁY BÉ REALTIME (KID SCREEN TIME GUARDIAN) =====
        let kidHeartbeatTimer = null;

        function startKidScreenTimeGuardian() {
            checkKidScreenTimeLock();
            if (kidHeartbeatTimer) clearInterval(kidHeartbeatTimer);
            kidHeartbeatTimer = setInterval(sendKidHeartbeat, 30000); // Gửi tín hiệu mỗi 30s
        }

        function stopKidScreenTimeGuardian() {
            if (kidHeartbeatTimer) {
                clearInterval(kidHeartbeatTimer);
                kidHeartbeatTimer = null;
            }
            const overlay = document.getElementById('kidScreenTimeLockOverlay');
            if (overlay) overlay.style.display = 'none';
            document.body.style.overflow = '';
            const pill = document.getElementById('kidScreenTimeFloatingPill');
            if (pill) pill.style.display = 'none';
        }

        window.checkKidScreenTimeLock = async function(isManual = false) {
            const token = localStorage.getItem('authToken');
            if (!token) return;

            try {
                const res = await fetch('/api/screentime/my-status', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!res.ok) return;

                const data = await res.json();
                applyKidLockState(data.status, data.settings);
                if (isManual && !data.status?.isLocked) {
                    alert('Máy của bạn hiện không bị khóa!');
                }
            } catch (e) {
                console.warn('ScreenTime check error:', e);
            }
        };

        async function sendKidHeartbeat() {
            const token = localStorage.getItem('authToken');
            if (!token) return;

            try {
                const res = await fetch('/api/screentime/my-heartbeat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        deviceName: navigator.userAgent.includes('Mobile') ? 'Điện thoại bé (Web)' : 'Máy tính bé (Web)',
                        incrementMinutes: 1
                    })
                });
                if (!res.ok) return;

                const data = await res.json();
                applyKidLockState({
                    isLocked: data.isLocked,
                    lockReason: data.reason,
                    lockMessage: data.lockMessage,
                    usedMinutesToday: data.usedMinutesToday,
                    effectiveLimitToday: data.effectiveLimitToday,
                    remainingMinutesToday: data.remainingMinutes,
                    currentTimeVn: data.serverTime
                }, null);
            } catch (e) {
                console.warn('Heartbeat error:', e);
            }
        }

        function applyKidLockState(status, settings) {
            if (!status) return;

            const overlay = document.getElementById('kidScreenTimeLockOverlay');
            const pill = document.getElementById('kidScreenTimeFloatingPill');
            if (!overlay || !pill) return;

            if (status.isLocked) {
                // Khóa máy: Hiển thị Fullscreen Lock Overlay, chặn cuộn trang
                overlay.style.display = 'block';
                document.body.style.overflow = 'hidden';
                pill.style.display = 'none';

                const reasonEl = document.getElementById('kidLockReasonText');
                if (reasonEl) reasonEl.textContent = status.lockReason || 'Đã hết giờ sử dụng hoặc đang trong giờ giới nghiêm.';

                const msgBox = document.getElementById('boxKidLockParentMsg');
                const msgEl = document.getElementById('kidLockParentMessage');
                const parentMsg = status.lockMessage || (settings && settings.lockMessage);
                if (parentMsg && parentMsg.trim()) {
                    if (msgBox) msgBox.style.display = 'block';
                    if (msgEl) msgEl.textContent = `"${parentMsg.trim()}"`;
                } else if (msgBox) {
                    msgBox.style.display = 'none';
                }

                const usedEl = document.getElementById('kidLockUsedTime');
                if (usedEl) usedEl.textContent = (status.usedMinutesToday ?? '--') + ' phút';

                const timeEl = document.getElementById('kidLockCurrentTime');
                if (timeEl) timeEl.textContent = status.currentTimeVn || new Date().toLocaleTimeString('vi-VN');

            } else {
                // Mở máy: Ẩn Lock Overlay, hiển thị Floating Pill
                overlay.style.display = 'none';
                document.body.style.overflow = '';

                const remaining = status.remainingMinutesToday ?? status.remainingMinutes ?? 0;
                pill.style.display = 'block';
                const pillMins = document.getElementById('floatingRemainingMins');
                if (pillMins) pillMins.textContent = remaining + ' phút';

                // Màu sắc cảnh báo thời gian
                if (remaining <= 10) {
                    pill.style.borderColor = 'var(--pixel-ruby)';
                    if (pillMins) pillMins.className = 'text-danger fw-bold i8-pulse';
                } else if (remaining <= 30) {
                    pill.style.borderColor = 'var(--pixel-gold)';
                    if (pillMins) pillMins.className = 'text-warning fw-bold';
                } else {
                    pill.style.borderColor = 'var(--pixel-green)';
                    if (pillMins) pillMins.className = 'text-success fw-bold';
                }
            }
        }

        window.logoutFromLockScreen = function() {
            localStorage.removeItem('authToken');
            localStorage.removeItem('authUser');
            stopKidScreenTimeGuardian();
            window.location.href = '/';
        };

        // ===== BỘ ĐÀM THOẠI & THÔNG BÁO TIN NHẮN GIỌNG NÓI =====
        let unreadVoiceTimer = null;
        let lastUnreadVoiceCount = 0;

        async function checkUnreadVoiceCount() {
            const token = localStorage.getItem('authToken');
            if (!token) return;

            try {
                const res = await fetch('/api/voicemessages/unread-count', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!res.ok) return;

                const data = await res.json();
                const count = data.unreadCount || 0;

                const navBadge = document.getElementById('navVoiceBadge');
                const floatBadge = document.getElementById('floatingWalkieBadge');
                const floatBtn = document.getElementById('floatingWalkieTalkieBtn');

                if (floatBtn) floatBtn.style.display = 'block';

                if (count > 0) {
                    if (navBadge) {
                        navBadge.textContent = count;
                        navBadge.classList.remove('d-none');
                    }
                    if (floatBadge) {
                        floatBadge.textContent = count;
                        floatBadge.classList.remove('d-none');
                    }
                    // Phát chuông khi có tin mới xuất hiện
                    if (count > lastUnreadVoiceCount && lastUnreadVoiceCount >= 0) {
                        try {
                            const ctx = new (window.AudioContext || window.webkitAudioContext)();
                            const osc = ctx.createOscillator();
                            const gain = ctx.createGain();
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.type = 'sine';
                            osc.frequency.setValueAtTime(659.25, ctx.currentTime);
                            osc.frequency.setValueAtTime(1046.5, ctx.currentTime + 0.1);
                            gain.gain.setValueAtTime(0.15, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
                            osc.start(ctx.currentTime);
                            osc.stop(ctx.currentTime + 0.25);
                        } catch (_) {}
                    }
                } else {
                    if (navBadge) navBadge.classList.add('d-none');
                    if (floatBadge) floatBadge.textContent = '0';
                }
                lastUnreadVoiceCount = count;
            } catch (_) {}
        }

        const updateAuthUI = () => {
            const userStr = localStorage.getItem('authUser');
            const guestBox = document.getElementById('authNavGuest');
            const userBox = document.getElementById('authNavUser');
            
            if (userStr) {
                try {
                    const u = JSON.parse(userStr);
                    const roles = u.roles || [];
                    const isKid = roles.includes('Kid') || roles.includes('kid');
                    const roleLabel = roles.includes('Admin') ? 'Admin' : (isKid ? 'Kid' : 'Parents');
                    document.getElementById('navUserName').innerHTML = `${u.fullName || u.username} <span class="badge apple-badge-blue ms-1">${roleLabel}</span>`;
                    document.getElementById('navUserAvatar').src = u.avatarUrl || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(u.username)}`;
                    guestBox.classList.add('d-none');
                    userBox.classList.remove('d-none');
                    userBox.classList.add('d-flex');

                    // Kích hoạt người bảo vệ Screen Time nếu là tài khoản bé
                    if (isKid) {
                        startKidScreenTimeGuardian();
                    } else {
                        stopKidScreenTimeGuardian();
                    }

                    // Kích hoạt theo dõi thông báo bộ đàm
                    checkUnreadVoiceCount();
                    if (unreadVoiceTimer) clearInterval(unreadVoiceTimer);
                    unreadVoiceTimer = setInterval(checkUnreadVoiceCount, 10000);
                    return;
                } catch (e) {
                    localStorage.removeItem('authUser');
                }
            }
            guestBox.classList.remove('d-none');
            userBox.classList.add('d-none');
            userBox.classList.remove('d-flex');
            stopKidScreenTimeGuardian();

            if (unreadVoiceTimer) {
                clearInterval(unreadVoiceTimer);
                unreadVoiceTimer = null;
            }
            const navBadge = document.getElementById('navVoiceBadge');
            if (navBadge) navBadge.classList.add('d-none');
            const floatBtn = document.getElementById('floatingWalkieTalkieBtn');
            if (floatBtn) floatBtn.style.display = 'none';
        };

        document.getElementById('btnNavLogout')?.addEventListener('click', () => {
            localStorage.removeItem('authToken');
            localStorage.removeItem('authUser');
            stopKidScreenTimeGuardian();
            if (unreadVoiceTimer) {
                clearInterval(unreadVoiceTimer);
                unreadVoiceTimer = null;
            }
            updateAuthUI();
            if (window.location.pathname.toLowerCase().includes('kids') || window.location.pathname.toLowerCase().includes('screentime') || window.location.pathname.toLowerCase().includes('intercom')) {
                window.location.reload();
            } else {
                alert('Đã đăng xuất thành công.');
            }
        });

        // Xử lý submit Đăng ký
        document.getElementById('formRegister')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('registerAlertBox');
            const btn = document.getElementById('btnSubmitRegister');
            btn.disabled = true;
            btn.innerHTML = 'Đang xử lý...';

            const payload = {
                username: document.getElementById('regUsername').value.trim(),
                email: document.getElementById('regEmail').value.trim(),
                fullName: document.getElementById('regFullName').value.trim(),
                role: document.getElementById('regRole') ? document.getElementById('regRole').value : 'Parents',
                password: document.getElementById('regPassword').value
            };

            try {
                const res = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (!res.ok) {
                    const errMsg = data.message || (data.errors ? data.errors.join('<br>') : 'Đăng ký không thành công');
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${errMsg}</div>`;
                    return;
                }

                alertBox.innerHTML = `<div class="alert alert-success py-2 small">Đăng ký thành công! Hãy đăng nhập ngay.</div>`;
                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalRegister')).hide();
                    document.getElementById('formRegister').reset();
                    alertBox.innerHTML = '';
                    const loginModal = new bootstrap.Modal(document.getElementById('modalLogin'));
                    document.getElementById('loginIdentifier').value = payload.username;
                    loginModal.show();
                }, 1200);
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Tạo tài khoản';
            }
        });

        // Xử lý submit Đăng nhập
        document.getElementById('formLogin')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('loginAlertBox');
            const btn = document.getElementById('btnSubmitLogin');
            btn.disabled = true;
            btn.innerHTML = 'Đang đăng nhập...';

            const payload = {
                usernameOrEmail: document.getElementById('loginIdentifier').value.trim(),
                password: document.getElementById('loginPassword').value
            };

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (!res.ok) {
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${data.message || 'Đăng nhập không thành công'}</div>`;
                    return;
                }

                localStorage.setItem('authToken', data.token);
                localStorage.setItem('authUser', JSON.stringify(data.user));
                
                alertBox.innerHTML = `<div class="alert alert-success py-2 small">${data.message}</div>`;
                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalLogin')).hide();
                    document.getElementById('formLogin').reset();
                    alertBox.innerHTML = '';
                    updateAuthUI();
                    if (window.location.pathname.toLowerCase().includes('kids')) {
                        window.location.reload();
                    }
                }, 800);
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Đăng nhập';
            }
        });

        // ================= QUÊN MẬT KHẨU / XÁC THỰC OTP =================
        let currentForgotIdentifier = '';

        document.getElementById('formForgotStep1')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const input = document.getElementById('forgotIdentifier');
            const alertBox = document.getElementById('forgotStep1Alert');
            const btn = document.getElementById('btnSubmitForgotStep1');

            currentForgotIdentifier = input.value.trim();
            if (!currentForgotIdentifier) return;

            btn.disabled = true;
            btn.innerHTML = 'Đang gửi OTP...';
            alertBox.innerHTML = '';

            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: currentForgotIdentifier })
                });

                const data = await res.json();
                if (!res.ok) {
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${data.message || 'Lỗi gửi yêu cầu'}</div>`;
                    return;
                }

                document.getElementById('formForgotStep1').style.display = 'none';
                document.getElementById('formForgotStep2').style.display = 'block';
                document.getElementById('forgotOtp').value = '';
                document.getElementById('forgotNewPassword').value = '';
                document.getElementById('forgotConfirmPassword').value = '';
                document.getElementById('forgotStep2Alert').innerHTML = `<div class="alert alert-success py-2 small">${data.message}</div>`;
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Gửi mã OTP';
            }
        });

        document.getElementById('btnBackToStep1')?.addEventListener('click', () => {
            document.getElementById('formForgotStep2').style.display = 'none';
            document.getElementById('formForgotStep1').style.display = 'block';
            document.getElementById('forgotStep1Alert').innerHTML = '';
        });

        document.getElementById('btnResendOtp')?.addEventListener('click', async () => {
            const btn = document.getElementById('btnResendOtp');
            const alertBox = document.getElementById('forgotStep2Alert');
            if (!currentForgotIdentifier) return;

            btn.disabled = true;
            btn.textContent = 'Đang gửi lại...';

            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: currentForgotIdentifier })
                });
                const data = await res.json();
                alertBox.innerHTML = `<div class="alert alert-success py-2 small">${data.message || 'Đã gửi lại mã OTP'}</div>`;
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi: ${err.message}</div>`;
            } finally {
                setTimeout(() => {
                    btn.disabled = false;
                    btn.textContent = 'Gửi lại mã';
                }, 4000);
            }
        });

        document.getElementById('formForgotStep2')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('forgotStep2Alert');
            const btn = document.getElementById('btnSubmitForgotStep2');

            const otp = document.getElementById('forgotOtp').value.trim();
            const newPassword = document.getElementById('forgotNewPassword').value;
            const confirmPassword = document.getElementById('forgotConfirmPassword').value;

            if (newPassword !== confirmPassword) {
                alertBox.innerHTML = '<div class="alert alert-danger py-2 small">Mật khẩu xác nhận không khớp!</div>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = 'Đang xác thực...';
            alertBox.innerHTML = '';

            try {
                const res = await fetch('/api/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: currentForgotIdentifier,
                        otp: otp,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await res.json();
                if (!res.ok) {
                    const errorMsg = data.errors ? data.errors.join('<br>') : (data.message || 'Đổi mật khẩu không thành công');
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${errorMsg}</div>`;
                    return;
                }

                alertBox.innerHTML = `<div class="alert alert-success py-2 small">${data.message}</div>`;

                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalForgotPassword')).hide();
                    document.getElementById('formForgotStep2').style.display = 'none';
                    document.getElementById('formForgotStep1').style.display = 'block';
                    document.getElementById('formForgotStep1').reset();

                    const loginModal = new bootstrap.Modal(document.getElementById('modalLogin'));
                    document.getElementById('loginIdentifier').value = currentForgotIdentifier;
                    document.getElementById('loginPassword').value = '';
                    loginModal.show();
                }, 1200);
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Đổi mật khẩu';
            }
        });

        document.addEventListener('DOMContentLoaded', updateAuthUI);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
