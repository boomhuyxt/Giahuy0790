<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Giahuy0790 App</title>
    
    <!-- Script chạy sớm nhất để áp dụng Dark/Light Mode trước khi render tránh chớp màn hình -->
    <script>
        (function() {
            const storedTheme = localStorage.getItem('theme');
            const preferredTheme = storedTheme ? storedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', preferredTheme);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Giahuy0790.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary text-white p-2 rounded-3">KC</span>
                    <span class="text-primary">KidCare</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/kids">
                                🧒 Quản lý Trẻ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/activities">
                                📋 Lịch & Hoạt động
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" href="/swagger" target="_blank">
                                Swagger API <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">v1</span>
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Khu vực Trạng thái Xác thực Người dùng (Identity) -->
                        <div id="authNavGuest" class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalLogin">
                                Đăng nhập
                            </button>
                            <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRegister">
                                Đăng ký
                            </button>
                        </div>

                        <div id="authNavUser" class="d-none align-items-center gap-2">
                            <img id="navUserAvatar" src="" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" alt="Avatar" />
                            <span id="navUserName" class="fw-semibold small"></span>
                            <button class="btn btn-outline-danger btn-sm rounded-pill px-2 py-0 ms-1" id="btnNavLogout" title="Đăng xuất">
                                Thoát
                            </button>
                        </div>

                        <div class="vr mx-1"></div>

                        <!-- Nút đổi theme nhanh (Quick Toggle) -->
                        <button class="theme-switch-btn" id="quickThemeToggle" type="button" title="Đổi nhanh Chế độ Sáng / Tối">
                            <span class="theme-icon-active fs-5">🌙</span>
                        </button>

                        <!-- Menu chi tiết chọn Theme (Light / Dark / Auto) -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 py-1" id="themeSwitcher" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Giao diện
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="themeSwitcher">
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center justify-content-between" data-bs-theme-value="light" data-icon="☀️">
                                        <span>☀️ Sáng (Light)</span>
                                        <span class="theme-check d-none text-primary ms-2">✓</span>
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center justify-content-between" data-bs-theme-value="dark" data-icon="🌙">
                                        <span>🌙 Tối (Dark)</span>
                                        <span class="theme-check d-none text-primary ms-2">✓</span>
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center justify-content-between" data-bs-theme-value="auto" data-icon="💻">
                                        <span>💻 Theo hệ thống (Auto)</span>
                                        <span class="theme-check d-none text-primary ms-2">✓</span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ================= MODAL ĐĂNG NHẬP ================= -->
    <div class="modal fade" id="modalLogin" tabindex="-1" aria-labelledby="modalLoginLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="modalLoginLabel">🔐 Đăng nhập tài khoản</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formLogin">
                    <div class="modal-body">
                        <div id="loginAlertBox"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Tên đăng nhập hoặc Email</label>
                            <input type="text" id="loginIdentifier" class="form-control" placeholder="username hoặc email@domain.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Mật khẩu</label>
                            <input type="password" id="loginPassword" class="form-control" placeholder="••••••••" required />
                        </div>
                        <div class="d-flex justify-content-end mb-3">
                            <a href="#" class="small text-decoration-none text-primary fw-semibold" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalForgotPassword">
                                🔑 Quên mật khẩu?
                            </a>
                        </div>

                        <!-- Quick Test Accounts for 3 Roles -->
                        <div class="p-2 bg-body-tertiary rounded-3 border small">
                            <div class="fw-bold text-muted mb-1" style="font-size: 11px;">ĐĂNG NHẬP NHANH (QUICK DEMO):</div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-purple flex-grow-1 py-1" style="font-size: 11px;" onclick="fillLogin('admin', 'Admin@123')">
                                    👑 Admin
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success flex-grow-1 py-1" style="font-size: 11px;" onclick="fillLogin('parents', 'Parents@123')">
                                    👨‍👩‍👧 Parents
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark flex-grow-1 py-1" style="font-size: 11px;" onclick="fillLogin('kid', 'Kid@123')">
                                    🧒 Kid
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalRegister">
                            Chưa có tài khoản? Đăng ký
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSubmitLogin">
                            Đăng nhập
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= MODAL ĐĂNG KÝ ================= -->
    <div class="modal fade" id="modalRegister" tabindex="-1" aria-labelledby="modalRegisterLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="modalRegisterLabel">📝 Đăng ký thành viên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formRegister">
                    <div class="modal-body">
                        <div id="registerAlertBox"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                            <input type="text" id="regUsername" class="form-control" placeholder="Ví dụ: giahuy123" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Địa chỉ Email <span class="text-danger">*</span></label>
                            <input type="email" id="regEmail" class="form-control" placeholder="name@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Họ và tên</label>
                            <input type="text" id="regFullName" class="form-control" placeholder="Ví dụ: Nguyễn Gia Huy" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Vai trò (Role) <span class="text-danger">*</span></label>
                            <select id="regRole" class="form-select">
                                <option value="Parents" selected>👨‍👩‍👧 Phụ huynh (Parents) - Quản lý con em</option>
                                <option value="Kid">🧒 Trẻ em (Kid) - Tự làm nhiệm vụ & nhận sao</option>
                                <option value="Admin">👑 Quản trị viên (Admin) - Toàn quyền hệ thống</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Mật khẩu (Tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                            <input type="password" id="regPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalLogin">
                            Đã có tài khoản? Đăng nhập
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSubmitRegister">
                            Tạo tài khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= MODAL QUÊN MẬT KHẨU (GỬI MÃ OTP QUA EMAIL) ================= -->
    <div class="modal fade" id="modalForgotPassword" tabindex="-1" aria-labelledby="modalForgotLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="modalForgotLabel">🔑 Khôi phục mật khẩu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <!-- BƯỚC 1: GỬI MÃ OTP QUA EMAIL -->
                <form id="formForgotStep1">
                    <div class="modal-body">
                        <p class="text-muted small mb-3">Nhập địa chỉ Email hoặc Tên tài khoản đã đăng ký. Hệ thống sẽ gửi mã OTP gồm 6 chữ số về email của bạn để xác thực.</p>
                        <div id="forgotStep1Alert"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Email hoặc Username <span class="text-danger">*</span></label>
                            <input type="text" id="forgotIdentifier" class="form-control" placeholder="vidu@gmail.com hoặc username" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalLogin">
                            Quay lại Đăng nhập
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSubmitForgotStep1">
                            Gửi mã OTP
                        </button>
                    </div>
                </form>

                <!-- BƯỚC 2: NHẬP MÃ OTP VÀ THAY ĐỔI MẬT KHẨU MỚI -->
                <form id="formForgotStep2" style="display: none;">
                    <div class="modal-body">
                        <div class="alert alert-info py-2 small mb-3">
                            ✉️ Mã xác thực OTP 6 số đã được gửi qua email. Vui lòng kiểm tra hộp thư đến (hoặc thư mục Spam/Rác).
                        </div>
                        <div id="forgotStep2Alert"></div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-primary">Mã OTP (6 chữ số) <span class="text-danger">*</span></label>
                            <input type="text" id="forgotOtp" class="form-control text-center fw-bold fs-4 tracking-widest" maxlength="6" placeholder="123456" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Mật khẩu mới (Tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                            <input type="password" id="forgotNewPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" id="forgotConfirmPassword" class="form-control" placeholder="••••••••" minlength="6" required />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0" id="btnBackToStep1">
                                ← Đổi email khác
                            </button>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-primary" id="btnResendOtp">
                                Gửi lại mã OTP
                            </button>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm me-auto" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#modalLogin">
                            Đăng nhập
                        </button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm" id="btnSubmitForgotStep2">
                            Đổi mật khẩu
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <footer class="footer border-top bg-body-tertiary text-body-secondary">
        <div class="container d-flex flex-wrap justify-content-between align-items-center py-2">
            <div>
                &copy; @DateTime.UtcNow.Year - <strong>KidCare</strong> - Hệ thống Quản lý & Đồng hành cùng Trẻ em
            </div>
            <div class="d-flex gap-3">
                <a href="/kids" class="text-decoration-none text-body-secondary">Quản lý Trẻ</a>
                <span>•</span>
                <a href="/activities" class="text-decoration-none text-body-secondary">Lịch & Hoạt động</a>
                <span>•</span>
                <a href="/swagger" class="text-decoration-none text-body-secondary" target="_blank">Swagger API</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Quản lý trạng thái Đăng nhập / Đăng ký người dùng
        window.fillLogin = function(username, password) {
            document.getElementById('loginIdentifier').value = username;
            document.getElementById('loginPassword').value = password;
        };

        const updateAuthUI = () => {
            const userStr = localStorage.getItem('authUser');
            const guestBox = document.getElementById('authNavGuest');
            const userBox = document.getElementById('authNavUser');
            
            if (userStr) {
                try {
                    const u = JSON.parse(userStr);
                    const roles = u.roles || [];
                    const roleLabel = roles.includes('Admin') ? '👑 Admin' : (roles.includes('Kid') ? '🧒 Kid' : '👨‍👩‍👧 Parents');
                    document.getElementById('navUserName').innerHTML = `${u.fullName || u.username} <span class="badge bg-primary-subtle text-primary border small ms-1">${roleLabel}</span>`;
                    document.getElementById('navUserAvatar').src = u.avatarUrl || `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(u.username)}`;
                    guestBox.classList.add('d-none');
                    userBox.classList.remove('d-none');
                    userBox.classList.add('d-flex');
                    return;
                } catch (e) {
                    localStorage.removeItem('authUser');
                }
            }
            guestBox.classList.remove('d-none');
            userBox.classList.add('d-none');
            userBox.classList.remove('d-flex');
        };

        document.getElementById('btnNavLogout')?.addEventListener('click', () => {
            localStorage.removeItem('authToken');
            localStorage.removeItem('authUser');
            updateAuthUI();
            alert('Đã đăng xuất thành công!');
        });

        // Xử lý submit Đăng ký
        document.getElementById('formRegister')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('registerAlertBox');
            const btn = document.getElementById('btnSubmitRegister');
            btn.disabled = true;
            btn.innerHTML = 'Đang xử lý...';

            const payload = {
                username: document.getElementById('regUsername').value.trim(),
                email: document.getElementById('regEmail').value.trim(),
                fullName: document.getElementById('regFullName').value.trim(),
                role: document.getElementById('regRole') ? document.getElementById('regRole').value : 'Parents',
                password: document.getElementById('regPassword').value
            };

            try {
                const res = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (!res.ok) {
                    const errMsg = data.message || (data.errors ? data.errors.join('<br>') : 'Đăng ký thất bại');
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${errMsg}</div>`;
                    return;
                }

                alertBox.innerHTML = `<div class="alert alert-success py-2 small">🎉 Đăng ký thành công! Hãy đăng nhập ngay.</div>`;
                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalRegister')).hide();
                    document.getElementById('formRegister').reset();
                    alertBox.innerHTML = '';
                    const loginModal = new bootstrap.Modal(document.getElementById('modalLogin'));
                    document.getElementById('loginIdentifier').value = payload.username;
                    loginModal.show();
                }, 1500);
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Tạo tài khoản';
            }
        });

        // Xử lý submit Đăng nhập
        document.getElementById('formLogin')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('loginAlertBox');
            const btn = document.getElementById('btnSubmitLogin');
            btn.disabled = true;
            btn.innerHTML = 'Đang đăng nhập...';

            const payload = {
                usernameOrEmail: document.getElementById('loginIdentifier').value.trim(),
                password: document.getElementById('loginPassword').value
            };

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (!res.ok) {
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${data.message || 'Đăng nhập thất bại'}</div>`;
                    return;
                }

                // Lưu JWT Token và User info vào localStorage
                localStorage.setItem('authToken', data.token);
                localStorage.setItem('authUser', JSON.stringify(data.user));
                
                alertBox.innerHTML = `<div class="alert alert-success py-2 small">✅ ${data.message}</div>`;
                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalLogin')).hide();
                    document.getElementById('formLogin').reset();
                    alertBox.innerHTML = '';
                    updateAuthUI();
                }, 1000);
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Đăng nhập';
            }
        });

        // ================= QUÊN MẬT KHẨU / XÁC THỰC OTP =================
        let currentForgotIdentifier = '';

        // Bước 1: Gửi mã OTP về email người dùng
        document.getElementById('formForgotStep1')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const input = document.getElementById('forgotIdentifier');
            const alertBox = document.getElementById('forgotStep1Alert');
            const btn = document.getElementById('btnSubmitForgotStep1');

            currentForgotIdentifier = input.value.trim();
            if (!currentForgotIdentifier) return;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi OTP...';
            alertBox.innerHTML = '';

            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: currentForgotIdentifier })
                });

                const data = await res.json();
                if (!res.ok) {
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${data.message || 'Lỗi gửi yêu cầu'}</div>`;
                    return;
                }

                // Chuyển sang Bước 2: Nhập OTP & Đổi mật khẩu
                document.getElementById('formForgotStep1').style.display = 'none';
                document.getElementById('formForgotStep2').style.display = 'block';
                document.getElementById('forgotOtp').value = '';
                document.getElementById('forgotNewPassword').value = '';
                document.getElementById('forgotConfirmPassword').value = '';
                document.getElementById('forgotStep2Alert').innerHTML = `<div class="alert alert-success py-2 small">✅ ${data.message}</div>`;
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Gửi mã OTP';
            }
        });

        // Nút quay lại Bước 1
        document.getElementById('btnBackToStep1')?.addEventListener('click', () => {
            document.getElementById('formForgotStep2').style.display = 'none';
            document.getElementById('formForgotStep1').style.display = 'block';
            document.getElementById('forgotStep1Alert').innerHTML = '';
        });

        // Gửi lại mã OTP
        document.getElementById('btnResendOtp')?.addEventListener('click', async () => {
            const btn = document.getElementById('btnResendOtp');
            const alertBox = document.getElementById('forgotStep2Alert');
            if (!currentForgotIdentifier) return;

            btn.disabled = true;
            btn.textContent = 'Đang gửi lại...';

            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: currentForgotIdentifier })
                });
                const data = await res.json();
                alertBox.innerHTML = `<div class="alert alert-success py-2 small">🔁 ${data.message || 'Đã gửi lại mã OTP!'}</div>`;
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi: ${err.message}</div>`;
            } finally {
                setTimeout(() => {
                    btn.disabled = false;
                    btn.textContent = 'Gửi lại mã OTP';
                }, 5000);
            }
        });

        // Bước 2: Xác nhận đổi mật khẩu mới với mã OTP
        document.getElementById('formForgotStep2')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById('forgotStep2Alert');
            const btn = document.getElementById('btnSubmitForgotStep2');

            const otp = document.getElementById('forgotOtp').value.trim();
            const newPassword = document.getElementById('forgotNewPassword').value;
            const confirmPassword = document.getElementById('forgotConfirmPassword').value;

            if (newPassword !== confirmPassword) {
                alertBox.innerHTML = '<div class="alert alert-danger py-2 small">Mật khẩu xác nhận không khớp!</div>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xác thực...';
            alertBox.innerHTML = '';

            try {
                const res = await fetch('/api/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: currentForgotIdentifier,
                        otp: otp,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await res.json();
                if (!res.ok) {
                    const errorMsg = data.errors ? data.errors.join('<br>') : (data.message || 'Đổi mật khẩu thất bại');
                    alertBox.innerHTML = `<div class="alert alert-danger py-2 small">${errorMsg}</div>`;
                    return;
                }

                alertBox.innerHTML = `<div class="alert alert-success py-2 small">🎉 ${data.message}</div>`;

                setTimeout(() => {
                    bootstrap.Modal.getInstance(document.getElementById('modalForgotPassword')).hide();
                    document.getElementById('formForgotStep2').style.display = 'none';
                    document.getElementById('formForgotStep1').style.display = 'block';
                    document.getElementById('formForgotStep1').reset();

                    const loginModal = new bootstrap.Modal(document.getElementById('modalLogin'));
                    document.getElementById('loginIdentifier').value = currentForgotIdentifier;
                    document.getElementById('loginPassword').value = '';
                    loginModal.show();
                }, 1500);
            } catch (err) {
                alertBox.innerHTML = `<div class="alert alert-danger py-2 small">Lỗi kết nối: ${err.message}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Đổi mật khẩu';
            }
        });

        document.addEventListener('DOMContentLoaded', updateAuthUI);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
